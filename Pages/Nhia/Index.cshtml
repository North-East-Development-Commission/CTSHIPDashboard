@page
@model CTSHIPDashboard.Pages.Nhia.IndexModel
@using System.Globalization
@using System.Text.Json

<h2>NHIA Dashboard — Key Performance Indicators</h2>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card p-3">
            <h6>Total Enrollees</h6>
            <h3>@Model.Kpis.TotalEnrollees</h3>
            <small>Active: @Model.Kpis.ActiveEnrollees</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <h6>Total Claims</h6>
            <h3>@Model.Kpis.TotalClaims</h3>
            <small>Paid: @Model.Kpis.PaidClaims</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <h6>Total Paid (Amount)</h6>
            <h3>@Model.Kpis.TotalPaidAmount.ToString("C", CultureInfo.CurrentCulture)</h3>
            <small>Pending: @Model.Kpis.PendingClaims</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <h6>Providers / HMOs</h6>
            <h3>@Model.Kpis.TotalProviders / @Model.Kpis.TotalHmos</h3>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h5>Enrollees by State (Top) — click a bar to view state dashboard</h5>
        <canvas id="enrolleesByStateChart" height="220"></canvas>
    </div>

    <div class="col-md-6">
        <h5>Claims by State (Top) — click a bar to view state dashboard</h5>
        <canvas id="claimsByStateChart" height="220"></canvas>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-12">
        <h5>Top HMOs by Enrollees</h5>
        <table class="table table-sm">
            <thead><tr><th>HMO</th><th>Enrollees</th></tr></thead>
            <tbody>
            @foreach(var kv in Model.Kpis.TopHmos)
            {
                <tr><td>@kv.Key</td><td>@kv.Value</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Recent enrollees for NHIA with links to details -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <strong>Recent Enrollees</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Enrollment #</th>
                                <th>Name</th>
                                <th>HMO</th>
                                <th>Registered</th>
                                <th>Status</th>
                                <th style="width:120px">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var e in Model.RecentEnrollees)
                            {
                                <tr>
                                    <td>@e.EnrollmentNumber</td>
                                    <td>
                                        <a asp-controller="Enrollees" asp-action="Details" asp-route-id="@e.Id" class="text-success">
                                            @e.FullName
                                        </a>
                                    </td>
                                    <td>@e.HmoName</td>
                                    <td>@e.DateRegistered.ToString("yyyy-MM-dd")</td>
                                    <td>@e.Status</td>
                                    <td>
                                        <a asp-controller="Enrollees" asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-success">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const enrolleeLabels = @Html.Raw(JsonSerializer.Serialize(Model.Kpis.EnrolleesByState.Select(k => k.Key)));
        const enrolleeData = @Html.Raw(JsonSerializer.Serialize(Model.Kpis.EnrolleesByState.Select(k => k.Value)));

        const claimLabels = @Html.Raw(JsonSerializer.Serialize(Model.Kpis.ClaimsByState.Select(k => k.Key)));
        const claimData = @Html.Raw(JsonSerializer.Serialize(Model.Kpis.ClaimsByState.Select(k => k.Value)));

        function randomColor(alpha = 0.8) {
            const r = Math.floor(Math.random()*155)+50;
            const g = Math.floor(Math.random()*155)+50;
            const b = Math.floor(Math.random()*155)+50;
            return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        }

        function renderClickableBarChart(canvasId, labels, data, labelText) {
            const ctx = document.getElementById(canvasId).getContext('2d');
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: labelText,
                        data: data,
                        backgroundColor: labels.map(() => randomColor(0.7)),
                        borderColor: labels.map(() => randomColor(1)),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } },
                    onClick: (evt, activeEls) => {
                        const points = chart.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, true);
                        if (points.length) {
                            const firstPoint = points[0];
                            const label = chart.data.labels[firstPoint.index];
                            const url = `/StateOffice?state=${encodeURIComponent(label)}`;
                            window.location.href = url;
                        }
                    }
                }
            });
            return chart;
        }

        renderClickableBarChart('enrolleesByStateChart', enrolleeLabels, enrolleeData, 'Enrollees');
        renderClickableBarChart('claimsByStateChart', claimLabels, claimData, 'Claims');
    </script>
}
