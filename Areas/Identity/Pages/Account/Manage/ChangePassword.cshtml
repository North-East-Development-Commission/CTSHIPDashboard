@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Card wrapper for clean look -->
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <!-- Green header accent -->
                <div class="bg-success text-white text-center py-4">
                    <h3 class="mb-0 fw-bold">@ViewData["Title"]</h3>
                </div>

                <div class="card-body p-4 p-md-5">
                    <partial name="_StatusMessage" for="StatusMessage" />

                    <form id="change-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger alert alert-danger mb-4" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.OldPassword" class="form-control border-success-subtle focus-ring focus-ring-success"
                                   autocomplete="current-password" aria-required="true"
                                   placeholder="Please enter your old password." />
                            <label asp-for="Input.OldPassword" class="form-label text-success-emphasis"></label>
                            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.NewPassword" class="form-control border-success-subtle focus-ring focus-ring-success"
                                   autocomplete="new-password" aria-required="true"
                                   placeholder="Please enter your new password." />
                            <label asp-for="Input.NewPassword" class="form-label text-success-emphasis"></label>
                            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control border-success-subtle focus-ring focus-ring-success"
                                   autocomplete="new-password" aria-required="true"
                                   placeholder="Please confirm your new password." />
                            <label asp-for="Input.ConfirmPassword" class="form-label text-success-emphasis"></label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-semibold shadow-sm">
                            Update password
                        </button>
                        <button class="btn btn-success btn-lg w-100 fw-semibold shadow-sm">
                            <a asp-page="./Index" class="btn btn-warning btn-lg shadow">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Optional: Enhance green theme a bit more */
        .form-control:focus {
            border-color: #198754 !important; /* Bootstrap 5 success green */
            box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25) !important;
        }

        .bg-success {
            background-color: #198754 !important; /* Bootstrap 5 default success */
        }

        .text-success-emphasis {
            color: #0f5132 !important; /* Darker green for labels */
        }

        .border-success-subtle {
            border-color: #a3cfbb !important; /* Very light green border */
        }

        /* Make invalid feedback stand out but keep red (good UX) */
        .text-danger {
            color: #dc3545 !important;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}