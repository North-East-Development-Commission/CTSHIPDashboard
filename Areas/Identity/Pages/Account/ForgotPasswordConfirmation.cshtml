@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password Reset Sent";
    var resetLink = TempData["PasswordResetLink"] as string ?? string.Empty;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <img src="~/images/nedc-logo-transparent.png" alt="NEDC" style="width: 96px; height: auto;" />
                    <h1 class="h3 fw-bold text-success mt-3">Check your email</h1>
                    <p class="text-muted">If the email address belongs to an account, a password reset link has been prepared.</p>

                    @if (!string.IsNullOrWhiteSpace(resetLink))
                    {
                        <div class="alert alert-warning text-start mt-4">
                            <strong>Development reset link:</strong>
                            <p class="mb-2">SMTP is not configured, so the reset link is available here while running in Development.</p>
                            <a href="@resetLink" class="btn btn-success">Open reset form</a>
                        </div>
                    }

                    <a asp-page="./Login" class="btn btn-outline-success mt-3">Return to login</a>
                </div>
            </div>
        </div>
    </div>
</div>
