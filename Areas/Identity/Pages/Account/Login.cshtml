@page
@model LoginModel

@{
    ViewData["Title"] = "";
}

<style>
    .login-logo-wrap {
        display: flex;
        justify-content: center;
        padding: 1.25rem 1rem 0.75rem;
    }

    .login-logo {
        width: clamp(96px, 34vw, 180px);
        height: auto;
        max-width: 100%;
        object-fit: contain;
    }
    .login-page { max-width: 960px; margin-inline: auto; }
    .login-page .form-control { min-height: 48px; }
    .login-page .form-label { display: block; margin-bottom: .5rem; }
    @@keyframes login-enter {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@media (prefers-reduced-motion: no-preference) {
        .login-page #account { animation: login-enter 300ms ease-out; }
        .login-page #login-submit { transition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
        .login-page #login-submit:active { transform: scale(.99); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .login-page #account, .login-page #login-submit { animation: none; transition: none; transform: none; }
    }
</style>

<h1>@ViewData["Title"]</h1>
<div class="container-fluid login-page">
       <div class="card border-0 shadow-sm">
        <div class="login-logo-wrap">
            <img src="~/images/nedcL.jpg" alt="Company Logo" class="login-logo" />
        </div>        
        <h1 class="text-center" style="color:#3b703b">NORTH EAST DEVELOPMENT COMMISSION (NEDC)</h1>
        <h5 class="text-center" style="color:#FE9031">COMMUNITY TARGETED SOCIAL HEALTH INSURANCE PROGRAM (CTSHIP)</h5>
        <div class="card-header bg-success text-white">
            <h5 class="mb-0 text-center"><i class="bi bi-person-plus-fill"></i> LOGIN</h5>
        </div>
        <div class="card-body">
            <div class="col-12 col-md-8 col-lg-6 mx-auto">
                <form id="account" method="post">
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" inputmode="email" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end mb-3">
                        <a asp-page="./ForgotPassword" class="text-success fw-semibold">Forgot password?</a>
                    </div>
                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label" style="color:#FE9031">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-success">Log in</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
