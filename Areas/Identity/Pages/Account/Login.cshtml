@page
@model LoginModel

@{
    ViewData["Title"] = "";
}

<style>
    .login-logo-wrap {
        display: flex;
        justify-content: center;
        padding: 1.25rem 1rem 0.75rem;
    }

    .login-logo {
        width: clamp(96px, 34vw, 180px);
        height: auto;
        max-width: 100%;
        object-fit: contain;
    }
</style>

<h1>@ViewData["Title"]</h1>
<div class="container-fluid">
       <div class="card border-0 shadow-sm">
        <div class="login-logo-wrap">
            <img src="~/images/nedcL.jpg" alt="Company Logo" class="login-logo" />
        </div>        
        <h1 class="text-center" style="color:#B08C15">NORTH EAST DEVELOPMENT COMMISSION (NEDC)</h1>
        <h5 class="text-center" style="color:#B08C15">COMMUNITY TARGETED SOCIAL HEALTH INSURANCE PROGRAM (CTSHIP)</h5>
        <div class="card-header bg-success text-white">
            <h5 class="mb-0 text-center"><i class="bi bi-person-plus-fill"></i> LOGIN</h5>
        </div>
        <div class="card-body">
            <div class="col-6 offset-3">
                <form id="account" method="post">
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label" style="color:#B08C15">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-success">Log in</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
