@model CTSHIPDashboard.Models.Hmo
@{
    ViewData["Title"] = "Edit HMO - " + Model.Name;
}

<div class="container-fluid py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="bg-warning text-dark text-center py-5">
                    <h1 class="display-5 fw-bold mb-2">EDIT HMO</h1>
                    <p class="lead mb-0">Code: <strong class="text-primary">@Model.RegistrationNumber</strong></p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="RegistrationNumber" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label text-success fw-bold fs-5">HMO Name</label>
                                <input asp-for="Name" class="form-control form-control-lg rounded-3" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label text-success fw-bold fs-5">Email</label>
                                <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label text-success fw-bold fs-5">Phone</label>
                                <input asp-for="Phone" class="form-control form-control-lg rounded-3" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SelectedStates" class="form-label text-success fw-bold fs-5">States of Operation</label>
                                <select asp-for="SelectedStates" class="form-select form-select-lg rounded-3" asp-items="ViewBag.States" multiple required size="6">
                                </select>
                                <small class="text-muted">Hold Ctrl/Cmd to select more than one state.</small>
                                <span asp-validation-for="SelectedStates" class="text-danger d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-success fw-bold fs-5">HMO Logo</label>
                                <input type="file" name="logo" accept="image/*" class="form-control form-control-lg rounded-3" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label text-success fw-bold fs-5">Address</label>
                                <textarea asp-for="Address" class="form-control form-control-lg rounded-3" rows="3"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label text-success fw-bold fs-5">Status</label>
                                <select asp-for="Status" class="form-select form-select-lg rounded-3" required>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Suspended">Suspended</option>
                                    <option value="Revoked">Revoked</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="text-center mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-success btn-lg px-7 shadow-lg fw-bold fs-4">
                                UPDATE HMO
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info btn-lg px-6 ms-3">
                                View Details
                            </a>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-6 ms-3">
                                Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
