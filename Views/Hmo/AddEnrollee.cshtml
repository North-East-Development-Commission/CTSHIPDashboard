@model CTSHIPDashboard.Models.Enrollee

<div class="container-fluid py-4">
    <div class="card border-0 shadow-lg mx-auto" style="max-width: 900px; border-radius: 25px;">
        <div class="card-header bg-success text-white text-center py-4">
            <h2>Register New Enrollee</h2>
        </div>
        <div class="card-body p-5">
            <form asp-action="AddEnrollee" method="post" enctype="multipart/form-data" class="ct-enrollment-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-4" role="alert"></div>

                <div class="text-center mb-4">
                    <img src="/images/default-avatar.png" id="photoPreview" class="rounded-circle shadow" style="width: 150px; height: 150px; object-fit: cover;" />
                    <div class="mt-3">
                        <input type="file" asp-for="PhotoFile" class="form-control" accept="image/*" onchange="previewImage(this)" id="PhotoFile" />
                        <small class="text-muted">Upload passport photo (JPG/PNG)</small>
                        <span asp-validation-for="PhotoFile" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label text-success fw-bold"></label>
                        <input asp-for="FullName" class="form-control form-control-lg" required id="FullName" />
                        <span asp-validation-for="FullName" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label text-success fw-bold"></label>
                        <select asp-for="Gender" class="form-select form-select-lg" id="Gender">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger d-block" aria-live="polite"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label text-success fw-bold"></label>
                        <input asp-for="DateOfBirth" class="form-control form-control-lg" type="date" required id="DateOfBirth"
                               value="@(Model.DateOfBirth == default ? string.Empty : Model.DateOfBirth.ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="DateOfBirth" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label text-success fw-bold">Phone Number (optional)</label>
                        <input asp-for="Phone" class="form-control form-control-lg" id="Phone" type="tel"
                               data-val="true" data-val-regex="Enter a valid phone number, such as 08012345678, or leave it blank."
                               data-val-regex-pattern="^[0-9+()\s.-]+(?:(?:[xX]|[eE][xX][tT]\.?)\s*[0-9]+)?$" />
                        <span asp-validation-for="Phone" class="text-danger d-block" aria-live="polite"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NIN" class="form-label text-success fw-bold">NIN (optional)</label>
                        <input asp-for="NIN" class="form-control form-control-lg" inputmode="numeric" id="NIN" />
                        <span asp-validation-for="NIN" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                    <partial name="_NorthEastLocationFields" model="Model" />
                    <div class="col-md-6">
                        <label asp-for="HmoId" class="form-label text-success fw-bold">Assigned HMO</label>
                        <select asp-for="HmoId" class="form-select form-select-lg" id="HmoId" asp-items="ViewBag.Hmos" required
                                data-val="true" data-val-required="Select an assigned HMO.">
                            <option value="">Select HMO</option>
                        </select>
                        <span asp-validation-for="HmoId" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProviderId" class="form-label text-success fw-bold">Assigned Facility</label>
                        <select asp-for="ProviderId" class="form-select form-select-lg" id="ProviderId" asp-items="ViewBag.Provider" required
                                data-val="true" data-val-required="Select a facility assigned to the selected HMO.">
                            <option value="">Select Facility</option>
                        </select>
                        <span asp-validation-for="ProviderId" class="text-danger d-block" aria-live="polite"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label text-success fw-bold">Address (optional)</label>
                        <textarea asp-for="Address" class="form-control" rows="3" id="Address"></textarea>
                        <span asp-validation-for="Address" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label text-success fw-bold"></label>
                        <select asp-for="Status" class="form-select form-select-lg" id="Status" required>
                            <option value="">Select Status</option>
                            <option>Active</option>
                            <option>Suspended</option>
                            <option>Terminated</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger d-block" aria-live="polite"></span>
                    </div>
                    <partial name="_VulnerabilityFields" model="Model" />
                </div>

                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-success btn-lg px-5 shadow-lg">
                        REGISTER ENROLLEE
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg px-5 ms-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('photoPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
