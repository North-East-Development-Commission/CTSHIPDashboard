@model CTSHIPDashboard.Models.ViewModels.HmoBulkDisbursementViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json
@{
    ViewData["Title"] = "Bulk Fund Disbursement";
    var statusItems = Model.StatusOptions.Select(option => new SelectListItem
    {
        Value = option.Value,
        Text = $"{option.Label} ({option.EligibleCount:N0})",
        Selected = string.Equals(option.Value, Model.Status, StringComparison.OrdinalIgnoreCase)
    });
    var categoryItems = Model.CategoryOptions.Select(category => new SelectListItem
    {
        Value = category,
        Text = category,
        Selected = string.Equals(category, Model.Category, StringComparison.OrdinalIgnoreCase)
    });
    var statusCounts = Model.StatusOptions.ToDictionary(option => option.Value, option => option.EligibleCount);
}

<div class="container py-5">
    <div class="mx-auto" style="max-width:820px;">
        <div class="card border-0 shadow-lg overflow-hidden">
            <div class="card-header bg-success text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                          style="width:54px;height:54px;background:#C9A247;">
                        <i class="bi bi-wallet2 fs-3 text-white"></i>
                    </span>
                    <div>
                        <h3 class="mb-1">Bulk Fund Disbursement</h3>
                        <p class="mb-0 text-white">@Model.HmoName</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-lg-5">
                <p class="text-muted mb-4">
                    Filter enrollees by status and credit the same amount to every eligible wallet in one transaction.
                </p>

                <form id="disburseForm" asp-action="DisburseMonthly" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    }

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-bold"></label>
                            <select asp-for="Category"
                                    asp-items="categoryItems"
                                    id="categoryFilter"
                                    class="form-select form-select-lg"
                                    required></select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                            <div class="form-text">Monthly Allocation remains the default category.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status"
                                    asp-items="statusItems"
                                    id="statusFilter"
                                    class="form-select form-select-lg"
                                    required></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                            <div class="form-text">The number beside each status is the current eligible count.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="AmountPerEnrollee" class="form-label fw-bold"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-success text-white">₦</span>
                                <input asp-for="AmountPerEnrollee"
                                       id="amountInput"
                                       class="form-control"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="0.00"
                                       required />
                            </div>
                            <span asp-validation-for="AmountPerEnrollee" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="rounded-3 p-4 mt-4 text-white" style="background:#3B703B;">
                        <div class="row g-3 text-center">
                            <div class="col-sm-3">
                                <small class="d-block text-white">Category</small>
                                <strong id="categoryPreview" class="fs-6">—</strong>
                            </div>
                            <div class="col-sm-3 border-start border-light border-opacity-50">
                                <small class="d-block text-white">Selected status</small>
                                <strong id="statusPreview" class="fs-6">—</strong>
                            </div>
                            <div class="col-sm-3 border-start border-light border-opacity-50">
                                <small class="d-block text-white">Eligible enrollees</small>
                                <strong id="eligiblePreview" class="fs-6">0</strong>
                            </div>
                            <div class="col-sm-3 border-start border-light border-opacity-50">
                                <small class="d-block text-white">Total disbursement</small>
                                <strong id="totalPreview" class="fs-6">₦0.00</strong>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                        <a asp-action="Dashboard" class="btn btn-outline-success btn-lg">Back to Dashboard</a>
                        <button id="openConfirmBtn" type="button" class="btn btn-success btn-lg">
                            <i class="bi bi-send-check me-2"></i>Review Disbursement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="confirmModalLabel">Confirm Bulk Disbursement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">Please confirm the funding instruction:</p>
                <div class="rounded-3 p-3" style="background:rgba(201,162,71,.16);border:1px solid #C9A247;">
                    <div><strong>Category:</strong> <span id="confirmCategory"></span></div>
                    <div><strong>Status:</strong> <span id="confirmStatus"></span></div>
                    <div><strong>Eligible enrollees:</strong> <span id="confirmCount"></span></div>
                    <div><strong>Amount per enrollee:</strong> ₦<span id="confirmAmount"></span></div>
                    <div><strong>Total:</strong> ₦<span id="confirmTotal"></span></div>
                </div>
                <p class="text-danger mt-3 mb-0">
                    <small>This action credits every eligible wallet and cannot be automatically undone.</small>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-success" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmSubmitBtn" type="button" class="btn btn-success">
                    Confirm and Disburse
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const statusCounts = @Html.Raw(JsonSerializer.Serialize(statusCounts));
            const form = document.getElementById('disburseForm');
            const categoryFilter = document.getElementById('categoryFilter');
            const statusFilter = document.getElementById('statusFilter');
            const amountInput = document.getElementById('amountInput');
            const openButton = document.getElementById('openConfirmBtn');
            const confirmButton = document.getElementById('confirmSubmitBtn');
            const modal = new bootstrap.Modal(document.getElementById('confirmModal'));

            const currency = value => Number(value || 0).toLocaleString('en-NG', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const selectedCount = () => statusCounts[statusFilter.value] || 0;
            const selectedLabel = () => statusFilter.options[statusFilter.selectedIndex]?.text.replace(/\s+\([\d,]+\)$/, '') || '';

            function refreshSummary() {
                const amount = Number(amountInput.value || 0);
                const count = selectedCount();
                document.getElementById('categoryPreview').textContent = categoryFilter.value;
                document.getElementById('statusPreview').textContent = selectedLabel();
                document.getElementById('eligiblePreview').textContent = count.toLocaleString('en-NG');
                document.getElementById('totalPreview').textContent = `₦${currency(amount * count)}`;
            }

            categoryFilter.addEventListener('change', refreshSummary);
            statusFilter.addEventListener('change', refreshSummary);
            amountInput.addEventListener('input', refreshSummary);
            refreshSummary();

            openButton.addEventListener('click', () => {
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                const amount = Number(amountInput.value);
                const count = selectedCount();
                if (amount <= 0 || count <= 0) {
                    Swal.fire('Nothing to disburse', 'Select a status with eligible enrollees and enter an amount greater than zero.', 'warning');
                    return;
                }

                document.getElementById('confirmCategory').textContent = categoryFilter.value;
                document.getElementById('confirmStatus').textContent = selectedLabel();
                document.getElementById('confirmCount').textContent = count.toLocaleString('en-NG');
                document.getElementById('confirmAmount').textContent = currency(amount);
                document.getElementById('confirmTotal').textContent = currency(amount * count);
                modal.show();
            });

            confirmButton.addEventListener('click', () => {
                confirmButton.disabled = true;
                confirmButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Disbursing...';
                form.submit();
            });
        })();
    </script>
}
