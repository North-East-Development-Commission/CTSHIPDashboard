@model CTSHIPDashboard.Models.Hmo
@{
    ViewData["Title"] = $"{ViewBag.HmoName} - HMO Dashboard";
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            @ViewBag.HmoName <small class="fs-5 text-muted">(@ViewBag.HmoCode)</small>
        </h1>
        <p class="lead text-success fw-bold">HMO Performance Dashboard</p>
        <p class="text-muted">Real-time data as at @DateTime.Now</p>
        <a asp-action="DisburseMonthly" class="btn btn-success btn-lg mt-2 shadow">
            <i class="bi bi-wallet2 me-2"></i>Bulk Fund Disbursement
        </a>
    </div>

    <!-- KPI CARDS -->
    <div class="row g-4 mb-5 text-center">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-people fs-1 mb-3"></i>
                    <h5>Total Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.EnrolleeCount</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.ClaimCount</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-hospital fs-1 mb-3"></i>
                    <h5>Providers</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.ProviderCount</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Claims Value</h5>
                    <h2 class="display-5 fw-bold">₦@((int)ViewBag.TotalClaimAmount)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional KPIs: Deaths & Wallets -->
    <div class="row g-4 mb-5 text-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-body py-4">
                    <i class="bi bi-heartbreak fs-1 mb-3 text-danger"></i>
                    <h5 class="fw-bold">Recorded Deaths (Audited)</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.DeathCount</h2>
                    <p class="mb-0 opacity-75">Rate: @ViewBag.DeathRatePerThousand per 1,000 enrollees</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-body py-4">
                    <i class="bi bi-wallet2 fs-1 mb-3 text-success"></i>
                    <h5 class="fw-bold">Enrollees Wallets</h5>
                    <h2 class="display-5 fw-bold">₦@((int)ViewBag.TotalWalletBalance)</h2>
                    <p class="mb-0 opacity-75">Average balance: ₦@((int)ViewBag.AverageWalletBalance)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CLAIMS STATUS -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card bg-warning text-dark shadow-lg">
                <div class="card-body text-center py-3">
                    <i class="bi bi-hourglass-split fs-1 mb-3"></i>
                    <h5>Pending Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.PendingClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success text-white shadow-lg">
                <div class="card-body text-center py-3">
                    <i class="bi bi-check-circle-fill fs-1 mb-3"></i>
                    <h5>Approved Claims</h5>
                    <h2 class="display-5 fw-bold">@(ViewBag.PaidClaims.ToString("N2"))</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="fw-bold mb-0">Complaint Management Metrics</h3>
        <a asp-controller="Complaints" asp-action="Index" class="btn btn-success">
            <i class="bi bi-chat-square-text-fill me-1"></i> Manage HMO Complaints
        </a>
    </div>
    <partial name="_ComplaintMetrics" model="ViewBag.ComplaintMetrics" />

    <!-- PROVIDERS UNDER THIS HMO -->
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="fw-bold mb-0">Your Accredited Providers (@ViewBag.ProviderCount)</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Facility Name</th>
                            <th>State</th>
                            <th>Level</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ProviderCount == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted fs-4">
                                    No providers accredited yet
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in ViewBag.Providers)
                            {
                                <tr>
                                    <td><strong>@p.Name</strong></td>
                                    <td>@p.State</td>
                                    <td>@p.Level</td>
                                    <td>
                                        <span class="badge @(p.IsActive ? "bg-success" : "bg-danger")">
                                            @(p.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="ProDetails" asp-route-id="@p.Id"
                                           class="btn btn-info btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-5 py-5 bg-dark text-white rounded-4">
        <p class="display-6 fw-bold mb-3">One HMO. One Mission.</p>
        <p class="lead mb-0">NEDC CTSHIP — Universal Health Coverage for Vulerable Population In The North East</p>
    </div>
</div>
