@using CTSHIPDashboard.Models.ViewModels
@model CTSHIPDashboard.Models.Hmo
@{
    ViewData["Title"] = $"{ViewBag.HmoName} - HMO Dashboard";
    var encounterDemographicMatrix = ViewBag.EncounterDemographicMatrix as EncounterDemographicMatrixViewModel ?? new EncounterDemographicMatrixViewModel();
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            @ViewBag.HmoName <small class="fs-5 text-muted">(@ViewBag.HmoCode)</small>
        </h1>
        <p class="lead text-success fw-bold">HMO Performance Dashboard</p>
        <p class="text-muted">Real-time data as at @DateTime.Now</p>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
            <a asp-action="Capitation" class="btn btn-success btn-lg">
                <i class="bi bi-cash-stack me-1"></i> Capitation
            </a>
            <a asp-action="PrimaryProviderEncountersReport" class="btn btn-outline-success btn-lg">
                <i class="bi bi-clipboard2-pulse me-1"></i> Primary Encounter Register
            </a>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="row g-4 mb-5 text-center">
        <div class="col-xl-4 col-md-6">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-people fs-1 mb-3"></i>
                    <h5>Total Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.EnrolleeCount</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-info text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.ClaimCount</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-hospital fs-1 mb-3"></i>
                    <h5>Providers</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.ProviderCount</h2>
                </div>
            </div>
        </div>
    </div>

    <partial name="_EncounterDemographicMatrix" model="encounterDemographicMatrix" />

    <!-- REFERRAL STATUS -->
    <div class="card border-0 shadow-lg mb-5">
        <div class="card-header bg-success text-white py-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h3 class="fw-bold mb-0">Referral Metrics</h3>
                <a asp-controller="HmoReferrals" asp-action="Index" class="btn btn-warning fw-bold">
                    <i class="bi bi-hospital me-1"></i> Manage Referrals
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center">
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-send fs-2 text-success"></i>
                        <h6 class="mt-2">Total</h6>
                        <h2 class="fw-bold">@ViewBag.TotalReferrals</h2>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-hourglass-split fs-2 text-warning"></i>
                        <h6 class="mt-2">Awaiting Verification</h6>
                        <h2 class="fw-bold">@ViewBag.PendingReferralVerification</h2>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-activity fs-2 text-primary"></i>
                        <h6 class="mt-2">Active</h6>
                        <h2 class="fw-bold">@ViewBag.ActiveReferrals</h2>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-check-circle fs-2 text-success"></i>
                        <h6 class="mt-2">Completed</h6>
                        <h2 class="fw-bold">@ViewBag.CompletedReferrals</h2>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-x-circle fs-2 text-danger"></i>
                        <h6 class="mt-2">Rejected</h6>
                        <h2 class="fw-bold">@ViewBag.RejectedReferrals</h2>
                    </div>
                </div>
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <div class="border rounded-3 p-3 h-100">
                        <i class="bi bi-graph-up-arrow fs-2 text-success"></i>
                        <h6 class="mt-2">Completion</h6>
                        <h2 class="fw-bold">@ViewBag.ReferralCompletionRate.ToString("N1")%</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CLAIMS STATUS -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card bg-warning text-dark shadow-lg">
                <div class="card-body text-center py-3">
                    <i class="bi bi-hourglass-split fs-1 mb-3"></i>
                    <h5>Pending Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.PendingClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success text-white shadow-lg">
                <div class="card-body text-center py-3">
                    <i class="bi bi-check-circle-fill fs-1 mb-3"></i>
                    <h5>Approved Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.PaidClaims</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="fw-bold mb-0">Complaint Management Metrics</h3>
        <a asp-controller="Complaints" asp-action="Index" class="btn btn-success">
            <i class="bi bi-chat-square-text-fill me-1"></i> Manage HMO Complaints
        </a>
    </div>
    <partial name="_ComplaintMetrics" model="ViewBag.ComplaintMetrics" />

    <!-- PROVIDERS UNDER THIS HMO -->
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-primary text-white py-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h3 class="fw-bold mb-0">Your Accredited Providers (@ViewBag.ProviderCount)</h3>
                <a asp-controller="Providers" asp-action="Create" class="btn btn-warning fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Add Provider
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Facility Name</th>
                            <th>State</th>
                            <th>Level</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ProviderCount == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted fs-4">
                                    No providers accredited yet
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in ViewBag.Providers)
                            {
                                <tr>
                                    <td><strong>@p.Name</strong></td>
                                    <td>@p.State</td>
                                    <td>@p.Level</td>
                                    <td>
                                        <span class="badge @(p.IsActive ? "bg-success" : "bg-danger")">
                                            @(p.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="ProDetails" asp-route-id="@p.Id"
                                           class="btn btn-info btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-5 py-5 bg-dark text-white rounded-4">
        <p class="display-6 fw-bold mb-3">One HMO. One Mission.</p>
        <p class="lead mb-0">NEDC CTSHIP — Universal Health Coverage for Vulerable Population In The North East</p>
    </div>
</div>
