@model CTSHIPDashboard.Models.ViewModels.CapitationIndexViewModel

@{
    ViewData["Title"] = "Capitation";
    var availableHmos = ViewBag.AvailableHmos as List<Hmo> ?? new List<Hmo>();
    int? selectedHmoId = ViewBag.SelectedHmoId as int?;
    bool canUpdateCapitation = ViewBag.CanUpdateCapitation as bool? ?? User.IsInRole("HMO");
}


@section Styles {
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <style>
        .select2-container--default .select2-selection--multiple {
            min-height: 48px;
            border-color: #ced4da;
            padding: .25rem;
        }
    </style>
}
<div class="container-fluid py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="display-5 fw-bold text-success mb-2">Capitation Payment Register</h1>
            <p class="lead mb-0">@Model.HmoName <span class="text-muted">(@Model.HmoCode)</span></p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
    }

    <form asp-action="Capitation" method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-bold">Reporting Month</label>
                    <input type="month" name="reportingMonth" value="@Model.ReportingMonth.ToString("yyyy-MM")" class="form-control form-control-lg" />
                </div>
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-bold">Default Capitation Rate</label>
                    <input type="number" name="capitationPerEnrollee" value="@Model.DefaultCapitationPerEnrollee" min="0" step="0.01" class="form-control form-control-lg" />
                </div>
                <div class="col-lg-4">
                    <button type="submit" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-funnel-fill me-1"></i> Apply
                    </button>
                </div>
            </div>
        </div>
    </form>


    @if (canUpdateCapitation)
    {
        <form asp-action="BulkDisburseCapitation" method="post" class="card border-0 shadow-sm mb-4">
            @Html.AntiForgeryToken()
            <div class="card-header bg-light">
                <h3 class="fw-bold mb-0">Capitation Manager</h3>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label fw-bold">Primary Provider(s)</label>
                        <select name="ProviderIds" class="form-select capitation-provider-select" multiple data-placeholder="Search and select one or more providers">
                            @foreach (var provider in Model.Providers)
                            {
                                <option value="@provider.ProviderId">@provider.ProviderName (@provider.ProviderCode) - @provider.EnrolleeCount.ToString("N0") enrollees</option>
                            }
                        </select>
                        <div class="form-text">Choose one provider for a single disbursement, or select multiple providers for bulk disbursement.</div>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold">Reporting Month</label>
                        <input type="month" name="ReportingMonth" value="@Model.ReportingMonth.ToString("yyyy-MM")" class="form-control" />
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold">Rate Per Enrollee</label>
                        <input type="number" name="CapitationPerEnrollee" value="@Model.DefaultCapitationPerEnrollee" min="0.01" step="0.01" class="form-control" />
                    </div>
                    <div class="col-lg-3 col-md-4">
                        <label class="form-label fw-bold">Payment Reference</label>
                        <input type="text" name="PaymentReference" maxlength="100" class="form-control" placeholder="Transaction/reference" />
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold">Payment Period</label>
                        <select name="PaymentPeriod" class="form-select">
                            <option value="Monthly">Monthly</option>
                            <option value="Quarterly">Quarterly</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold">Due Date</label>
                        <input type="date" name="DueDate" value="@Model.ReportingMonth.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold">Received Date</label>
                        <input type="date" name="ProviderPaymentReceivedDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-lg-3 d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-cash-coin me-1"></i> Disburse Capitation
                        </button>
                    </div>
                </div>
            </div>
        </form>
    }
    <div class="row g-3 mb-4 text-center">
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">PHC Providers</p><h2 class="fw-bold text-primary mb-0">@Model.Providers.Count</h2></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Enrollees</p><h2 class="fw-bold text-success mb-0">@Model.TotalEnrollees.ToString("N0")</h2></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Service Encounters</p><h2 class="fw-bold text-dark mb-0">@Model.TotalSubmittedEncounters.ToString("N0")</h2></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">HMO Certified</p><h2 class="fw-bold text-success mb-0">@Model.TotalHmoCertifiedEncounters.ToString("N0")</h2></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Pending / Query</p><h3 class="fw-bold text-warning mb-0">@((Model.TotalPendingVerificationEncounters + Model.TotalQueryRaisedEncounters).ToString("N0"))</h3></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Certified Utilization</p><h3 class="fw-bold text-info mb-0">@Model.AverageUtilizationRate.ToString("N2")%</h3></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Expected Capitation</p><h3 class="fw-bold text-dark mb-0">NGN @Model.TotalCapitation.ToString("N2")</h3></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Certified Service Charge</p><h3 class="fw-bold text-success mb-0">NGN @Model.TotalHmoCertifiedCapitationCharge.ToString("N2")</h3></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Actual Paid</p><h3 class="fw-bold text-success mb-0">NGN @Model.TotalActualPayment.ToString("N2")</h3></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Outstanding</p><h3 class="fw-bold text-danger mb-0">NGN @Model.TotalOutstandingAmount.ToString("N2")</h3></div></div></div>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-header bg-success text-white py-3">
            <h3 class="fw-bold mb-0">HMO Verified Capitation Payments</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Provider</th>
                            <th>Enrollees</th>
                            <th>HMO Verification</th>
                            <th>Rate</th>
                            <th>Expected Amount</th>
                            <th>Certified Charge</th>
                            <th>Actual Paid</th>
                            <th>Outstanding</th>
                            <th>Payment Evidence</th>
                            <th>Due / Received</th>
                            @if (canUpdateCapitation)
                            {
                                <th>Update</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Providers.Any())
                        {
                            <tr>
                                <td colspan="@(canUpdateCapitation ? 11 : 10)" class="text-center py-5 text-muted fs-5">No active PHC providers found for this HMO.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var provider in Model.Providers)
                            {
                                string badgeClass = provider.PaymentStatus == "Paid"
                                    ? "bg-success"
                                    : provider.PaymentStatus == "Partially Paid"
                                        ? "bg-info text-dark"
                                        : "bg-warning text-dark";
                                bool hasPaymentEvidence = !string.IsNullOrWhiteSpace(provider.ProofOfPaymentPath);
                                bool hasPaymentReference = !string.IsNullOrWhiteSpace(provider.PaymentReference);
                                <tr>
                                    <td>
                                        <div class="fw-bold">@provider.ProviderName</div>
                                        <div class="small text-muted">@provider.ProviderCode - @provider.ProviderLevel</div>
                                        <div class="small text-muted">@provider.PaymentPeriod</div>
                                    </td>
                                    <td class="fw-bold">@provider.EnrolleeCount.ToString("N0")</td>
                                    <td>
                                        <div><strong>Service encounters:</strong> @provider.SubmittedEncounterCount.ToString("N0")</div>
                                        <div><strong>Certified:</strong> <span class="text-success fw-bold">@provider.HmoCertifiedEncounterCount.ToString("N0")</span></div>
                                        <div><strong>Pending:</strong> @provider.PendingVerificationEncounterCount.ToString("N0")</div>
                                        <div><strong>Query:</strong> @provider.QueryRaisedEncounterCount.ToString("N0")</div>
                                        <div class="small text-muted">Certified users: @provider.HmoVerifiedUtilizedEnrolleeCount.ToString("N0")</div>
                                        @if (provider.HasPendingHmoVerification)
                                        {
                                            <a asp-action="PrimaryProviderEncountersReport" asp-route-status="Submitted" asp-route-fromDate="@Model.ReportingMonth.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ReportingMonth.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")" class="small">Review pending encounters</a>
                                        }
                                    </td>
                                    <td>NGN @provider.CapitationPerEnrollee.ToString("N2")</td>
                                    <td class="fw-bold">NGN @provider.TotalCapitation.ToString("N2")</td>
                                    <td class="fw-bold text-success">NGN @provider.HmoCertifiedCapitationCharge.ToString("N2")</td>
                                    <td class="fw-bold text-success">NGN @provider.ActualPaymentMade.ToString("N2")</td>
                                    <td class="fw-bold @(provider.OutstandingAmount > 0 ? "text-danger" : "text-success")">NGN @provider.OutstandingAmount.ToString("N2")</td>
                                    <td>
                                        <span class="badge @badgeClass">@provider.PaymentStatus</span>
                                        @if (hasPaymentReference)
                                        {
                                            <div class="fw-bold small mt-1">@provider.PaymentReference</div>
                                        }
                                        @if (hasPaymentEvidence)
                                        {
                                            <a href="@provider.ProofOfPaymentPath" target="_blank" class="btn btn-sm btn-outline-success mt-2">
                                                <i class="bi bi-file-earmark-check me-1"></i> View evidence
                                            </a>
                                        }
                                        else if (provider.PaymentStatus == "Paid" || provider.PaymentStatus == "Partially Paid")
                                        {
                                            <div class="small text-danger mt-2">Evidence required</div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mt-2">No payment evidence yet</div>
                                        }
                                    </td>
                                    <td>
                                        <div><strong>Due:</strong> @(provider.DueDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                        <div><strong>Received:</strong> @(provider.ProviderPaymentReceivedDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                        @if (provider.PaymentTimelinessDays.HasValue)
                                        {
                                            <span class="badge @(provider.PaymentTimelinessDays.Value <= 0 ? "bg-success" : "bg-danger") mt-1">@provider.PaymentTimelinessDays.Value day(s)</span>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mt-1">Pending</div>
                                        }
                                    </td>
                                    @if (canUpdateCapitation)
                                    {
                                        <td style="min-width: 420px;">
                                            <form asp-action="UpdateCapitationPayment" method="post" enctype="multipart/form-data" class="d-grid gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ProviderId" value="@provider.ProviderId" />
                                                <input type="hidden" name="ReportingMonth" value="@Model.ReportingMonth.ToString("yyyy-MM")" />

                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <select name="PaymentPeriod" class="form-select form-select-sm" aria-label="Payment period">
                                                            <option value="Monthly" selected="@(provider.PaymentPeriod == "Monthly")">Monthly</option>
                                                            <option value="Quarterly" selected="@(provider.PaymentPeriod == "Quarterly")">Quarterly</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="number" name="CapitationPerEnrollee" value="@provider.CapitationPerEnrollee" min="0" step="0.01" class="form-control form-control-sm" aria-label="Capitation rate" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="number" name="ActualPaymentMade" value="@provider.ActualPaymentMade" min="0" step="0.01" class="form-control form-control-sm" aria-label="Actual payment made" />
                                                    </div>
                                                </div>

                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <input type="date" name="DueDate" value="@provider.DueDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Due date" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="date" name="ProviderPaymentReceivedDate" value="@provider.ProviderPaymentReceivedDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Provider received date" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <select name="PaymentStatus" class="form-select form-select-sm" aria-label="Payment status">
                                                            <option value="Pending" selected="@(provider.PaymentStatus == "Pending")">Pending</option>
                                                            <option value="Partially Paid" selected="@(provider.PaymentStatus == "Partially Paid")">Partially Paid</option>
                                                            <option value="Paid" selected="@(provider.PaymentStatus == "Paid")">Paid</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <input type="text" name="PaymentReference" value="@provider.PaymentReference" maxlength="100" class="form-control form-control-sm" placeholder="Transaction/payment reference" />
                                                <input type="file" name="proofOfPayment" accept=".pdf,.jpg,.jpeg,.png" class="form-control form-control-sm" aria-label="Evidence of payment" />

                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check2-circle me-1"></i> Save payment evidence
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script>
        $(function () {
            $('.capitation-provider-select').select2({
                width: '100%',
                placeholder: $('.capitation-provider-select').data('placeholder'),
                allowClear: true
            });
        });
    </script>
}