@model CTSHIPDashboard.Models.ViewModels.CapitationIndexViewModel

@{
    ViewData["Title"] = "Capitation";
    var availableHmos = ViewBag.AvailableHmos as List<Hmo> ?? new List<Hmo>();
    int? selectedHmoId = ViewBag.SelectedHmoId as int?;
    bool canUpdateCapitation = ViewBag.CanUpdateCapitation as bool? ?? User.IsInRole("HMO");
}

<div class="container-fluid py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="display-5 fw-bold text-success mb-2">Capitation Payment Register</h1>
            <p class="lead mb-0">@Model.HmoName <span class="text-muted">(@Model.HmoCode)</span></p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
    }

    <form asp-action="Capitation" method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-bold">Reporting Month</label>
                    <input type="month" name="reportingMonth" value="@Model.ReportingMonth.ToString("yyyy-MM")" class="form-control form-control-lg" />
                </div>
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-bold">Default Capitation Rate</label>
                    <input type="number" name="capitationPerEnrollee" value="@Model.DefaultCapitationPerEnrollee" min="0" step="0.01" class="form-control form-control-lg" />
                </div>
                <div class="col-lg-4">
                    <button type="submit" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-funnel-fill me-1"></i> Apply
                    </button>
                </div>
            </div>
        </div>
    </form>

    <div class="row g-3 mb-4 text-center">
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">PHC Providers</p><h2 class="fw-bold text-primary mb-0">@Model.Providers.Count</h2></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Enrollees</p><h2 class="fw-bold text-success mb-0">@Model.TotalEnrollees.ToString("N0")</h2></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Expected</p><h3 class="fw-bold text-dark mb-0">NGN @Model.TotalCapitation.ToString("N2")</h3></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Actual Paid</p><h3 class="fw-bold text-success mb-0">NGN @Model.TotalActualPayment.ToString("N2")</h3></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Outstanding</p><h3 class="fw-bold text-danger mb-0">NGN @Model.TotalOutstandingAmount.ToString("N2")</h3></div></div></div>
        <div class="col-xl-2 col-md-4 col-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><p class="text-muted fw-bold mb-1">Utilization</p><h3 class="fw-bold text-info mb-0">@Model.AverageUtilizationRate.ToString("N2")%</h3></div></div></div>
    </div>

    <div class="card border-0 shadow-lg">
        <div class="card-header bg-success text-white py-3">
            <h3 class="fw-bold mb-0">Monthly / Quarterly Capitation Payments</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Provider</th>
                            <th>Enrollees</th>
                            <th>Rate</th>
                            <th>Expected Amount</th>
                            <th>Actual Paid</th>
                            <th>Outstanding</th>
                            <th>Due / Received</th>
                            <th>Timeliness</th>
                            <th>Status / Reference</th>
                            @if (canUpdateCapitation)
                            {
                                <th>Update</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Providers.Any())
                        {
                            <tr>
                                <td colspan="@(canUpdateCapitation ? 10 : 9)" class="text-center py-5 text-muted fs-5">No active PHC providers found for this HMO.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var provider in Model.Providers)
                            {
                                string badgeClass = provider.PaymentStatus == "Paid"
                                    ? "bg-success"
                                    : provider.PaymentStatus == "Partially Paid"
                                        ? "bg-info text-dark"
                                        : "bg-warning text-dark";
                                <tr>
                                    <td>
                                        <div class="fw-bold">@provider.ProviderName</div>
                                        <div class="small text-muted">@provider.ProviderCode - @provider.ProviderLevel</div>
                                        <div class="small text-muted">@provider.PaymentPeriod</div>
                                    </td>
                                    <td class="fw-bold">@provider.EnrolleeCount.ToString("N0")</td>
                                    <td>NGN @provider.CapitationPerEnrollee.ToString("N2")</td>
                                    <td class="fw-bold">NGN @provider.TotalCapitation.ToString("N2")</td>
                                    <td class="fw-bold text-success">NGN @provider.ActualPaymentMade.ToString("N2")</td>
                                    <td class="fw-bold @(provider.OutstandingAmount > 0 ? "text-danger" : "text-success")">NGN @provider.OutstandingAmount.ToString("N2")</td>
                                    <td>
                                        <div><strong>Due:</strong> @(provider.DueDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                        <div><strong>Received:</strong> @(provider.ProviderPaymentReceivedDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                    </td>
                                    <td>
                                        @if (provider.PaymentTimelinessDays.HasValue)
                                        {
                                            <span class="badge @(provider.PaymentTimelinessDays.Value <= 0 ? "bg-success" : "bg-danger")">@provider.PaymentTimelinessDays.Value day(s)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass">@provider.PaymentStatus</span>
                                        @if (!string.IsNullOrWhiteSpace(provider.PaymentReference))
                                        {
                                            <div class="fw-bold small mt-1">@provider.PaymentReference</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(provider.ProofOfPaymentPath))
                                        {
                                            <a href="@provider.ProofOfPaymentPath" target="_blank" class="small">View proof</a>
                                        }
                                    </td>
                                    @if (canUpdateCapitation)
                                    {
                                        <td style="min-width: 420px;">
                                            <form asp-action="UpdateCapitationPayment" method="post" enctype="multipart/form-data" class="d-grid gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ProviderId" value="@provider.ProviderId" />
                                                <input type="hidden" name="ReportingMonth" value="@Model.ReportingMonth.ToString("yyyy-MM")" />

                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <select name="PaymentPeriod" class="form-select form-select-sm" aria-label="Payment period">
                                                            <option value="Monthly" selected="@(provider.PaymentPeriod == "Monthly")">Monthly</option>
                                                            <option value="Quarterly" selected="@(provider.PaymentPeriod == "Quarterly")">Quarterly</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="number" name="CapitationPerEnrollee" value="@provider.CapitationPerEnrollee" min="0" step="0.01" class="form-control form-control-sm" aria-label="Capitation rate" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="number" name="ActualPaymentMade" value="@provider.ActualPaymentMade" min="0" step="0.01" class="form-control form-control-sm" aria-label="Actual payment made" />
                                                    </div>
                                                </div>

                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <input type="date" name="DueDate" value="@provider.DueDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Due date" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <input type="date" name="ProviderPaymentReceivedDate" value="@provider.ProviderPaymentReceivedDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" aria-label="Provider received date" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <select name="PaymentStatus" class="form-select form-select-sm" aria-label="Payment status">
                                                            <option value="Pending" selected="@(provider.PaymentStatus == "Pending")">Pending</option>
                                                            <option value="Partially Paid" selected="@(provider.PaymentStatus == "Partially Paid")">Partially Paid</option>
                                                            <option value="Paid" selected="@(provider.PaymentStatus == "Paid")">Paid</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <input type="text" name="PaymentReference" value="@provider.PaymentReference" maxlength="100" class="form-control form-control-sm" placeholder="Transaction/payment reference" />
                                                <input type="file" name="proofOfPayment" accept=".pdf,.jpg,.jpeg,.png" class="form-control form-control-sm" />

                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check2-circle me-1"></i> Save
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>