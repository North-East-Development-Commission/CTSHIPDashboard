@using CTSHIPDashboard.Helpers
@model IEnumerable<CTSHIPDashboard.Models.Enrollee>
@{
    ViewData["Title"] = $"{ViewBag.HmoName} - Enrollee Dashboard";
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            My Enrollees
        </h1>
        <p class="lead text-success fw-bold">Enrollees Management Dashboard</p>
        <p class="text-muted">Total Enrollees: <strong>@ViewBag.TotalEnrollees</strong> | Active: <strong>@ViewBag.ActiveEnrollees</strong></p>
    </div>

    <div class="row g-4 mb-5 text-center">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-people fs-1 mb-3"></i>
                    <h5>Total Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalEnrollees</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-person-check fs-1 mb-3"></i>
                    <h5>Active Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.ActiveEnrollees</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-journal-medical fs-1 mb-3"></i>
                    <h5>Total Encounters</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalEncounters</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-dark shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalClaims</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="ExportEnrollees" class="btn btn-success btn-lg shadow-lg px-5">
            <i class="bi bi-file-earmark-excel me-2"></i> Export to Excel
        </a>
    </div>

    <!-- SEARCH & FILTERS -->
    <div class="card border-0 shadow mb-4">
        <div class="card-body">
            <form asp-action="EnrolleeDashboard" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Search by name, ID, or phone..." />
                    </div>
                    <div class="col-md-4">
                        <div class="col-md-3">
                            <select name="status" class="form-select form-select-lg rounded-3">
                                <option value="All">All Status</option>
                                <option value="Active" selected="@(ViewBag.Status == "Active")">Active Only</option>
                                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive Only</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="state" class="form-select form-select-lg rounded-3">
                            <option value="All">All States</option>
                            @foreach (var state in NorthEastLocationData.States)
                            {
                                <option value="@state" selected="@(ViewBag.State == state)">@state</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-3">
                            Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ADD NEW ENROLLEE BUTTON -->
    <div class="text-end mb-4">
        <a asp-action="AddEnrollee" class="btn btn-success btn-lg shadow-lg px-5">
            Add New Enrollee
        </a>
    </div>

    <!-- ENROLLEES TABLE -->
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="fw-bold mb-0">Your Enrollees (@ViewBag.TotalEnrollees)</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>ID</th>
                            <th>Phone</th>
                            <th>State</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted fs-4">
                                    No enrollees found
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var e in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@EnrolleePhotoStorage.ResolvePhotoPath(e.PhotoPath, e.EnrollmentNumber)"
                                             class="rounded-circle shadow" style="width:50px;height:50px;object-fit:cover;" />
                                    </td>
                                    <td class="fw-bold">@e.FullName</td>
                                    <td><span class="text-primary fw-bold">@e.EnrollmentNumber</span></td>
                                    <td>@e.Phone</td>
                                    <td>@e.State</td>
                                    <!-- FIX: STATUS FILTER — USE IsActive BOOLEAN -->
                                    <!-- FIX: STATUS BADGE — USE IsActive -->
                                    <td>
                                        <span class="badge @(e.Status == "Active" ? "bg-success" : "bg-secondary") px-4 py-2">
                                            @(e.Status == "Active" ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@e.DateRegistered</td>
                                    <td>
                                        <a asp-action="EnrolleeDetails" asp-route-id="@e.Id" class="btn btn-info btn-sm">View</a>
                                        <a asp-action="EditEnrollee" asp-route-id="@e.Id" class="btn btn-primary btn-sm">Edit</a>
                                        <a asp-action="DeleteEnrollee" asp-route-id="@e.Id" class="btn btn-danger btn-sm">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION -->
    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center flex-wrap">

                <!-- Previous Button -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-start-3"
                       asp-action="EnrolleeDashboard"
                       asp-route-search="@ViewBag.Search"
                       asp-route-status="@ViewBag.Status"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       tabindex="@(ViewBag.CurrentPage == 1 ? "-1" : null)">
                        Previous
                    </a>
                </li>

                <!-- First Page -->
                @if (ViewBag.CurrentPage > 4)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="EnrolleeDashboard"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-page="1">1</a>
                    </li>
                    @if (ViewBag.CurrentPage > 5)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                <!-- Page Numbers Around Current -->
                @{
                    int start = Math.Max(1, ViewBag.CurrentPage - 2);
                    int end = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
                }

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="EnrolleeDashboard"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <!-- Last Page -->
                @if (ViewBag.CurrentPage < ViewBag.TotalPages - 3)
                {
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages - 4)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="EnrolleeDashboard"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-page="@ViewBag.TotalPages">
                            @ViewBag.TotalPages
                        </a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a asp-action="EnrolleeDashboard"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-status="@ViewBag.Status"
                       asp-route-state="@ViewBag.State"
                       class="btn btn-primary @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
