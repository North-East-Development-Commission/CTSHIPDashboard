@using CTSHIPDashboard.Helpers
@model IEnumerable<CTSHIPDashboard.Models.Enrollee>
@{
    ViewData["Title"] = $"{ViewBag.HmoName} - Enrollee Dashboard";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    var filters = new Dictionary<string, string>
    {
        ["search"] = ViewBag.Search ?? "",
        ["status"] = ViewBag.Status ?? "All",
        ["state"] = ViewBag.State ?? "All",
        ["facility"] = ViewBag.Facility ?? "",
        ["pageSize"] = ViewBag.EnrolleePageSize.ToString()
    };
    bool canSelectEnrollees = User.IsInRole("HMO") && Model.Any();
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            My Enrollees
        </h1>
        <p class="lead text-success fw-bold">Enrollees Management Dashboard</p>
        <p class="text-muted">Total Enrollees: <strong>@ViewBag.TotalEnrollees</strong> | Active: <strong>@ViewBag.ActiveEnrollees</strong></p>
    </div>

    <div class="row g-4 mb-5 text-center">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-people fs-1 mb-3"></i>
                    <h5>Total Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalEnrollees</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-person-check fs-1 mb-3"></i>
                    <h5>Active Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.ActiveEnrollees</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-calendar2-check fs-1 mb-3"></i>
                    <h5>Number of Visits</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalVisits</h2>
                    <small>@ViewBag.TotalEncounters encounters</small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-dark shadow-lg h-100">
                <div class="card-body py-3">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalClaims</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="ExportEnrollees" class="btn btn-success btn-lg shadow-lg px-5">
            <i class="bi bi-file-earmark-excel me-2"></i> Export to Excel
        </a>
    </div>

    <!-- SEARCH & FILTERS -->
    <div class="card border-0 shadow mb-4">
        <div class="card-body">
            <form asp-action="EnrolleeDashboard" method="get"
                  id="enrollee-filters" data-facilities-url="@Url.Action("DirectoryFacilities", "Enrollees")">
                <input type="hidden" name="pageSize" value="@filters["pageSize"]" />
                <div class="row g-3">
                    <div class="col-lg-3">
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Search by name, ID, or phone..." />
                    </div>
                    <div class="col-lg-2">
                        <select name="status" class="form-select form-select-lg rounded-3" aria-label="Status">
                            <option value="All">All Status</option>
                            <option value="Active" selected="@(ViewBag.Status == "Active")">Active Only</option>
                            <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive Only</option>
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <select name="state" class="form-select form-select-lg rounded-3" aria-label="State">
                            <option value="All">All States</option>
                            @foreach (var state in NorthEastLocationData.States)
                            {
                                <option value="@state" selected="@(ViewBag.State == state)">@state</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3">
                        <select name="facility" class="form-select form-select-lg rounded-3" asp-items="ViewBag.FacilityList"
                                aria-label="Facility" aria-describedby="facility-filter-status">
                            <option value="">All Facilities</option>
                        </select>
                        <div id="facility-filter-status" class="form-text" role="status"></div>
                    </div>
                    <div class="col-lg-2">
                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-3">
                            Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ADD NEW ENROLLEE BUTTON -->
    <div class="text-end mb-4">
        <a asp-action="AddEnrollee" class="btn btn-success btn-lg shadow-lg px-5">
            Add New Enrollee
        </a>
    </div>

    @if (canSelectEnrollees)
    {
        <form id="delete-selected-enrollees" asp-action="DeleteSelectedEnrollees" method="post" class="mb-3">
            @foreach (var filter in filters)
            {
                <input type="hidden" name="@filter.Key" value="@filter.Value" />
            }
            <input type="hidden" name="page" value="@currentPage" />
            <button type="submit" class="btn btn-outline-danger" disabled>Delete selected</button>
        </form>
    }

    <!-- ENROLLEES TABLE -->
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="fw-bold mb-0">Your Enrollees (@ViewBag.TotalEnrollees)</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            @if (canSelectEnrollees)
                            {
                                <th scope="col">
                                    <input type="checkbox" class="form-check-input" id="select-page-enrollees"
                                           aria-label="Select all enrollees on this page" />
                                </th>
                            }
                            <th>Photo</th>
                            <th>Name</th>
                            <th>ID</th>
                            <th>Phone</th>
                            <th>State</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted fs-4">
                                    No enrollees found
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var e in Model)
                            {
                                <tr>
                                    @if (canSelectEnrollees)
                                    {
                                        <td>
                                            <input type="checkbox" class="form-check-input" form="delete-selected-enrollees"
                                                   name="ids" value="@e.Id" aria-label="Select @e.FullName (@e.EnrollmentNumber)" />
                                        </td>
                                    }
                                    <td>
                                        <img src="@EnrolleePhotoStorage.ResolvePhotoPath(e.PhotoPath, e.EnrollmentNumber)"
                                             class="rounded-circle shadow" style="width:50px;height:50px;object-fit:cover;" />
                                    </td>
                                    <td class="fw-bold">@e.FullName</td>
                                    <td><span class="text-primary fw-bold">@e.EnrollmentNumber</span></td>
                                    <td>@e.Phone</td>
                                    <td>@e.State</td>
                                    <!-- FIX: STATUS FILTER — USE IsActive BOOLEAN -->
                                    <!-- FIX: STATUS BADGE — USE IsActive -->
                                    <td>
                                        <span class="badge @(e.Status == "Active" ? "bg-success" : "bg-secondary") px-4 py-2">
                                            @(e.Status == "Active" ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@e.DateRegistered</td>
                                    <td>
                                        <a asp-action="EnrolleeDetails" asp-route-id="@e.Id" class="btn btn-info btn-sm">View</a>
                                        <a asp-action="EditEnrollee" asp-route-id="@e.Id" class="btn btn-primary btn-sm">Edit</a>
                                        <a asp-action="DeleteEnrollee" asp-route-id="@e.Id" class="btn btn-danger btn-sm">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_EnrolleePagination", (currentPage, totalPages, "EnrolleeDashboard", filters))
</div>

@section Scripts {
    <script type="module" src="~/js/enrollee-facility-filter.js" asp-append-version="true"></script>
    @if (canSelectEnrollees)
    {
        <script type="module" src="~/js/enrollee-selection.js" asp-append-version="true"></script>
    }
}
