@model IEnumerable<CTSHIPDashboard.Models.Provider>

@{
    ViewData["Title"] = $"Providers under {ViewBag.HmoName}";
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            My Provider Network
        </h1>
        <h2 class="display-5 text-success fw-bold">@ViewBag.HmoName</h2>
        <p class="lead text-muted">HMO Code: <strong>@ViewBag.HmoCode</strong></p>
        <p class="fs-4">Total Providers: <strong class="text-success">@ViewBag.TotalProviders</strong></p>
    </div>

    <!-- SEARCH -->
    <div class="card border-0 shadow-lg mb-5 rounded-4">
        <div class="card-body p-4">
            <form asp-action="MyProviders" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label fw-bold text-primary">Search Provider</label>
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Provider name, code, or state..." />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 shadow">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="col-auto">
        <a asp-controller="Providers" asp-action="Create" class="btn btn-warning btn-lg shadow-lg px-5 mb-lg-3">
            Add New Provider
        </a>
    </div>
    <!-- PROVIDERS TABLE -->
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="fw-bold mb-0">Accredited Providers (@ViewBag.TotalProviders total)</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Provider Name</th>
                            <th>Code</th>
                            <th>State</th>
                            <th>Level</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted fs-4">
                                    No providers accredited yet
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@p.Name</td>
                                    <td><span class="text-primary fw-bold">@p.Code</span></td>
                                    <td>@p.State</td>
                                    <td>@p.Level</td>
                                    <td>@p.Phone</td>
                                    <td>@p.Email</td>
                                    <td>
                                        <span class="badge @(p.IsActive ? "bg-success" : "bg-danger") px-4 py-2">
                                            @(p.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-controller="Hmo" asp-action="ProDetails" asp-route-id="@p.Id"
                                           class="btn btn-info btn-sm rounded-pill px-4">View</a>
                                        <a asp-controller="Hmo" asp-action="EncountersPerProvider" asp-route-id="@p.Id"
                                           class="btn btn-secondary btn-sm rounded-pill px-4">Encounters</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="MyProviders"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="MyProviders"
                           asp-route-search="@ViewBag.Search"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="MyProviders"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }

    <!-- Dashboard Button -->
    <div class="text-center mt-5">
        <a asp-action="Dashboard" class="btn btn-primary btn-lg px-7 shadow-lg fw-bold fs-4">
            BACK TO HMO DASHBOARD
        </a>
    </div>

    <!-- Footer -->
    <div class="text-center mt-5 py-5 bg-dark text-white rounded-4">
        <p class="display-6 fw-bold mb-3">Provider Network Management</p>
        <p class="lead mb-0">NEDC CTSHIP — Building Strong HMO-Provider Partnerships</p>
    </div>
</div>