@{
    ViewData["Title"] = "HMO Performance Analytics";
}

<div class="container-fluid py-4 py-md-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            HMO PERFORMANCE ANALYTICS
        </h1>
        <p class="lead text-muted">NEDC CTSHIP Digital System • Real-time Dashboard</p>
        <p class="fs-4 text-success fw-bold">As at @DateTime.Now</p>
    </div>

    <!-- KPI CARDS -->
    <div class="row g-4 mb-5 text-center">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg bg-primary text-white h-100">
                <div class="card-body py-5">
                    <i class="bi bi-building fs-1 mb-3"></i>
                    <h5>Total HMOs</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalHmos</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg bg-success text-white h-100">
                <div class="card-body py-5">
                    <i class="bi bi-people fs-1 mb-3"></i>
                    <h5>Total Enrollees</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalEnrollees</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg bg-info text-white h-100">
                <div class="card-body py-5">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-lg bg-warning text-dark h-100">
                <div class="card-body py-5">
                    <i class="bi  bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims Value</h5>
                    <h2 class="display-5 fw-bold">₦@((int)ViewBag.TotalClaimValue)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- TOP 10 HMOs BY ENROLLEES -->
    <div class="row g-5 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success text-white text-center py-4">
                    <h3 class="fw-bold mb-0">Top 10 HMOs by Enrollees</h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center">#</th>
                                    <th>HMO</th>
                                    <th class="text-end">Enrollees</th>
                                    <th class="text-end">Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in ViewBag.TopHmosEnrollees)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@h.Rank</td>
                                        <td>
                                            <strong>@h.Name</strong><br>
                                            <small class="text-muted">@h.RegistrationNumber</small>
                                        </td>
                                        <td class="text-end fw-bold fs-5">@h.Count</td>
                                        <td class="text-end">
                                            <span class="badge bg-success fs-6">@h.Percentage.ToString("F1")%</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOP 10 HMOs BY CLAIMS VALUE -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="fw-bold mb-0">Top 10 HMOs by Claims Value</h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-center">#</th>
                                    <th>HMO</th>
                                    <th class="text-end">Claims</th>
                                    <th class="text-end">Amount (₦)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in ViewBag.TopHmosClaims)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@h.Rank</td>
                                        <td>
                                            <strong>@h.Name</strong><br>
                                            <small class="text-muted">@h.RegistrationNumber</small>
                                        </td>
                                        <td class="text-end">@h.ClaimCount</td>
                                        <td class="text-end fw-bold text-success fs-5">₦@((int)h.TotalAmount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HMO MARKET SHARE PIE CHART -->
  <!--- <div class="row g-5">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h3 class="fw-bold mb-0">HMO by Enrollees</h3>
                </div>
                <div class="card-body bg-light">
                    <canvas id="hmoPieChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>-->

    <!-- Footer -->
    <div class="text-center mt-5 py-5 bg-dark text-white rounded-4">
        <p class="display-6 fw-bold mb-3">North East Development Commission.</p>
        <p class="lead mb-0">CTSHIP — Powering Health Insurance for Millions of Nigerians</p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <script>
        const ctx = document.getElementById('hmoPieChart').getContext('2d');
        const data = @Html.Raw(Json.Serialize(ViewBag.TopHmosEnrollees));

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: data.map(h => h.Name),
                datasets: [{
                    data: data.map(h => h.Count),
                    backgroundColor: [
                        '#006400','#228B22','#32CD32','#3CB371','#20B2AA',
                        '#4682B4','#6495ED','#1E90FF','#00BFFF','#87CEEB'
                    ],
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'right' },
                    datalabels: {
                        color: '#fff',
                        font: { weight: 'bold', size: 14 },
                        formatter: (value, ctx) => {
                            const total = ctx.dataset.data.reduce((a,b) => a + b, 0);
                            const percentage = ((value / total) * 100).toFixed(1);
                            return `${ctx.chart.data.labels[ctx.dataIndex]}\n${percentage}%`;
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    </script>
}