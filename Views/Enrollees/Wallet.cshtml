@model CTSHIPDashboard.Models.Enrollee
@{
    ViewData["Title"] = "Enrollee Wallet";
    var wallet = ViewBag.Wallet as CTSHIPDashboard.Models.EnrolleeWallet;
    var transactions = ViewBag.Transactions as List<CTSHIPDashboard.Models.WalletTransaction> ?? new List<CTSHIPDashboard.Models.WalletTransaction>();
}

<div class="container-fluid py-4">
    <div class="card mx-auto" style="max-width:1000px;">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Wallet — @Model.FullName</h4>
                <small class="opacity-75">Enrollment: @Model.EnrollmentNumber</small>
            </div>
            <div class="text-end">
                <h5 class="mb-0">Balance: @((wallet?.Balance ?? 0m).ToString("N2"))</h5>
                <small class="opacity-75">Monthly: @((wallet?.MonthlyAllocation ?? 0m).ToString("N2"))</small>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Transaction History</h5>
                @if (User.IsInRole("CTSHIPAdmin") || User.IsInRole("HMO"))
                {
                    <a class="btn btn-sm btn-primary" data-bs-toggle="collapse" href="#disburseForm" role="button" aria-expanded="false" aria-controls="disburseForm">Disburse</a>
                }
            </div>

            <div class="collapse mb-4" id="disburseForm">
                <div class="card card-body">
                    <form asp-action="DisburseToEnrollee" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Amount (NGN)</label>
                                <input type="number" step="0.01" name="amount" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Note / Reference</label>
                                <input type="text" name="note" class="form-control" placeholder="e.g. Monthly top-up, Correction" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-success w-100">Send</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <h5>Transaction History</h5>
            @if (!transactions.Any())
            {
                <div class="alert alert-info">No transactions found for this enrollee.</div>
            }
            else
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount (NGN)</th>
                            <th>Reference</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transactions)
                        {
                            <tr>
                                <td>@t.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@t.Type</td>
                                <td class="@(t.Amount < 0 ? "text-danger" : "text-success")">@t.Amount.ToString("N2")</td>
                                <td>@t.Reference</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="card-footer text-end">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>