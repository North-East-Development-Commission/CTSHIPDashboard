@{
    ViewData["Title"] = "Bulk Enrollee Upload";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="bg-success text-white text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">BULK ENROLLEE UPLOAD</h1>
                    <p class="lead mb-0 opacity-90">Upload thousands of enrollees instantly</p>
                </div>

                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                            @if (TempData["ErrorDetails"] != null)
                            {
                                <details class="mt-3">
                                    <summary class="text-decoration-underline">Show details</summary>
                                    <div class="bg-light p-3 rounded mt-2 small">
                                        @Html.Raw(TempData["ErrorDetails"])
                                    </div>
                                </details>
                            }
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="BulkUpload" method="post" enctype="multipart/form-data">
                        <div class="row g-4">
                            <div class="col-md-8">
                                <label class="form-label text-success fw-bold fs-5">Excel File (.xlsx) <span class="text-danger">*</span></label>
                                <input type="file" name="excelFile" accept=".xlsx" class="form-control form-control-lg" required />
                                <small class="text-muted">
                                    Required columns: FullName, Gender (M/F), DateOfBirth (dd/mm/yyyy), Phone, NIN, State, LGA, Ward, Address
                                </small>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-success fw-bold fs-5">Assign to HMO <span class="text-danger">*</span></label>
                                <select name="hmoId" class="form-select form-select-lg" asp-items="ViewBag.Hmos" required>
                                    <option value="">Select HMO</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-success fw-bold fs-5">Assign to Provider <span class="text-danger">*</span></label>
                                <select name="providersId" class="form-select form-select-lg" asp-items="ViewBag.Pros" required>
                                    <option value="">Select Provider</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-5 border-success opacity-75" />

                        <div class="text-center">
                            <button type="submit" class="btn btn-success btn-lg px-6 shadow-lg fw-bold fs-4">
                                UPLOAD ENROLLEES
                            </button>
                            @if (User.IsInRole("HMO"))
                            {
                                <a asp-controller="Hmo" asp-action="EnrolleeDashboard" class="btn btn-secondary btn-lg px-6 ms-3">
                                    Cancel
                                </a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Index" class="btn btn-secondary btn-lg px-6 ms-3">
                                    Cancel
                                </a>
                            }
                        </div>
                    </form>

                    <div class="mt-5 text-center">
                        <a href="../Templates/enrollee-upload-template.xlsx" class="btn btn-outline-success btn-lg">
                            Download Excel Template
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>