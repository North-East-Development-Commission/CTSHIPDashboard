@using CTSHIPDashboard.Helpers
@{
    ViewData["Title"] = "Bulk Enrollee Upload";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="bg-success text-white text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">BULK ENROLLEE UPLOAD</h1>
                    <p class="lead mb-0">Upload validated enrollee records using the official Excel template.</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4">
                            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                            @if (TempData["ErrorDetails"] != null)
                            {
                                <details class="mt-3">
                                    <summary class="text-decoration-underline">Show row errors</summary>
                                    <div class="bg-white text-danger p-3 rounded mt-2 small">
                                        @Html.Raw(TempData["ErrorDetails"])
                                    </div>
                                </details>
                            }
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="BulkUpload" method="post" enctype="multipart/form-data">
                        <div class="row g-4">
                            <div class="col-lg-6">
                                <label class="form-label text-success fw-bold fs-5">
                                    Excel File (.xlsx) <span class="text-danger">*</span>
                                </label>
                                <input type="file" name="excelFile" accept=".xlsx"
                                       class="form-control form-control-lg" required />
                                <small class="text-muted">
                                    Use the downloadable template. Header order may vary, but every required header must be present.
                                </small>
                            </div>

                            <div class="col-lg-3">
                                <label class="form-label text-success fw-bold fs-5">
                                    Assign to HMO <span class="text-danger">*</span>
                                </label>
                                <select name="hmoId" class="form-select form-select-lg"
                                        asp-items="ViewBag.Hmos" required>
                                    <option value="">Select HMO</option>
                                </select>
                            </div>

                            <div class="col-lg-3">
                                <label class="form-label text-success fw-bold fs-5">
                                    Assign to Provider <span class="text-danger">*</span>
                                </label>
                                <select name="providerId" class="form-select form-select-lg"
                                        asp-items="ViewBag.Pros" required>
                                    <option value="">Select Provider</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-3 mt-5">
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow fw-bold">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i>Upload Enrollees
                            </button>
                            @if (User.IsInRole("HMO"))
                            {
                                <a asp-controller="Hmo" asp-action="EnrolleeDashboard"
                                   class="btn btn-outline-success btn-lg px-5">Cancel</a>
                            }
                            else
                            {
                                <a asp-action="Index" class="btn btn-outline-success btn-lg px-5">Cancel</a>
                            }
                        </div>
                    </form>

                    <hr class="my-5 border-success opacity-50" />

                    <div class="card border-success shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0">Upload Guide — Required Excel Columns</h4>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Column Header</th>
                                        <th>Description</th>
                                        <th>Example</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int index = 0; index < BulkEnrolleeUploadSchema.Columns.Count; index++)
                                    {
                                        BulkEnrolleeColumn column = BulkEnrolleeUploadSchema.Columns[index];
                                        <tr>
                                            <td>@(index + 1)</td>
                                            <td><code>@column.Header</code></td>
                                            <td>@column.Description</td>
                                            <td>@column.Example</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="alert alert-warning text-white mt-3">
                        <strong>Important:</strong> Select the HMO and Provider on this page.
                        Do not add HMO or Provider columns to the workbook. Replace or delete the example row before upload.
                    </div>

                    <div class="text-center mt-4">
                        <a asp-action="DownloadBulkUploadTemplate" class="btn btn-outline-success btn-lg">
                            <i class="bi bi-file-earmark-excel me-2"></i>Download Required Excel Template
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
