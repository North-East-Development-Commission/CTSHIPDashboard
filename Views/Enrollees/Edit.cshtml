@model CTSHIPDashboard.Models.Enrollee

@{
    ViewData["Title"] = "Edit Enrollee - " + Model.EnrollmentNumber;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-11">
            <div class="card shadow-lg ct-enrollee-editor">
                <div class="ct-enrollee-editor__header py-4 px-4 px-md-5 text-center">
                    <h2 class="mb-2 fw-bold text-white">Edit Enrollee Profile</h2>
                    <p class="mb-0 text-white">
                        Enrollment Number:
                        <span class="badge bg-white text-success fs-5 px-3 py-2">@Model.EnrollmentNumber</span>
                    </p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-warning mb-4"></div>

                        <partial name="_EnrolleeEditForm" model="Model" />

                        <div class="d-flex flex-wrap justify-content-center gap-3 mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow fw-bold">
                                Update Enrollee
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-5 shadow">
                                View Details
                            </a>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-5 shadow">
                                Back to List
                            </a>
                        </div>
                    </form>
                </div>

                <div class="ct-enrollee-editor__footer text-center py-3">
                    <small>North East Development Commission (NEDC) &bull; CTSHIP Enrollment System</small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = event => document.getElementById('photoPreview').src = event.target.result;
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
