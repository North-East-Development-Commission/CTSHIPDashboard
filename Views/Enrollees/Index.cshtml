@model List<CTSHIPDashboard.Models.ViewModels.EnrolleeListViewModel>


@{
    bool canEditEnrollees = User.IsInRole("CTSHIPAdmin") || User.IsInRole("HMO") || User.IsInRole("HmoEnrollmentOfficer");
    bool canDeleteEnrollees = User.IsInRole("CTSHIPAdmin") || User.IsInRole("HMO");
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    var filters = new Dictionary<string, string>
    {
        ["search"] = ViewBag.Search ?? "",
        ["status"] = ViewBag.Status ?? "",
        ["state"] = ViewBag.State ?? "",
        ["hmo"] = ViewBag.Hmo ?? "",
        ["facility"] = ViewBag.Facility ?? "",
    };
    bool canSelectEnrollees = canDeleteEnrollees && Model.Count > 0;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="text-success fw-bold display-6">Enrollee Directory</h2>
        @if (canEditEnrollees)
        {
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <a asp-action="Create" class="btn btn-success btn-lg shadow">
                    <i class="bi bi-person-plus-fill me-1"></i> Register New Enrollee
                </a>
                <a asp-action="BulkUpload" class="btn btn-outline-success btn-lg shadow-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i> Bulk Upload
                </a>
            </div>
        }
    </div>

    <!-- Search & Filter -->
    <form asp-action="Index" method="get" class="row g-3 mb-4"
          id="enrollee-filters" data-facilities-url="@Url.Action("DirectoryFacilities")">
        <div class="col-lg-2">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control form-control-lg" placeholder="Search name, phone, NIN, enrollment..." />
        </div>
        <div class="col-lg-2">
            <select name="status" class="form-select form-select-lg" asp-items="ViewBag.StatusList">
                <option value="">All Status</option>
            </select>
        </div>
        <div class="col-lg-2">
            <select name="state" class="form-select form-select-lg" asp-items="ViewBag.StateList" aria-label="State">
                <option value="">All States</option>
            </select>
        </div>
        <div class="col-lg-2">
            <select name="hmo" class="form-select form-select-lg" asp-items="ViewBag.HmoList" aria-label="HMO">
                <option value="">All HMOs</option>
            </select>
        </div>
        <div class="col-lg-2">
            <select name="facility" class="form-select form-select-lg" asp-items="ViewBag.FacilityList"
                    aria-label="Facility" aria-describedby="facility-filter-status">
                <option value="">All Facilities</option>
            </select>
            <div id="facility-filter-status" class="form-text" role="status"></div>
        </div>
        <div class="col-lg-2">
            <button type="submit" class="btn btn-success btn-lg w-100">
                Filter
            </button>
        </div>
    </form>

    <!-- Stats -->
    <div class="alert alert-success text-center fw-bold fs-5 mb-4">
        Total Enrollees: @ViewBag.TotalRecords
        @if (totalPages > 0)
        {
            <span> | Showing page @currentPage of @totalPages</span>
        }
    </div>

    @if (canSelectEnrollees)
    {
        <form id="delete-selected-enrollees" asp-action="DeleteSelected" method="post" class="mb-3">
            @foreach (var filter in filters)
            {
                <input type="hidden" name="@filter.Key" value="@filter.Value" />
            }
            <input type="hidden" name="page" value="@currentPage" />
            <button type="submit" class="btn btn-outline-danger" disabled>Delete selected</button>
        </form>
    }

    <!-- Table -->
    <div class="card shadow-lg border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-4">
                <thead class="bg-success text-white">
                    <tr>
                        @if (canSelectEnrollees)
                        {
                            <th scope="col">
                                <input type="checkbox" class="form-check-input" id="select-page-enrollees"
                                       aria-label="Select all enrollees on this page" />
                            </th>
                        }
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Enrollment ID</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>State</th>
                        <th>NIN</th>
                        <th>HMO</th>
                        <th>Status</th>
                        <th>Registered</th>
                        <th>Death Register</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">No enrollees found</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            @if (canSelectEnrollees)
                            {
                                <td>
                                    <input type="checkbox" class="form-check-input" form="delete-selected-enrollees"
                                           name="ids" value="@e.Id" aria-label="Select @e.FullName (@e.EnrollmentNumber)" />
                                </td>
                            }
                            <td>
                                <img src="@EnrolleePhotoStorage.ResolvePhotoPath(e.PhotoPath, e.EnrollmentNumber)"
                                     class="rounded-circle" style="width:50px;height:50px;object-fit:cover;" />
                            </td>
                            <td><strong>@e.FullName</strong></td>
                            <td><span class="badge bg-primary fs-6">@e.EnrollmentNumber</span></td>
                            <td>@e.Gender</td>
                            <td>@e.Phone</td>
                            <td>@e.State</td>
                            <td>@e.NIN</td>
                            <td><strong>@e.HmoName</strong></td>
                            <td>
                                <span class="badge @(e.Status == "Active" ? "bg-success" : "bg-danger")">
                                    @e.Status
                                </span>
                            </td>
                            <td>@e.DateRegistered.ToString("MMM dd, yyyy")</td>                          
                            <td> 
                                @await Html.PartialAsync("_EnrolleeDeathStatusBadge", e.DeathStatus)
                            </td>

                            <td>
                                <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-info btn-sm">View</a>
                                @if (canEditEnrollees)
                                {
                                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-warning btn-sm">Edit</a>
                                }
                                @if (canDeleteEnrollees)
                                {
                                    <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-danger btn-sm">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
        </div>

        @await Html.PartialAsync("_EnrolleePagination", (currentPage, totalPages, "Index", filters))
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/enrollee-facility-filter.js" asp-append-version="true"></script>
    @if (canSelectEnrollees)
    {
        <script type="module" src="~/js/enrollee-selection.js" asp-append-version="true"></script>
    }
}
