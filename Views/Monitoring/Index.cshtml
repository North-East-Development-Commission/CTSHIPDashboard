@model CTSHIPDashboard.Models.ViewModels.MonitoringDashboardViewModel

@{
    ViewData["Title"] = ViewBag.DashboardTitle as string ?? "Monitoring & Evaluation";
}

<style>
    .monitoring-filter,
    .monitoring-filter option {
        color: #244a2a !important;
        background-color: #fff !important;
        font-weight: 500;
    }

    .monitoring-filter:focus {
        border-color: #FE9031;
        box-shadow: 0 0 0 .2rem rgba(254, 144, 49, .25);
    }
</style>

<div class="ct-page">
<div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1 class="mb-1">@(ViewBag.DashboardHeading as string ?? "Monitoring & Evaluation Dashboard")</h1>
        <p class="mb-0">@Model.ScopeDisplay programme statistics.</p>
    </div>

    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small mb-1" for="monitoringState">State</label>
            @if (User.IsInRole("StateOffice") || User.IsInRole("SSHIA"))
            {
                <input type="hidden" name="state" value="@Model.SelectedState" />
                <select id="monitoringState" class="form-select monitoring-filter" aria-label="Assigned state" disabled>
                    <option value="@Model.SelectedState" selected>@Model.SelectedState</option>
                </select>
            }
            else
            {
                <select name="state" id="monitoringState" class="form-select monitoring-filter" aria-label="Filter monitoring dashboard by state">
                    <option value="">All States</option>
                    @foreach (string state in Model.AvailableStates)
                    {
                        if (state == Model.SelectedState)
                        {
                            <option value="@state" selected>@state</option>
                        }
                        else
                        {
                            <option value="@state">@state</option>
                        }
                    }
                </select>
            }
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1" for="monitoringLga">LGA</label>
            <select name="lga" id="monitoringLga" class="form-select monitoring-filter"
                    aria-label="Filter monitoring dashboard by LGA"
                    disabled="@string.IsNullOrWhiteSpace(Model.SelectedState)">
                <option value="">All LGAs</option>
                @foreach (string lga in Model.AvailableLgas)
                {
                    if (lga == Model.SelectedLga)
                    {
                        <option value="@lga" selected>@lga</option>
                    }
                    else
                    {
                        <option value="@lga">@lga</option>
                    }
                }
            </select>
        </div>
        @if (ViewBag.AvailableHmos is List<CTSHIPDashboard.Models.Hmo> availableHmos)
        {
            <div class="col-auto">
                <label for="monitoringHmo" class="form-label small mb-1">HMO</label>
                <select name="hmoId" id="monitoringHmo" class="form-select monitoring-filter">
                    <option value="">All HMOs</option>
                    @foreach (var hmo in availableHmos)
                    {
                        <option value="@hmo.Id" selected="@(Model.SelectedHmoId == hmo.Id)">@hmo.Name</option>
                    }
                </select>
            </div>
        }
        <div class="col-auto d-grid">
            <button class="btn btn-outline-success">View</button>
        </div>
        <div class="col-auto d-grid">
            <a asp-action="@(ViewContext.RouteData.Values["action"]?.ToString())" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (User.IsInRole("CTSHIPAdmin") || User.IsInRole("NHIA") || User.IsInRole("StateOffice") || User.IsInRole("Monitoring"))
{
    <div class="card mb-4">
        <div class="card-body">
            <form asp-controller="Monitoring" asp-action="SetTarget" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Scope" value="@Model.Scope" />
                <input type="hidden" name="Lga" value="@Model.SelectedLga" />
                <div class="col-md-4">
                    <label class="form-label">@(Model.Scope == "CTSHIP" ? "CTSHIP Target Enrollees" : $"{Model.Scope} Target Enrollees")</label>
                    <input type="number" min="1" name="TargetEnrollees" value="@(Model.TargetEnrollees > 0 ? Model.TargetEnrollees : null)"
                           class="form-control" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-success">Save Target</button>
                </div>
                @if (Model.TargetEnrollees == 0)
                {
                    <div class="col-md-6">
                        <div class="alert alert-warning mb-0">Set a target to calculate coverage accurately.</div>
                    </div>
                }
            </form>
        </div>
    </div>
}

<partial name="_MonitoringIndicatorCards" model="Model" />
@if (User.IsInRole("HMO") && ViewBag.DashboardProviders is List<CTSHIPDashboard.Models.Provider> dashboardProviders)
{
    <section class="mb-4" aria-labelledby="hmoProvidersHeading">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 id="hmoProvidersHeading" class="h4 mb-0">Your Providers</h2>
            <a asp-controller="Hmo" asp-action="MyProviders" class="btn btn-outline-success">
                View all providers <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="hmoProviderPreview">
                <thead><tr><th scope="col">Facility</th><th scope="col">State</th><th scope="col">LGA</th><th scope="col">Level</th><th scope="col">Status</th></tr></thead>
                <tbody>
                    @foreach (var facility in dashboardProviders)
                    {
                        <tr>
                            <td><a asp-controller="Hmo" asp-action="ProDetails" asp-route-id="@facility.Id">@facility.Name</a></td>
                            <td>@facility.State</td><td>@facility.LGA</td><td>@facility.Level</td>
                            <td><span class="badge @(facility.IsActive ? "bg-success" : "bg-light text-dark")">@(facility.IsActive ? "Active" : "Inactive")</span></td>
                        </tr>
                    }
                    @if (dashboardProviders.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted py-4">No providers match the selected filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
<partial name="_ExtendedMonitoringIndicators" model="Model" />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 fw-bold mb-0">Complaint Management Metrics</h2>
    <a asp-controller="Complaints" asp-action="Index" class="btn btn-success">
        <i class="bi bi-chat-square-text-fill me-1"></i> Manage Complaints
    </a>
</div>
<partial name="_ComplaintMetrics" model="Model.ComplaintMetrics" />

<h2 class="h4 fw-bold mb-3">Operational and Financial Monitoring</h2>
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-warning"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-hospital-user ct-kpi-icon" aria-hidden="true"></i>Number of Referrals</div>
            <div class="display-6 fw-bold" style="color:#8a6819;">@Model.TotalReferrals.ToString("N0")</div>
            <small>All recorded referrals</small>
        </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-success"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-circle-check ct-kpi-icon" aria-hidden="true"></i>Completed Referrals</div>
            <div class="display-6 fw-bold text-success">@Model.CompletedReferrals.ToString("N0")</div>
            <small>Audited or closed</small>
        </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-warning"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-hourglass-half ct-kpi-icon" aria-hidden="true"></i>Pending Referrals</div>
            <div class="display-6 fw-bold text-warning-emphasis">@Model.PendingReferrals.ToString("N0")</div>
            <small>Awaiting completion</small>
        </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-success"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-chart-line ct-kpi-icon" aria-hidden="true"></i>Referral Completion Rate</div>
            <div class="display-6 fw-bold text-success">@Model.ReferralCompletionRate%</div>
            <small>@Model.RejectedReferrals.ToString("N0") rejected</small>
        </div></div>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi h-100"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-hospital ct-kpi-icon" aria-hidden="true"></i>Accredited Providers</div>
            <div class="display-6 fw-bold">@Model.TotalProviders.ToString("N0")</div>
            <small>@Model.TotalHmos.ToString("N0") HMO(s) serving this scope</small>
        </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi h-100"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-stethoscope ct-kpi-icon" aria-hidden="true"></i>Total Encounters</div>
            <div class="display-6 fw-bold">@Model.TotalEncounters.ToString("N0")</div>
            <small>@Model.EncounterRatePerThousand per 1,000 active enrollees</small>
        </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi h-100"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-file-invoice ct-kpi-icon" aria-hidden="true"></i>Total Claims</div>
            <div class="display-6 fw-bold">@Model.TotalClaims.ToString("N0")</div>
            <small>@Model.ClaimApprovalRate% paid-claim rate</small>
        </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi h-100"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-clipboard-check ct-kpi-icon" aria-hidden="true"></i>Audited Deaths</div>
            <div class="display-6 fw-bold">@Model.AuditedDeaths.ToString("N0")</div>
            <small>@Model.DeathRatePerThousand per 1,000 active enrollees</small>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-success"><div class="card-body">
            <div class="text-muted"><i class="fa-solid fa-money-bill-wave ct-kpi-icon" aria-hidden="true"></i>Total Claim Value</div>
            <div class="h3 fw-bold text-success">₦@Model.TotalClaimValue.ToString("N2")</div>
            <small>Paid: ₦@Model.PaidClaimValue.ToString("N2")</small>
        </div></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold">Claims Status</div>
            <div class="card-body"><canvas id="claimsStatusChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold">Enrolment by State</div>
            <div class="card-body"><canvas id="stateEnrolmentChart"></canvas></div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">State Monitoring Scorecard</div>
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0 ct-wide-table">
            <thead>
                <tr>
                    <th>State</th>
                    <th>Enrollees</th>
                    <th>Active</th>
                    <th>Providers</th>
                    <th>Encounters</th>
                    <th>Claims</th>
                    <th>Complaints</th>
                    <th>Open Complaints</th>
                    <th>Paid</th>
                    <th>Claim Value</th>
                    <th>Referrals</th>
                    <th>Completed</th>
                    <th>Completion Rate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var state in Model.StateIndicators)
                {
                    <tr>
                        <td class="fw-bold">@state.State</td>
                        <td>@state.TotalEnrollees.ToString("N0")</td>
                        <td>@state.ActiveEnrollees.ToString("N0")</td>
                        <td>@state.Providers.ToString("N0")</td>
                        <td>@state.Encounters.ToString("N0")</td>
                        <td>@state.Claims.ToString("N0")</td>
                        <td>@state.Complaints.ToString("N0")</td>
                        <td>@state.OpenComplaints.ToString("N0")</td>
                        <td>@state.PaidClaims.ToString("N0")</td>
                        <td>₦@state.ClaimValue.ToString("N0")</td>
                        <td>@state.Referrals.ToString("N0")</td>
                        <td>@state.CompletedReferrals.ToString("N0")</td>
                        <td>@state.ReferralCompletionRate%</td>
                    </tr>
                }
                @if (!Model.StateIndicators.Any())
                {
                    <tr><td colspan="15" class="text-center text-muted py-4">No state data available.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold">Gender Distribution</div>
            <div class="card-body"><canvas id="genderChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold">Vulnerable Groups — Share of Total Enrolled</div>
            <div class="card-body"><canvas id="vulnerableChart"></canvas></div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">Vulnerable Group Indicators</div>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
                <tr><th>Indicator</th><th>Count</th><th>% of Total Enrolled</th></tr>
            </thead>
            <tbody>
                <tr><td>Pregnant Women</td><td>@Model.PregnantWomenCount</td><td>@Model.PregnantWomenPercentage%</td></tr>
                <tr><td>Children Under 5</td><td>@Model.UnderFiveCount</td><td>@Model.UnderFivePercentage%</td></tr>
                <tr><td>PLWD</td><td>@Model.PlwdCount</td><td>@Model.PlwdPercentage%</td></tr>
                <tr><td>Elderly (60+)</td><td>@Model.ElderlyCount</td><td>@Model.ElderlyPercentage%</td></tr>
                <tr><td>Other Categories / IDPs</td><td>@Model.OtherVulnerableCount</td><td>@Model.OtherVulnerablePercentage%</td></tr>
                <tr class="table-success fw-bold">
                    <td>Unique Vulnerable Enrollees</td>
                    <td>@Model.VulnerableEnrolleeCount</td>
                    <td>@Model.VulnerablePopulationPercentage%</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <span class="fw-bold">Exclusive Vulnerable Group Distribution Check</span>
        <span class="badge @(Math.Abs(Model.VulnerableDistributionTotal - 100) <= 0.5m ? "bg-success" : "bg-warning text-dark")">
            Total: @Model.VulnerableDistributionTotal%
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted">Each vulnerable enrollee is counted once using age-first classification, preventing overlap.</p>
        @foreach (var category in Model.VulnerableDistribution)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <span>@category.Label (@category.Count)</span><span>@category.Percentage%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar bg-success" style="width: @category.Percentage%"></div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold">Preventive Service Delivery</div>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <tbody>
                        <tr><td>Immunization Encounters</td><td class="text-end">@Model.ImmunizationEncounters</td></tr>
                        <tr><td>ANC Encounters</td><td class="text-end">@Model.AncEncounters</td></tr>
                        <tr><td>Family Planning Encounters</td><td class="text-end">@Model.FamilyPlanningEncounters</td></tr>
                        <tr><td>Health Promotion Encounters</td><td class="text-end">@Model.HealthPromotionEncounters</td></tr>
                        <tr><td>Other Preventive Encounters</td><td class="text-end">@Model.OtherPreventiveEncounters</td></tr>
                        <tr class="table-success fw-bold">
                            <td>Total Preventive Encounters</td><td class="text-end">@Model.TotalPreventiveEncounters</td>
                        </tr>
                        <tr class="table-warning fw-bold">
                            <td>Preventive Care Rate per 1,000 Active Enrollees</td>
                            <td class="text-end">@Model.PreventiveCareRatePerThousand</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold">Most Frequently Used Services</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Service</th><th>Setting</th><th>Frequency</th><th>Share</th></tr></thead>
                    <tbody>
                        @foreach (var service in Model.MostUsedServices)
                        {
                            <tr>
                                <td>@service.ServiceName</td>
                                <td><span class="badge bg-secondary">@service.ServiceSetting</span></td>
                                <td>@service.Frequency</td>
                                <td>@service.PercentageOfRecordedServices%</td>
                            </tr>
                        }
                        @if (!Model.MostUsedServices.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">No structured service data recorded yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>

<partial name="_TopProvidersByEnrollees" model="Model" />

@section Scripts {
    <script>
        Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
        Chart.defaults.font.size = 12;
        Chart.defaults.color = '#45545d';
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.legend.labels.padding = 18;
        Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(34, 49, 55, .94)';
        Chart.defaults.plugins.tooltip.padding = 12;
        Chart.defaults.plugins.tooltip.cornerRadius = 6;
        Chart.defaults.animation.duration = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 350;
        const ctChartPalette = {
            green: '#285f39',
            greenSoft: '#6aa36f',
            gold: '#f2a72d',
            amber: '#c57a18',
            teal: '#247c75',
            blue: '#386fa4',
            rose: '#b94b5d',
            slate: '#667085'
        };
        (() => {
            const stateSelect = document.getElementById('monitoringState');
            const lgaSelect = document.getElementById('monitoringLga');
            const lgaUrl = '@Url.Action("Lgas", ViewBag.LgaController as string ?? "Monitoring")';

            const replaceLgas = (items) => {
                lgaSelect.innerHTML = '<option value="">All LGAs</option>';
                items.forEach(item => {
                    const option = document.createElement('option');
                    option.value = item;
                    option.textContent = item;
                    lgaSelect.appendChild(option);
                });
                lgaSelect.disabled = !stateSelect.value;
            };

            stateSelect?.addEventListener('change', async () => {
                if (!stateSelect.value) {
                    replaceLgas([]);
                    lgaSelect.disabled = true;
                    return;
                }

                lgaSelect.disabled = true;
                const response = await fetch(`${lgaUrl}?state=${encodeURIComponent(stateSelect.value)}`);
                if (!response.ok) {
                    replaceLgas([]);
                    return;
                }

                replaceLgas(await response.json());
            });
        })();

        new Chart(document.getElementById('genderChart'), {
            type: 'doughnut',
            data: {
                labels: ['Male', 'Female'],
                datasets: [{
                    data: [@Model.MaleCount, @Model.FemaleCount],
                    backgroundColor: [ctChartPalette.blue, ctChartPalette.green, ctChartPalette.slate],
                    borderColor: '#ffffff',
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            }
        });

        new Chart(document.getElementById('vulnerableChart'), {
            type: 'bar',
            data: {
                labels: ['Pregnant Women', 'Under 5', 'PLWD', 'Elderly', 'Other / IDP'],
                datasets: [{
                    label: '% of Total Enrolled',
                    data: [
                        @Html.Raw(Json.Serialize(Model.PregnantWomenPercentage)),
                        @Html.Raw(Json.Serialize(Model.UnderFivePercentage)),
                        @Html.Raw(Json.Serialize(Model.PlwdPercentage)),
                        @Html.Raw(Json.Serialize(Model.ElderlyPercentage)),
                        @Html.Raw(Json.Serialize(Model.OtherVulnerablePercentage))
                    ],
                    backgroundColor: [
                        ctChartPalette.rose,
                        ctChartPalette.gold,
                        ctChartPalette.teal,
                        ctChartPalette.green,
                        ctChartPalette.blue
                    ],
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: { scales: { y: { beginAtZero: true, max: 100 } } }
        });

        new Chart(document.getElementById('claimsStatusChart'), {
            type: 'doughnut',
            data: {
                labels: ['Paid', 'Pending', 'Rejected', 'Approved'],
                datasets: [{
                    data: [
                        @Model.PaidClaims,
                        @Model.PendingClaims,
                        @Model.RejectedClaims,
                        @Model.ApprovedClaims
                    ],
                    backgroundColor: [ctChartPalette.green, ctChartPalette.gold, ctChartPalette.rose, ctChartPalette.slate],
                    borderColor: '#ffffff',
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            }
        });

        const stateRows = @Html.Raw(Json.Serialize(Model.StateIndicators));
        new Chart(document.getElementById('stateEnrolmentChart'), {
            type: 'bar',
            data: {
                labels: stateRows.map(x => x.state),
                datasets: [
                    {
                        label: 'Total Enrollees',
                        data: stateRows.map(x => x.totalEnrollees),
                        backgroundColor: ctChartPalette.gold,
                        borderRadius: 6,
                        borderSkipped: false
                    },
                    {
                        label: 'Active Enrollees',
                        data: stateRows.map(x => x.activeEnrollees),
                        backgroundColor: ctChartPalette.green,
                        borderRadius: 6,
                        borderSkipped: false
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
