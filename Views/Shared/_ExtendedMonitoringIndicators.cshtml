@model CTSHIPDashboard.Models.ViewModels.MonitoringDashboardViewModel
@{ bool isNedcDashboard = ViewBag.IsNedcDashboard as bool? == true; }
<div class="row g-3 mb-4 text-center">
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-file-invoice ct-kpi-icon" aria-hidden="true"></i>Total Claims Submitted</div>
                <div class="h3 fw-bold text-primary">@Model.TotalClaims.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-money-bill-wave ct-kpi-icon" aria-hidden="true"></i>Amount Claimed</div>
                <div class="h3 fw-bold text-success">NGN @Model.TotalClaimValue.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-clipboard-check ct-kpi-icon" aria-hidden="true"></i>Claims Validated</div>
                <div class="h3 fw-bold text-success">@Model.ClaimsValidated.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-file-circle-xmark ct-kpi-icon" aria-hidden="true"></i>Claims Rejected</div>
                <div class="h3 fw-bold text-danger">@Model.RejectedClaims.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-file-circle-check ct-kpi-icon" aria-hidden="true"></i>Amount Approved</div>
                <div class="h3 fw-bold text-info">NGN @Model.ApprovedClaimValue.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-wallet ct-kpi-icon" aria-hidden="true"></i>Amount Paid</div>
                <div class="h3 fw-bold text-success">NGN @Model.PaidClaimValue.ToString("N0")</div>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-hourglass-half ct-kpi-icon" aria-hidden="true"></i>Outstanding Claims</div>
                <div class="h3 fw-bold text-warning">@Model.OutstandingClaims.ToString("N0")</div>
                <small class="text-muted">NGN @Model.OutstandingClaimValue.ToString("N0") outstanding</small>
            </div></div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-clock ct-kpi-icon" aria-hidden="true"></i>Average Processing Time</div>
                <div class="h3 fw-bold text-dark">@Model.AverageProcessingDays.ToString("N1") days</div>
            </div></div>
        </div>
    </div>
    <partial name="_EncounterDemographicMatrix" model="Model.EncounterDemographicMatrix" />

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6"><div class="card bg-success text-white h-100"><div class="card-body"><div><i class="fa-solid fa-heart-pulse ct-kpi-icon" aria-hidden="true"></i>Service Utilization</div><div class="display-6 fw-bold">@Model.ServiceUtilizationRate%</div><small>@Model.UniqueServiceUsers.ToString("N0") unique users</small></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card bg-primary text-white h-100"><div class="card-body"><div>@(isNedcDashboard ? "IHSA Reports Awaiting HQ Audit" : "Reports Pending Audit")</div><div class="display-6 fw-bold">@((isNedcDashboard ? (int)ViewBag.NedcPendingReports : Model.PendingReports).ToString("N0"))</div><small>@(isNedcDashboard ? $"{((int)ViewBag.NedcCompletedReports):N0} HQ decisions recorded" : $"{Model.AuditedReports:N0} audited")</small></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card bg-success text-white h-100"><div class="card-body"><div><i class="fa-solid fa-money-check-dollar ct-kpi-icon" aria-hidden="true"></i>Capitation Paid</div><div class="h3 fw-bold">NGN @Model.Capitation.PaidAmount.ToString("N2")</div><small>@Model.Capitation.PaidPayments of @Model.Capitation.TotalPayments payments</small></div></div></div>
        <div class="col-xl-3 col-md-6"><div class="card bg-primary text-white h-100"><div class="card-body"><div><i class="fa-solid fa-users-gear ct-kpi-icon" aria-hidden="true"></i>Active Users</div><div class="display-6 fw-bold">@Model.ActiveUsersLast30Days.ToString("N0")</div><small>Last 30 days</small></div></div></div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">System Activity Matrix</div>
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 ct-wide-table">
                <thead><tr><th>Area</th><th>Indicator</th><th>Count</th><th>Rate</th><th>Decision Signal</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.SystemActivityMatrix)
                    {
                        <tr><td class="fw-bold">@row.Area</td><td>@row.Indicator</td><td>@row.Count.ToString("N0")</td><td>@row.Rate%</td><td>@row.DecisionSignal</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">HMO Oversight</div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>HMO</th><th>Enrollees</th><th>Providers</th><th>Encounters</th><th>Complaints</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var hmo in Model.HmoOversight.Take(10))
                        {
                            <tr>
                                <td class="fw-bold">@hmo.Name</td><td>@hmo.Enrollees.ToString("N0")</td><td>@hmo.Providers.ToString("N0")</td><td>@hmo.Encounters.ToString("N0")</td><td>@hmo.Complaints.ToString("N0")</td>
                                <td>
                                    @if (!User.IsInRole("HMO"))
                                    {
                                        <a asp-controller="Hmo" asp-action="Details" asp-route-id="@hmo.Id" class="btn btn-sm btn-outline-success">View</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">Provider Level Metrics</div>
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead><tr><th>Level</th><th>Providers</th><th>Enrollees</th><th>Encounters</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.ProviderLevelMetrics)
                        {
                            <tr><td class="fw-bold">@item.Level</td><td>@item.Providers.ToString("N0")</td><td>@item.Enrollees.ToString("N0")</td><td>@item.Encounters.ToString("N0")</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">Disease Trends From Encounters</div>
                <div class="table-responsive">
                    <table class="table table-striped mb-0"><thead><tr><th>Diagnosis</th><th>Encounters</th><th>Share</th></tr></thead><tbody>
                    @foreach (var trend in Model.DiseaseTrends)
                    {
                        <tr><td class="fw-bold">@trend.Diagnosis</td><td>@trend.Encounters.ToString("N0")</td><td>@trend.Percentage%</td></tr>
                    }
                    </tbody></table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">State Scorecard</div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>State</th>
                                <th>Active</th>
                                <th>Claims</th>
                                <th>Validated</th>
                                <th>Rejected</th>
                                <th>Paid</th>
                                <th>Outstanding</th>
                                <th>Avg Days</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var state in Model.StateIndicators)
                        {
                            <tr>
                                <td class="fw-bold">@state.State</td>
                                <td>@state.ActiveEnrollees.ToString("N0")</td>
                                <td>@state.Claims.ToString("N0")</td>
                                <td>@state.ClaimsValidated.ToString("N0")</td>
                                <td>@state.RejectedClaims.ToString("N0")</td>
                                <td>NGN @state.PaidClaimValue.ToString("N0")</td>
                                <td>@state.OutstandingClaims.ToString("N0") / NGN @state.OutstandingClaimValue.ToString("N0")</td>
                                <td>@state.AverageProcessingDays.ToString("N1")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
