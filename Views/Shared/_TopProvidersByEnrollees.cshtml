@model CTSHIPDashboard.Models.ViewModels.MonitoringDashboardViewModel

<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="h5 mb-1"><i class="fa-solid fa-ranking-star me-2" aria-hidden="true"></i>Top Providers by Enrollees</h2>
            <small class="text-muted">@Model.ScopeDisplay</small>
        </div>
        <span class="badge bg-success">Top 10 active providers</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0" aria-label="Top providers by enrollee count">
            <thead><tr><th scope="col">Rank</th><th scope="col">Facility</th><th scope="col">State</th><th scope="col">LGA</th><th scope="col" class="text-end">Enrollees</th></tr></thead>
            <tbody>
                @for (int index = 0; index < Model.TopProvidersByEnrollees.Count; index++)
                {
                    var provider = Model.TopProvidersByEnrollees[index];
                    <tr><td>@(index + 1)</td><th scope="row">@provider.Name</th><td>@provider.State</td><td>@provider.Lga</td><td class="text-end fw-semibold">@provider.Enrollees.ToString("N0")</td></tr>
                }
                @if (Model.TopProvidersByEnrollees.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No enrolled members at active providers in this scope.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
