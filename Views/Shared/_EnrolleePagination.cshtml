@model (int CurrentPage, int TotalPages, string Action, Dictionary<string, string> Filters)

@if (Model.TotalPages > 1)
{
    int first = Math.Max(1, Model.CurrentPage - 1);
    int last = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

    <nav class="px-2 py-3" aria-label="Enrollee pages">
        <ul class="pagination flex-wrap justify-content-center gap-1 mb-0">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link rounded" asp-action="@Model.Action" asp-all-route-data="@Model.Filters"
                       asp-route-page="@(Model.CurrentPage - 1)" rel="prev">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link rounded" aria-disabled="true">Previous</span></li>
            }

            @if (first > 1)
            {
                <li class="page-item">
                    <a class="page-link rounded" asp-action="@Model.Action" asp-all-route-data="@Model.Filters"
                       asp-route-page="1">1</a>
                </li>
                @if (first > 2)
                {
                    <li class="page-item disabled" aria-hidden="true"><span class="page-link rounded">…</span></li>
                }
            }

            @for (int pageNumber = first; pageNumber <= last; pageNumber++)
            {
                if (pageNumber == Model.CurrentPage)
                {
                    <li class="page-item active"><span class="page-link rounded" aria-current="page">@pageNumber</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link rounded" asp-action="@Model.Action" asp-all-route-data="@Model.Filters"
                           asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }
            }

            @if (last < Model.TotalPages)
            {
                @if (last < Model.TotalPages - 1)
                {
                    <li class="page-item disabled" aria-hidden="true"><span class="page-link rounded">…</span></li>
                }
                <li class="page-item">
                    <a class="page-link rounded" asp-action="@Model.Action" asp-all-route-data="@Model.Filters"
                       asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link rounded" asp-action="@Model.Action" asp-all-route-data="@Model.Filters"
                       asp-route-page="@(Model.CurrentPage + 1)" rel="next">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link rounded" aria-disabled="true">Next</span></li>
            }
        </ul>
    </nav>
}
