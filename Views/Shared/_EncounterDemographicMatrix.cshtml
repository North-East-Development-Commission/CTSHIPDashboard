@model CTSHIPDashboard.Models.ViewModels.EncounterDemographicMatrixViewModel

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fw-bold">Enrollee Encounter Demographic Matrix</div>
            <small class="text-muted">@Model.ScopeLabel</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-success">@Model.TotalEnrollees.ToString("N0") enrollees</span>
            <span class="badge bg-primary">@Model.UniqueEnrolleesWithEncounters.ToString("N0") used care</span>
            <span class="badge bg-secondary">@Model.TotalEncounters.ToString("N0") encounters</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle ct-wide-table">
            <thead class="table-light">
                <tr>
                    <th>Demographic</th>
                    <th>Enrollees</th>
                    <th>Care Users</th>
                    <th>Encounters</th>
                    <th>Enrollee Share</th>
                    <th>Encounter Share</th>
                    <th>Encounters / 1,000</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No demographic encounter data is available yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Category</td>
                            <td>@row.Enrollees.ToString("N0")</td>
                            <td>@row.EnrolleesWithEncounters.ToString("N0")</td>
                            <td class="fw-bold text-success">@row.Encounters.ToString("N0")</td>
                            <td>@row.EnrolleeShare.ToString("N1")%</td>
                            <td>@row.EncounterShare.ToString("N1")%</td>
                            <td>@row.EncountersPerThousandEnrollees.ToString("N1")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
