@using Microsoft.AspNetCore.Identity
@using CTSHIPDashboard.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject IWebHostEnvironment WebHostEnvironment

@{
    string homeUrl = Url.Content("~/");
    string userProfilePhotoPath = ProfilePhotoStorage.DefaultPhotoPath;
    ApplicationUser? signedInUser = null;
    bool providerCanUseClaimsNav = false;
    bool providerCanUseMonthlyReportsNav = false;
    bool providerCanUseReferralReportsNav = false;
    bool providerCanUseDrugInventoryNav = false;

    if (SignInManager.IsSignedIn(User))
    {
        signedInUser = await UserManager.GetUserAsync(User);
        if (signedInUser != null)
        {
            userProfilePhotoPath = ProfilePhotoStorage.ResolvePhotoPath(signedInUser.Id, WebHostEnvironment);
        }

        homeUrl = User.IsInRole("Admin")
            ? Url.Action("Index", "Analytics", new { area = "" }) ?? Url.Content("~/Analytics/Index")
            : User.IsInRole("Reviewer")
                ? Url.Action("Dashboard", "Claims", new { area = "" }) ?? Url.Content("~/Claims/Dashboard")
            : User.IsInRole("ReferralPro")
                ? Url.Action("Dashboard", "ReferralPro", new { area = "" }) ?? Url.Content("~/ReferralPro/Dashboard")
            : User.IsInRole("HmoEnrollmentOfficer")
                ? Url.Action("Dashboard", "Enrollees", new { area = "" }) ?? Url.Content("~/Enrollees/Dashboard")
            : User.IsInRole("HMO")
                ? Url.Action("Dashboard", "Hmo", new { area = "" }) ?? Url.Content("~/Hmo/Dashboard")
                : User.IsInRole("Provider")
                    ? Url.Action("Dashboard", "Providers", new { area = "" }) ?? Url.Content("~/Providers/Dashboard")
                    : User.IsInRole("Finance")
                        ? Url.Action("Dashboard", "Finance", new { area = "" }) ?? Url.Content("~/Finance/Dashboard")
                        : User.IsInRole("StateOffice")
                            ? Url.Action("Index", "StateOffice", new { area = "" }) ?? Url.Content("~/StateOffice/Index")
                            : User.IsInRole("NHIA")
                                ? Url.Action("Dashboard", "NHIA", new { area = "" }) ?? Url.Content("~/NHIA/Dashboard")
                                : User.IsInRole("SSHIA")
                                    ? Url.Action("Dashboard", "SSHIA", new { area = "" }) ?? Url.Content("~/SSHIA/Dashboard")
                                : User.IsInRole("IHSA") || User.IsInRole("NEDCAdmin")
                                    ? Url.Action("Dashboard", "IHSA", new { area = "" }) ?? Url.Content("~/IHSA/Dashboard")
                                : User.IsInRole("Monitoring")
                                    ? Url.Action("Index", "Monitoring", new { area = "" }) ?? Url.Content("~/Monitoring/Index")
                                    : Url.Action("Index", "Home", new { area = "" }) ?? Url.Content("~/Home/Index");

        if (User.IsInRole("Provider"))
        {
            if (signedInUser?.ProviderId.HasValue == true)
            {
                string? providerLevel = await DbContext.Providers
                    .AsNoTracking()
                    .Where(provider => provider.Id == signedInUser.ProviderId.Value)
                    .Select(provider => provider.Level)
                    .FirstOrDefaultAsync();

                providerCanUseClaimsNav = ProviderClaimAccessHelper.CanUseClaims(providerLevel);
                providerCanUseDrugInventoryNav = string.Equals(providerLevel, "Primary", StringComparison.OrdinalIgnoreCase);
                providerCanUseReferralReportsNav =
                    string.Equals(providerLevel, "Referral Hospital", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(providerLevel, "Referred Hospital", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(providerLevel, "Referral Provider", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(providerLevel, "Referred Provider", StringComparison.OrdinalIgnoreCase);
                providerCanUseMonthlyReportsNav = providerCanUseClaimsNav && !providerCanUseReferralReportsNav;
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NEDC CTSHIP Dashboard</title>

    <!-- Offline-ready UI libraries -->

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" />
    <link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="~/css/dashboard-theme.css" asp-append-version="true" />
    <!-- Optional: Make it feel like a real app (PWA) -->
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/img/icon-192.png">

    <style>
        .footer-brand {
            background: linear-gradient(135deg, var(--ct-green-dark), var(--ct-green));
            border-top: 4px solid var(--ct-gold);
            border-radius: 16px;
            padding: 3rem;
            color: white;
            text-align: center;
        }

        .select2-results__options {
            max-height: 200px !important;
            overflow-y: auto !important;
        }

        .sidebar.offcanvas {
            top: var(--ct-topbar-height);
            bottom: 0;
            height: auto;
            width: 280px;
            max-width: 88vw;
            background: linear-gradient(180deg, var(--ct-green) 0%, var(--ct-green-dark) 100%);
            color: white;
            border-right: 0;
            z-index: 1045;
        }

        .sidebar .offcanvas-body {
            overflow-y: auto;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: .25rem;
            color: rgba(255, 255, 255, .9);
            padding: 12px 20px;
            border-radius: 0;
            transition: background-color .2s ease, color .2s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: rgba(254, 144, 49, .25);
            border-left-color: var(--ct-gold);
            color: white;
        }

        .sidebar .nav-link i {
            width: 30px;
            flex: 0 0 30px;
            font-size: 1.3rem;
        }

        .ct-user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, .85);
            flex: 0 0 34px;
        }

        .ct-logout-divider {
            border-color: rgba(255, 255, 255, .35);
            opacity: 1;
        }


        .ct-notification-button {
            position: relative;
            display: inline-flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            color: #fff;
            border: 1px solid rgba(254, 144, 49, .65);
            border-radius: .7rem;
            background: rgba(0, 0, 0, .12);
        }

        .ct-notification-button:hover,
        .ct-notification-button:focus {
            color: #fff;
            background: rgba(254, 144, 49, .2);
            border-color: var(--ct-gold);
        }

        .ct-notification-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 20px;
            height: 20px;
            padding: 0 5px;
            color: var(--ct-button-on-gold);
            background: var(--ct-gold);
            border: 2px solid var(--ct-green-dark);
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 800;
            line-height: 16px;
            text-align: center;
        }

        .ct-notification-dropdown {
            width: min(380px, calc(100vw - 24px));
            max-height: min(540px, calc(100vh - 110px));
            overflow: hidden;
            border: 1px solid var(--ct-border);
            border-radius: .9rem;
        }

        .ct-notification-list {
            max-height: 360px;
            overflow-y: auto;
        }

        .ct-notification-item {
            white-space: normal;
        }

        .ct-page-loader {
            position: fixed;
            inset: 0;
            z-index: 3000;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            transition: opacity .25s ease, visibility .25s ease;
        }

        .ct-page-loader.is-hidden {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .ct-loader-card {
            display: flex;
            width: min(280px, calc(100vw - 48px));
            min-height: 220px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 0;
            color: var(--ct-green);
            text-align: center;
            background: transparent;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .ct-loader-logo {
            width: 112px;
            height: 112px;
            object-fit: contain;
            animation: ct-loader-pulse 1.15s ease-in-out infinite;
        }

        .ct-loader-text {
            color: var(--ct-green);
            font-weight: 800;
            line-height: 1.2;
        }

        .ct-loader-spinner {
            width: 2rem;
            height: 2rem;
            border: .25rem solid rgba(59, 112, 59, .18);
            border-top-color: var(--ct-gold);
            border-radius: 50%;
            animation: ct-loader-spin .8s linear infinite;
        }

        @@keyframes ct-loader-pulse {
            0%, 100% { transform: scale(1); opacity: .92; }
            50% { transform: scale(1.05); opacity: 1; }
        }

        @@keyframes ct-loader-spin {
            to { transform: rotate(360deg); }
        }
        @@media (max-width: 420px) {
            .sidebar.offcanvas {
                width: 260px;
            }
        }
    </style>
</head>
<body>
    <div id="ctPageLoader" class="ct-page-loader" role="status" aria-live="polite" aria-label="Loading page">
        <div class="ct-loader-card">
            <img class="ct-loader-logo" src="~/images/nedc-logo-transparent.png" alt="NEDC logo" />
            <div class="ct-loader-text">NEDC CTSHIP</div>
            <div class="ct-loader-spinner" aria-hidden="true"></div>
        </div>
    </div>
    <nav class="navbar navbar-dark fixed-top shadow-lg ct-topbar">
        <div class="container-fluid flex-nowrap gap-2">
            @if (SignInManager.IsSignedIn(User))
            {
                <button class="btn navbar-toggler ct-menu-button flex-shrink-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open navigation menu">
                    <i class="bi bi-list fs-3"></i>
                </button>
            }
            <a class="navbar-brand ct-navbar-brand me-auto" href="@homeUrl">
                <img class="ct-navbar-logo" src="~/images/nedc-logo-transparent.png" alt="North East Development Commission (NEDC) logo" />
                <span class="ct-brand-copy">
                    <span class="ct-brand-title">NORTH EAST DEVELOPMENT COMMISSION (NEDC)</span>
                    <span class="ct-brand-subtitle d-none d-md-block">COMMUNITY TARGETED SOCIAL HEALTH INSURANCE PROGRAM (CTSHIP)</span>
                    <span class="ct-brand-subtitle d-md-none">Community Targeted Social Health Insurance Program</span>
                </span>
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn ct-notification-button" type="button" id="ctNotificationDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Open notifications">
                            <i class="bi bi-bell-fill fs-5"></i>
                            <span id="ctNotificationBadge" class="ct-notification-badge d-none">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow ct-notification-dropdown" aria-labelledby="ctNotificationDropdown">
                            <div class="d-flex justify-content-between align-items-center gap-2 px-3 py-2 border-bottom">
                                <strong>Notifications</strong>
                                <button id="ctNotificationMarkAll" type="button" class="btn btn-sm btn-outline-success">Mark read</button>
                            </div>
                            <div id="ctNotificationList" class="ct-notification-list">
                                <div class="text-center text-muted py-4">Loading notifications...</div>
                            </div>
                            <div class="border-top p-2 text-center">
                                <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-success w-100">View all notifications</a>
                            </div>
                        </div>
                    </div>
                    <form id="ctNotificationTokenForm" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="ct-user-link d-flex" title="Open profile">
                        <img class="ct-user-avatar" src="@userProfilePhotoPath" alt="Profile photo" />
                        <span class="d-none d-sm-flex">
                            <small>Welcome</small>
                            <strong>@User.Identity?.Name</strong>
                        </span>
                    </a>
                </div>
            }
        </div>
    </nav>
    <!-- Sidebar -->
    @if (SignInManager.IsSignedIn(User))
    {
    <div class="sidebar offcanvas offcanvas-start text-white" id="sidebar" tabindex="-1" aria-labelledby="sidebarTitle">
        <div class="offcanvas-header border-bottom border-light border-opacity-25">
            <h5 class="offcanvas-title text-white fw-bold" id="sidebarTitle">NEDC CTSHIP PROGRAM</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close navigation menu"></button>
        </div>
        <div class="offcanvas-body p-0">
        <nav class="nav flex-column" aria-label="Main navigation">
            @if (User.IsInRole("NHIA"))
            {
                <a asp-controller="NHIA" asp-action="Dashboard" class="nav-link">
                    <i class="bi bi-speedometer2"></i> NHIA Dashboard
                </a>
                <a asp-controller="Enrollees" asp-action="Index" class="nav-link">
                    <i class="bi bi-people-fill"></i> Enrollment List
                </a>
                <a asp-controller="Claims" asp-action="Index" class="nav-link">
                    <i class="bi bi-file-medical-fill"></i> Claims With Details
                </a>
                <a asp-controller="Providers" asp-action="Index" class="nav-link">
                    <i class="bi bi-hospital-fill"></i> Providers With Details
                </a>
                <a asp-controller="Complaints" asp-action="Index" class="nav-link">
                    <i class="bi bi-chat-square-text-fill"></i> Complaint Oversight
                </a>
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
                <a asp-controller="HmoDeathRegisters" asp-action="Index" class="nav-link">
                    <i class="bi bi-clipboard2-pulse-fill"></i> Audit Death Records
                </a>
            }

            @if (User.IsInRole("HmoEnrollmentOfficer"))
            {
                    <a asp-controller="Enrollees" asp-action="Dashboard" class="nav-link text-white">
                        <i class="bi bi-speedometer2"></i> Enrollment Dashboard
                    </a>
                    <a asp-controller="Enrollees" asp-action="Create" class="nav-link text-white">
                        <i class="bi bi-person-plus-fill"></i> Create Enrollee
                    </a>
                    <a asp-controller="Enrollees" asp-action="BulkUpload" class="nav-link text-white">
                        <i class="bi bi-file-earmark-excel"></i> Bulk Enrolment with Excel
                    </a>
                    <a asp-controller="Enrollees" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> Enrollee Directory
                    </a>
            }

            @if (User.IsInRole("HMO"))
            {
                    <a asp-controller="Hmo" asp-action="Dashboard" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> Dashboard
                    </a>
                    <a asp-controller="Hmo" asp-action="EnrolleeDashboard" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> My Enrollees
                    </a>
                    <a asp-controller="Claims" asp-action="Dashboard" class="nav-link text-white">
                        <i class="bi bi-file-medical-fill"></i> My Claims
                    </a>
                    <a asp-controller="Hmo" asp-action="MyProviders" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> My Providers
                    </a>
                    <a asp-controller="Hmo" asp-action="Capitation" class="nav-link">
                        <i class="bi bi-cash-stack"></i> Capitation
                    </a>
                    <a asp-controller="StateOffice" asp-action="MonthlyReports" class="nav-link">
                        <i class="bi bi-clipboard-data"></i> Provider Reports
                    </a>
                    <a asp-controller="StateOffice" asp-action="ReferralProviderReports" class="nav-link">
                        <i class="bi bi-clipboard-pulse"></i> Referral Provider Reports
                    </a>
                    <a asp-controller="HmoReferrals" asp-action="Index" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Referrals
                    </a>
                    <a asp-controller="ReferralHospitals" asp-action="Index" class="nav-link">
                        <i class="bi bi-building-add"></i> Referral Hospitals
                    </a>
                    <a asp-controller="HmoDeathRegisters" asp-action="Index" class="nav-link">
                        <i class="bi bi-clipboard2-pulse-fill"></i> Verify Death Records
                    </a>
                    <a asp-controller="Enrollees" asp-action="BulkUpload" class="nav-link">
                        <i class="bi bi-person-plus-fill"></i> Bulk Enrolment with Excel
                    </a>
            }

            @if (User.IsInRole("Reviewer") && !User.IsInRole("HMO"))
            {
                    <a asp-controller="Claims" asp-action="Dashboard" class="nav-link text-white">
                        <i class="bi bi-file-medical-fill"></i> HMO Claims
                    </a>
            }

            @if (User.IsInRole("ReferralPro"))
            {
                    <a asp-controller="ReferralPro" asp-action="Dashboard" class="nav-link">
                        <i class="bi bi-speedometer2"></i> Referral Dashboard
                    </a>
                    <a href="@Url.Content("~/ReferralPro/Referrals")" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Received Referrals
                    </a>
                    <a asp-controller="ProviderDoctors" asp-action="Index" class="nav-link">
                        <i class="bi bi-person-badge-fill"></i> Staff Directory
                    </a>
                    <a asp-controller="StateOffice" asp-action="ReferralProviderReports" class="nav-link">
                        <i class="bi bi-clipboard-pulse"></i> Referral Provider Reports
                    </a>
            }
            @if (User.IsInRole("SSHIA"))
            {
                <a asp-controller="SSHIA" asp-action="Dashboard" class="nav-link">
                    <i class="bi bi-speedometer2"></i> SSHIA Dashboard
                </a>
                <a asp-controller="Enrollees" asp-action="Index" class="nav-link">
                    <i class="bi bi-people-fill"></i> State Enrollment List
                </a>
                <a asp-controller="Providers" asp-action="Index" class="nav-link">
                    <i class="bi bi-hospital-fill"></i> State Providers
                </a>
                <a asp-controller="Complaints" asp-action="Index" class="nav-link">
                    <i class="bi bi-chat-square-text-fill"></i> Complaint Oversight
                </a>
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
            }


           @if (User.IsInRole("Provider"))
           {
                    <a asp-controller="Providers" asp-action="Dashboard" class="nav-link">
                        <i class="bi bi-house-door-fill"></i> Providers Dashboard
                    </a>
                    <a asp-controller="Providers" asp-action="MyEncounters" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> Patients Encounters
                    </a>
                    <a asp-controller="Providers" asp-action="MyEnrollees" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> My Enrollees
                    </a>
                    <a asp-controller="ProviderDoctors" asp-action="Index" class="nav-link">
                        <i class="bi bi-person-badge-fill"></i> Staff Directory
                    </a>
                    @if (providerCanUseDrugInventoryNav)
                    {
                        <a asp-controller="DrugInventory" asp-action="Index" class="nav-link">
                            <i class="bi bi-capsule-pill"></i> Drug Inventory
                        </a>
                        <a asp-controller="LaboratoryServices" asp-action="Index" class="nav-link">
                            <i class="bi bi-eyedropper"></i> Laboratory Services
                        </a>
                    }
                    @if (providerCanUseClaimsNav)
                    {
                        <a asp-controller="Providers" asp-action="MyClaims" class="nav-link">
                            <i class="bi bi-file-medical-fill"></i> My Claims
                        </a>
                    }
                    @if (providerCanUseMonthlyReportsNav)
                    {
                        <a asp-controller="StateOffice" asp-action="MonthlyReports" class="nav-link">
                            <i class="bi bi-clipboard-data"></i> Provider Reports
                        </a>
                    }
                    @if (providerCanUseReferralReportsNav)
                    {
                        <a asp-controller="StateOffice" asp-action="ReferralProviderReports" class="nav-link">
                            <i class="bi bi-clipboard-pulse"></i> Referral Provider Reports
                        </a>
                    }
                    <a asp-controller="ProviderReferrals" asp-action="Index" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Referrals
                    </a>
                    <a asp-controller="ProviderDeathRegisters" asp-action="Index" class="nav-link">
                        <i class="bi bi-clipboard2-pulse-fill"></i> Death Registers
                    </a>
            }
          
              

            @if (User.IsInRole("CTSHIPAdmin") || User.IsInRole("Admin"))
            {
                <a asp-controller="Analytics" asp-action="Index" class="nav-link">
                    <i class="bi bi-house-door-fill"></i> Dashboard
                </a>
                <a asp-controller="Analytics" asp-action="Index" class="nav-link">
                    <i class="bi bi-graph-up-arrow"></i> Analytics
                </a>
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
                <a asp-controller="Enrollees" asp-action="Index" class="nav-link">
                    <i class="bi bi-person-plus-fill"></i> Enrolment
                </a>
                <a asp-controller="Enrollees" asp-action="BulkUpload" class="nav-link">
                    <i class="bi bi-person-plus-fill"></i> Bulk Enrolment with Excel
                </a>
                <a asp-controller="Admin" asp-action="Users" class="nav-link">
                    <i class="bi bi-people-fill"></i> Manage Users
                </a>
                <a asp-controller="Encounters" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> Patient Encounters
                </a>
                <a asp-controller="Hmo" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> HMO Management
                </a>
                <a asp-controller="Providers" asp-action="Index" class="nav-link">
                    <i class="bi bi-hospital-fill"></i> Providers
                </a>
                <a asp-controller="PriceCatalog" asp-action="Index" class="nav-link">
                    <i class="bi bi-tags-fill"></i> Price Catalog
                </a>
                    <a asp-controller="Organizations" asp-action="Index" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Organizations
                    </a>
                <a asp-controller="Hmo" asp-action="Analytics" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> HMO Analytics
                </a>
                <a asp-controller="Admin" asp-action="EnrolleesPerProvider" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> Enrollees Per Provider
                </a>
                <a asp-controller="Role" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> Manage Roles
                </a>
                <a asp-controller="Claims" asp-action="Index" class="nav-link">
                    <i class="bi bi-file-medical-fill"></i> Claims
                </a>
                <a asp-controller="StateOffice" asp-action="MonthlyReports" class="nav-link">
                    <i class="bi bi-clipboard-data"></i> Reporting Management
                </a>
                <a asp-controller="StateOffice" asp-action="ReferralProviderReports" class="nav-link">
                    <i class="bi bi-clipboard-pulse"></i> Referral Provider Reports
                </a>
                <a asp-controller="HmoDeathRegisters" asp-action="Index" class="nav-link">
                    <i class="bi bi-clipboard2-pulse-fill"></i> Death Registers
                </a>
