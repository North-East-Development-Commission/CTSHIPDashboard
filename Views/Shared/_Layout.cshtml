    <script>
        (() => {
            const removePageLoader = () => {
                const loader = document.getElementById('ctPageLoader');
                if (!loader) return;
                loader.classList.add('is-hidden');
                window.setTimeout(() => loader.remove(), 280);
            };

            if (document.readyState === 'complete') {
                removePageLoader();
            } else {
                window.addEventListener('load', removePageLoader, { once: true });
            }
        })();
    </script>

   
    <script>
        const sidebarElement = document.getElementById('sidebar');
        if (sidebarElement) {
            document.querySelectorAll('#sidebar .nav-link').forEach(link => {
                link.addEventListener('click', () => {
                    const offcanvas = bootstrap.Offcanvas.getInstance(sidebarElement);
                    if (offcanvas) offcanvas.hide();
                });
            });
        }
    </script>
    <script>
        $(document).ready(function () {
            // Active menu highlight
            $('.nav-link').each(function () {
                if (this.href === window.location.href) {
                    $(this).addClass('active');
                }
            });

            const successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString()));
            const errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString()));

            if (successMessage) {
                Swal.fire('Success!', successMessage, 'success');
            } else if (errorMessage) {
                Swal.fire('Attention', errorMessage, 'error');
            }
        });
    </script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            (() => {
                const badge = document.getElementById('ctNotificationBadge');
                const list = document.getElementById('ctNotificationList');
                const dropdown = document.getElementById('ctNotificationDropdown');
                const markAll = document.getElementById('ctNotificationMarkAll');
                const token = document.querySelector('#ctNotificationTokenForm input[name="__RequestVerificationToken"]')?.value || '';
                const unreadUrl = '@Url.Action("UnreadCount", "Notifications")';
                const recentUrl = '@Url.Action("Recent", "Notifications")';
                const markReadUrl = '@Url.Action("MarkRead", "Notifications")';
                const markAllUrl = '@Url.Action("MarkAllRead", "Notifications")';

                const setBadge = count => {
                    if (!badge) return;
                    const value = Number(count || 0);
                    badge.textContent = value > 99 ? '99+' : value.toString();
                    badge.classList.toggle('d-none', value <= 0);
                };

                window.ctRefreshNotificationCount = async () => {
                    try {
                        const response = await fetch(unreadUrl, { headers: { 'Accept': 'application/json' } });
                        if (!response.ok) return;
                        const data = await response.json();
                        setBadge(data.count);
                    } catch { }
                };

                const markRead = async id => {
                    if (!id || !token) return;
                    try {
                        await fetch(markReadUrl, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': token
                            },
                            body: new URLSearchParams({ id })
                        });
                        window.ctRefreshNotificationCount?.();
                    } catch { }
                };

                const escapeHtml = value => String(value).replace(/[&<>'"]/g, char => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
                }[char]));

                const renderNotifications = items => {
                    if (!list) return;
                    if (!items || items.length === 0) {
                        list.innerHTML = '<div class="text-center text-muted py-4">No notifications yet.</div>';
                        return;
                    }

                    list.innerHTML = items.map(item => {
                        const icon = item.icon === 'warning' ? 'exclamation-triangle' : item.icon === 'success' ? 'check-circle' : 'bell';
                        const unreadClass = item.isUnread ? 'bg-light' : '';
                        const title = escapeHtml(item.title || 'Notification');
                        const message = escapeHtml(item.message || '');
                        const time = escapeHtml(item.createdAtText || '');
                        const url = escapeHtml(item.url || '#');
                        return `<a href="${url}" class="dropdown-item ct-notification-item ${unreadClass}" data-notification-id="${item.id}">
                            <div class="d-flex gap-2 align-items-start py-2">
                                <span class="badge ${item.isUnread ? 'bg-warning text-dark' : 'bg-success'} rounded-pill"><i class="bi bi-${icon}"></i></span>
                                <span class="flex-grow-1">
                                    <span class="d-flex justify-content-between gap-2"><strong>${title}</strong><small class="text-muted">${time}</small></span>
                                    <span class="d-block text-muted small">${message}</span>
                                </span>
                            </div>
                        </a>`;
                    }).join('');

                    list.querySelectorAll('[data-notification-id]').forEach(item => {
                        item.addEventListener('click', () => markRead(item.getAttribute('data-notification-id')));
                    });
                };

                const loadRecent = async () => {
                    if (!list) return;
                    try {
                        const response = await fetch(recentUrl, { headers: { 'Accept': 'application/json' } });
                        if (!response.ok) return;
                        renderNotifications(await response.json());
                    } catch {
                        list.innerHTML = '<div class="text-center text-muted py-4">Notifications could not be loaded.</div>';
                    }
                };

                dropdown?.addEventListener('shown.bs.dropdown', loadRecent);
                markAll?.addEventListener('click', async () => {
                    if (!token) return;
                    try {
                        await fetch(markAllUrl, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token }
                        });
                        await window.ctRefreshNotificationCount?.();
                        await loadRecent();
                    } catch { }
                });

                window.ctRefreshNotificationCount?.();
            })();
        </script>
    }
    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            (() => {
                if (!window.signalR || !window.Swal) {
                    return;
                }

                const notificationConnection = new signalR.HubConnectionBuilder()
                    .withUrl('@Url.Content("~/analyticsHub")')
                    .withAutomaticReconnect()
                    .build();

                notificationConnection.on('NotificationCountChanged', () => {
                    window.ctRefreshNotificationCount?.();
                });

                notificationConnection.on('AppNotification', payload => {
                    if (!payload) {
                        return;
                    }

                    const title = payload.title || payload.Title || 'Notification';
                    const message = payload.message || payload.Message || '';
                    const icon = payload.icon || payload.Icon || 'info';
                    const url = payload.url || payload.Url || '';

                    window.ctRefreshNotificationCount?.();

                    Swal.fire({
                        title,
                        text: message,
                        icon,
                        showCancelButton: !!url,
                        confirmButtonText: url ? 'Open' : 'OK',
                        cancelButtonText: 'Dismiss'
                    }).then(result => {
                        if (result.isConfirmed && url) {
                            window.location.href = url;
                        }
                    });
                });

                notificationConnection.start().catch(error => {
                    if (window.console) {
                        console.warn('Notification connection failed.', error);
                    }
                });
            })();
        </script>
    }
    <script>
        $(function () {
            $('select[multiple], select.select2').each(function () {
                if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({
                        placeholder: $(this).data('placeholder') || 'Select options...',
                        width: '100%'
                    });
                }
            });

            $('.select2-search__field').each(function (index) {
                const generatedId = this.id || `select2-search-field-${index + 1}`;
                this.id = generatedId;
                this.name = this.name || generatedId;
                this.setAttribute('aria-label', this.getAttribute('aria-label') || 'Search options');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
