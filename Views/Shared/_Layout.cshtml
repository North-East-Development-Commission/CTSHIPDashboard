@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager // Replace IdentityUser with your custom user class if applicable

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NEDC CTSHIP Dashboard</title>

    <!-- Offline-ready UI libraries -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" />
    <link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="~/css/dashboard-theme.css" asp-append-version="true" />
    <!-- Optional: Make it feel like a real app (PWA) -->
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/img/icon-192.png">

    <style>
        .footer-brand {
            background: linear-gradient(135deg, var(--ct-green-dark), var(--ct-green));
            border-top: 4px solid var(--ct-gold);
            border-radius: 16px;
            padding: 3rem;
            color: white;
            text-align:center;
        }
        .select2-results__options {
            max-height: 200px !important;
            overflow-y: auto !important;
        }
        /* SIDEBAR STYLES - MOBILE FIRST */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 280px;
            background: linear-gradient(180deg, var(--ct-green) 0%, var(--ct-green-dark) 100%);
            color: white;
            transition: all 0.3s ease;
            z-index: 1050;
            overflow-y: auto;
            padding-top: var(--ct-topbar-height); /* Space for fixed navbar */
        }

            .sidebar.collapsed {
                width: 70px;
                overflow: hidden;
            }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.9);
                padding: 12px 20px;
                border-radius: 0;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(201, 162, 71, 0.25);
                    border-left-color: var(--ct-gold);
                    color: white;
                }

                .sidebar .nav-link i {
                    width: 30px;
                    font-size: 1.3rem;
                }

            .sidebar .nav-text {
                opacity: 1;
                transition: opacity 0.2s;
            }

            .sidebar.collapsed .nav-text {
                opacity: 0;
            }

        .content {
            margin-left: 280px;
            transition: margin-left 0.3s ease;
        }

            .content.collapsed {
                margin-left: 70px;
            }

        /* MOBILE: Hide sidebar by default, show as offcanvas */
        @@media (max-width: 992px) {
            .sidebar

        {
            width: 0;
            overflow: hidden;
        }

        .sidebar.show {
            width: 280px;
        }

        .content, .content.collapsed {
            margin-left: 0 !important;
        }

        .navbar-toggler {
            z-index: 1060;
        }

        }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark fixed-top shadow-lg ct-topbar">
        <div class="container-fluid flex-nowrap gap-2">
            <button class="btn navbar-toggler ct-menu-button flex-shrink-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Open navigation menu">
                <i class="bi bi-list fs-3"></i>
            </button>
            <a class="navbar-brand ct-navbar-brand me-auto" href="/">
                <img class="ct-navbar-logo" src="~/images/nedc-logo-transparent.png" alt="North East Development Commission logo" />
                <span class="ct-brand-copy">
                    <span class="ct-brand-title">NORTH EAST DEVELOPMENT COMMISSION (NEDC)</span>
                    <span class="ct-brand-subtitle d-none d-md-block">COMMUNITY TARGETED SOCIAL HEALTH INSURANCE PROGRAM (CTSHIP)</span>
                    <span class="ct-brand-subtitle d-md-none">NEDC CTSHIP DIGITAL SYSTEM</span>
                </span>
            </a>
            <div class="d-flex align-items-center">
              
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="ct-user-link d-none d-lg-flex">
                    <i class="bi bi-person-circle"></i>
                    <span>
                        <small>Welcome</small>
                        <strong>@User.Identity?.Name</strong>
                    </span>
                </a>
            </div>
        </div>
    </nav>
    <!-- Sidebar -->
    <div class="sidebar offcanvas offcanvas-start text-white" id="sidebar" tabindex="-1">
        <div class="offcanvas-header border-bottom border-light border-opacity-25">
            <h5 class="offcanvas-title text-white fw-bold">NEDC CTSHIP PROGRAM</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
        <nav class="nav flex-column">
            @if (User.IsInRole("NHIA"))
            {
                <a asp-page="/Nhia/Index" class="nav-link">
                    <i class="bi bi-speedometer2"></i> NHIA Dashboard
                </a>
                <a asp-controller="Enrollees" asp-action="BulkUpload" class="nav-link">
                    <i class="bi bi-person-plus-fill"></i> Bulk Enrolment with Excel
                </a>
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
                <a asp-controller="HmoDeathRegisters" asp-action="Index" class="nav-link">
                    <i class="bi bi-clipboard2-pulse-fill"></i> Audit Death Records
                </a>
            }

            @if (User.IsInRole("HMO"))
            {
                    <a asp-controller="Hmo" asp-action="Dashboard" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> Dashboard
                    </a>
                    <a asp-controller="Hmo" asp-action="EnrolleeDashboard" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> My Enrollees
                    </a>
                    <a asp-controller="Claims" asp-action="Dashboard" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> My Claims
                    </a>
                    <a asp-controller="Hmo" asp-action="MyProviders" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> My Providers
                    </a>
                    <a asp-controller="HmoReferrals" asp-action="Index" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Referrals
                    </a>
                    <a asp-controller="ReferralHospitals" asp-action="Index" class="nav-link">
                        <i class="bi bi-building-add"></i> Referral Hospitals
                    </a>
                    <a asp-controller="HmoDeathRegisters" asp-action="Index" class="nav-link">
                        <i class="bi bi-clipboard2-pulse-fill"></i> Verify Death Records
                    </a>
                    <a asp-controller="Enrollees" asp-action="BulkUpload" class="nav-link">
                        <i class="bi bi-person-plus-fill"></i> Bulk Enrolment with Excel
                    </a>
            }

            @if (User.IsInRole("SSHIA"))
            {
                <a asp-controller="Providers" asp-action="Index" class="nav-link">
                    <i class="bi bi-hospital-fill"></i> Providers
                </a>
                   
            }

            @if (User.IsInRole("NHIA"))
            {
                    <a asp-controller="ReferralHospitals" asp-action="Index" class="nav-link">
                        <i class="bi bi-building-add"></i> Referral Hospitals
                    </a>
            }

           @if (User.IsInRole("Provider"))
           {
                    <a asp-controller="Providers" asp-action="Dashboard" class="nav-link">
                        <i class="bi bi-house-door-fill"></i> Providers Dashboard
                    </a>
                    <a asp-controller="Providers" asp-action="MyEncounters" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> Patients Encounters
                    </a>
                    <a asp-controller="Providers" asp-action="MyEnrollees" class="nav-link text-white">
                        <i class="bi bi-people-fill"></i> My Enrollees
                    </a>
                    <a asp-controller="Providers" asp-action="MyClaims" class="nav-link">
                        <i class="bi bi-file-medical-fill"></i> My Claims
                    </a>
                    <a asp-controller="ProviderReferrals" asp-action="Index" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Referrals
                    </a>
                    <a asp-controller="ProviderDeathRegisters" asp-action="Index" class="nav-link">
                        <i class="bi bi-clipboard2-pulse-fill"></i> Death Registers
                    </a>
           }
            @if (User.IsInRole("Admin") || User.IsInRole("HMO") || User.IsInRole("Provider") ||
                 User.IsInRole("StateOffice") || User.IsInRole("Monitoring") || User.IsInRole("NHIA") ||
                 User.IsInRole("NEDCAdmin") || User.IsInRole("SSHIA"))
            {
                <a asp-controller="Complaints" asp-action="Index" class="nav-link">
                    <i class="bi bi-chat-square-text-fill"></i> Complaint Management
                </a>
            }
                <a asp-controller="Feedback" asp-action="Index" class="nav-link">
                    <i class="bi bi-chat-dots-fill"></i> Feedback
                </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Home" asp-action="Index" class="nav-link">
                    <i class="bi bi-house-door-fill"></i> Dashboard
                </a>
                <a asp-controller="Analytics" asp-action="Index" class="nav-link">
                    <i class="bi bi-graph-up-arrow"></i> Analytics
                </a>
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
                 <a asp-controller="Enrollees" asp-action="Index" class="nav-link">
                    <i class="bi bi-person-plus-fill"></i>Enrolment
                </a>
                <a asp-controller="Enrollees" asp-action="BulkUpload" class="nav-link">
                    <i class="bi bi-person-plus-fill"></i>Bulk Enrolment with Excel
                </a>
                <a asp-controller="Admin" asp-action="Users" class="nav-link">
                    <i class="bi bi-people-fill"></i> Manage Users
                </a>
                <a asp-controller="Encounters" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> Patient Encounters
                </a>
                <a asp-controller="Hmo" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> HMO Management
                </a>
                <a asp-controller="Providers" asp-action="Index" class="nav-link">
                    <i class="bi bi-hospital-fill"></i> Providers
                </a>
                    <a asp-controller="Organizations" asp-action="Index" class="nav-link">
                        <i class="bi bi-hospital-fill"></i> Organizations
                    </a>
                <a asp-controller="Hmo" asp-action="Analytics" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> HMO Analytics
                </a>
                <a asp-controller="Admin" asp-action="EnrolleesPerProvider" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> Enrollees Per Provider
                </a>
                <a asp-controller="Role" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-people-fill"></i> Manage Roles
                    </a>
                <a asp-controller="Claims" asp-action="Index" class="nav-link">
                    <i class="bi bi-file-medical-fill"></i> Claims
                </a>
                <a asp-controller="HmoDeathRegisters" asp-action="Index" class="nav-link">
                    <i class="bi bi-clipboard2-pulse-fill"></i> Death Registers
                </a>
                <a asp-controller="ReferralHospitals" asp-action="Index" class="nav-link">
                    <i class="bi bi-building-add"></i> Referral Hospitals
                </a>
                 <hr class="bg-white mx-3">
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="nav-link">
                    <i class="bi bi-person-gear"></i> Admin Settings
                </a>
                <a asp-controller="Admin" asp-action="AuditLogs" class="nav-link">
                    <i class="bi bi-graph-up-arrow"></i> AuditLogs
                </a>
                <a asp-controller="Admin" asp-action="UserActivity" class="nav-link">
                    <i class="bi bi-person-gear"></i> User Activity Reports
                </a>
                <a href="/Nhia" class="nav-link">
                    <i class="bi bi-speedometer2"></i> NHIA Dashboard
                </a>
                
            }
            @if (User.IsInRole("NEDCAdmin"))
            {
                <a asp-controller="Analytics" asp-action="Index" class="nav-link">
                    <i class="bi bi-graph-up-arrow"></i> Analytics
                </a>
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
            }
            @if (User.IsInRole("Monitoring"))
            {
                <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                    <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                </a>
            }
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-area="Identity" asp-page="/Account/Logout" class="nav-link">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            }

            @if (User.IsInRole("StateOffice"))
            {
                <a asp-controller="StateOffice" asp-action="Index" class="nav-link">
                    <i class="bi bi-building"></i> Dashboard
                </a>
                    <a asp-controller="StateOffice" asp-action="Enrollees" class="nav-link">
                        <i class="bi bi-building"></i> All Enrollees
                    </a>
                    <a asp-controller="StateOffice" asp-action="Providers" class="nav-link">
                        <i class="bi bi-building"></i> All Providers
                    </a>
                    <a asp-controller="StateOffice" asp-action="Claims" class="nav-link">
                        <i class="bi bi-file-medical-fill"></i> Claims
                    </a>
                    <a asp-controller="StateOffice" asp-action="MonthlyReports" class="nav-link">
                        <i class="bi bi-calendar2-check"></i> Monthly Reports
                    </a>
                    <a asp-controller="Monitoring" asp-action="Index" class="nav-link">
                        <i class="bi bi-bar-chart-line-fill"></i> Monitoring & Evaluation
                    </a>
             }
         
        </nav>
    </div>
  </div>
    <!-- Main Content -->
    <div class="main-content">
        <div class="container-fluid ct-content-shell">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-brand">
        <p class="mb-0 small fw-bold">
            ©@DateTime.Today.Year CTSHIP - Community Targeted Social Health Insurance Project | Powered by North East Development Commission
        </p>
    </div>
    <!-- Offline-ready UI libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/chartjs/chart.min.js"></script>
    <script src="~/lib/chartjs-plugin-datalabels/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js"></script>
   
    <script>
        // Auto-close sidebar when clicking a link on mobile
        document.querySelectorAll('.sidebar .nav-link').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 992) {
                    const offcanvas = bootstrap.Offcanvas.getInstance('#sidebar');
                    if (offcanvas) offcanvas.hide();
                }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.select2').select2();

            // Active menu highlight
            $('.nav-link').each(function () {
                if (this.href === window.location.href) {
                    $(this).addClass('active');
                }
            });

            const successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString()));
            const errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString()));

            if (successMessage) {
                Swal.fire('Success!', successMessage, 'success');
            } else if (errorMessage) {
                Swal.fire('Attention', errorMessage, 'error');
            }
        });
    </script>
    <script>
        $(function () {
            $('select[multiple], select.select2').each(function () {
                if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({
                        placeholder: $(this).data('placeholder') || 'Select options...',
                        width: '100%'
                    });
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
