@model CTSHIPDashboard.Models.ViewModels.MonitoringDashboardViewModel

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-green-gold h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-users ct-kpi-icon" aria-hidden="true"></i>Total Enrollees</div>
                <div class="display-6 fw-bold">@Model.TotalEnrolled.ToString("N0")</div>
                <small>@Model.Scope registered population</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-gold-green h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-user-check ct-kpi-icon" aria-hidden="true"></i>Active Enrollees</div>
                <div class="display-6 fw-bold">@Model.ActiveEnrollees.ToString("N0")</div>
                <small>@Model.ActiveEnrolleeRate% of enrolled population</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-green-gold h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-bullseye ct-kpi-icon" aria-hidden="true"></i>Coverage</div>
                <div class="display-6 fw-bold">@Model.CoveragePercentage%</div>
                <small>@Model.ActiveEnrollees.ToString("N0") active / @Model.TargetEnrollees.ToString("N0") target</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-gold-green h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-chart-line ct-kpi-icon" aria-hidden="true"></i>Active Enrollee Rate</div>
                <div class="display-6 fw-bold">@Model.ActiveEnrolleeRate%</div>
                <small>@Model.ActiveEnrollees.ToString("N0") active / @Model.TotalEnrolled.ToString("N0") enrolled</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-green-gold h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-person ct-kpi-icon" aria-hidden="true"></i>Male Enrollees</div>
                <div class="display-6 fw-bold">@Model.MalePercentage%</div>
                <small>@Model.MaleCount.ToString("N0") males</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-gold-green h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-person-dress ct-kpi-icon" aria-hidden="true"></i>Female Enrollees</div>
                <div class="display-6 fw-bold">@Model.FemalePercentage%</div>
                <small>@Model.FemaleCount.ToString("N0") females</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-green-gold h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-stethoscope ct-kpi-icon" aria-hidden="true"></i>Number of Visits</div>
                <div class="display-6 fw-bold">@Model.TotalVisits.ToString("N0")</div>
                <small>@Model.TotalEncounters.ToString("N0") encounters recorded</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-green-gold h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-hospital-user ct-kpi-icon" aria-hidden="true"></i>Number of Referrals</div>
                <div class="display-6 fw-bold">@Model.TotalReferrals.ToString("N0")</div>
                <small>@Model.CompletedReferrals.ToString("N0") completed</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card ct-kpi ct-kpi-gold-green h-100">
            <div class="card-body">
                <div class="text-muted"><i class="fa-solid fa-circle-check ct-kpi-icon" aria-hidden="true"></i>Referral Completion Rate</div>
                <div class="display-6 fw-bold">@Model.ReferralCompletionRate%</div>
                <small>@Model.CompletedReferrals.ToString("N0") completed / @Model.TotalReferrals.ToString("N0") referrals</small>
            </div>
        </div>
    </div>
</div>

