@model CTSHIPDashboard.Models.ViewModels.ComplaintUpdateViewModel
@using CTSHIPDashboard.Models.Enums
@{
    ViewData["Title"] = "Manage Complaint";
}

<div class="container py-5">
    <div class="card border-0 shadow-lg mx-auto" style="max-width:950px;">
        <div class="card-header bg-success text-white p-4">
            <h2 class="mb-1">Manage @Model.ReferenceNumber</h2>
            <p class="mb-0 text-white">@Model.Subject</p>
        </div>
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Manage" asp-route-id="@Model.Id" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <div class="col-md-6"><label asp-for="Status" class="form-label fw-bold"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ComplaintStatus>()" class="form-select form-select-lg"></select></div>
                    <div class="col-md-6"><label asp-for="Priority" class="form-label fw-bold"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<ComplaintPriority>()" class="form-select form-select-lg"></select></div>
                    <div class="col-md-6"><label asp-for="ResponsibleOrganization" class="form-label fw-bold"></label><input asp-for="ResponsibleOrganization" class="form-control form-control-lg" placeholder="HMO, facility, unit, or agency" /></div>
                    <div class="col-md-6"><label asp-for="AssignedToName" class="form-label fw-bold"></label><input asp-for="AssignedToName" class="form-control form-control-lg" placeholder="Officer, unit, or team" /></div>
                    <div class="col-md-6"><label asp-for="AgreedResolutionDueAt" class="form-label fw-bold"></label><input asp-for="AgreedResolutionDueAt" type="datetime-local" class="form-control form-control-lg" /></div>
                    <div class="col-12"><label asp-for="ActionTaken" class="form-label fw-bold"></label><textarea asp-for="ActionTaken" class="form-control" rows="4"></textarea></div>
                    <div class="col-12"><label asp-for="EscalationDetails" class="form-label fw-bold"></label><textarea asp-for="EscalationDetails" class="form-control" rows="4"></textarea></div>
                    <div class="col-12"><label asp-for="ResolutionNote" class="form-label fw-bold"></label><textarea asp-for="ResolutionNote" class="form-control" rows="5"></textarea><span asp-validation-for="ResolutionNote" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="ComplainantFeedback" class="form-label fw-bold"></label><textarea asp-for="ComplainantFeedback" class="form-control" rows="4"></textarea></div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-success btn-lg">Cancel</a>
                    <button class="btn btn-success btn-lg">Save Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}