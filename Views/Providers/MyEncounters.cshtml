@model IEnumerable<CTSHIPDashboard.Models.Encounter>

@{
    ViewData["Title"] = $"Encounters at {ViewBag.ProviderName}";
}

<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-success mb-3">
            My Patient Encounters
        </h1>
        <h2 class="display-5 text-primary fw-bold">@ViewBag.ProviderName</h2>
        <p class="lead text-muted">Facility Code: <strong>@ViewBag.ProviderCode</strong></p>
        <p class="fs-4">Total Encounters: <strong class="text-success">@ViewBag.TotalEncounters</strong></p>
    </div>
    <div>
        <a asp-controller="Encounters" asp-action="Create" class="btn btn-success btn-lg mb-3 shadow-lg">
            New Encounter
        </a>
    </div>

    <!-- SEARCH -->
    <div class="card border-0 shadow-lg mb-5 rounded-4">
        <div class="card-body p-4">
            <form asp-action="MyEncounters" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label fw-bold text-success">Search Encounters</label>
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Patient name, ID, complaint, diagnosis..." />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 shadow">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ENCOUNTERS TABLE -->
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-success text-white text-center py-4">
            <h3 class="fw-bold mb-0">All Patient Encounters (@ViewBag.TotalEncounters total)</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Visit Date</th>
                            <th>Patient</th>
                            <th>ID</th>
                            <th>HMO</th>
                            <th>Doctor</th>
                            <th>Complaint</th>
                            <th>Diagnosis</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Claim</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5 text-muted fs-4">
                                    No encounters recorded yet
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var e in Model)
                            {
                                <tr>
                                    <td>@e.VisitDate.Date</td>
                                    <td>
                                        <strong>@e.Enrollee?.FullName</strong>
                                    </td>
                                    <td><span class="text-primary fw-bold">@e.Enrollee?.EnrollmentNumber</span></td>
                                    <td>
                                        <span class="badge bg-info px-3 py-2">@e.Enrollee?.Hmo?.Name</span>
                                    </td>
                                    <td class="fw-bold">@(e.Doctor?.FullName ?? e.SeenBy ?? "—")</td>
                                    <td>@(string.IsNullOrEmpty(e.ChiefComplaint) ? "—" : e.ChiefComplaint)</td>
                                    <td>@(string.IsNullOrEmpty(e.Diagnosis) ? "—" : e.Diagnosis)</td>
                                    <td class="fw-bold text-success">₦@((int)e.TotalAmount)</td>
                                    <td>
                                        <span class="badge @(e.Status == "Claimed" ? "bg-primary" :
                                                                                                          e.Status == "Completed" ? "bg-success" :
                                                                                                          "bg-warning text-dark") px-4 py-2">
                                    @e.Status
                                </span>
                            </td>
                            <td>
                                @if (e.ClaimId == null)
                                        {
                                            <span class="badge bg-secondary">Not Claimed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Claimed</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="ENCDetails" asp-route-id="@e.Id"
                                           class="btn btn-info btn-sm rounded-pill">View</a>
                                        <a asp-action="EncEdit" asp-route-id="@e.Id" class="btn btn-warning btn-sm">Edit</a>

                                        @if (e.ClaimId == null)
                                        {
                                            <a asp-action="CreateClaim" asp-route-id="@e.Id"
                                               class="btn btn-primary btn-sm rounded-pill">Create Claim</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="MyEncounters"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="MyEncounters"
                           asp-route-search="@ViewBag.Search"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="MyEncounters"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }

    <!-- Dashboard Button -->
    <div class="text-center mt-5">
        <a asp-action="Dashboard" class="btn btn-primary btn-lg px-7 shadow-lg fw-bold fs-4">
            BACK TO DASHBOARD
        </a>
    </div>

    <!-- Footer -->
    <div class="text-center mt-5 py-5 bg-dark text-white rounded-4">
        <p class="display-6 fw-bold mb-3">North East Development Commission (NEDC)</p>
        <p class="lead mb-0">CTSHIP — Empowering Providers with Digital Tools</p>
    </div>
</div>
