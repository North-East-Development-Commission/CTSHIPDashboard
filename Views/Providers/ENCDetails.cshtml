@model CTSHIPDashboard.Models.Encounter

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="bg-success text-white text-center py-5">
                    <h1 class="display-5 fw-bold mb-2">ENCOUNTER DETAILS</h1>
                    <p class="lead mb-0">Encounter Number:@Model.EncounterNumber</p>
                </div>

                <div class="card-body p-5">
                    <div class="row g-5">
                        <div class="col-md-5">
                            <div class="card border-success shadow">
                                <div class="card-body text-center p-4">
                                    <img src="@EnrolleePhotoStorage.ResolvePhotoPath(Model.Enrollee?.PhotoPath, Model.Enrollee?.EnrollmentNumber)"
                                         class="rounded-circle shadow" style="width:180px;height:180px;object-fit:cover;border:6px solid #3B703B;" />
                                    <h4 class="mt-4 fw-bold">@Model.Enrollee?.FullName</h4>
                                    <p>ID: @Model.Enrollee?.EnrollmentNumber</p>
                                    <p>HMO: @Model.Enrollee?.Hmo?.Name</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <h5 class="text-success fw-bold">Laboratory Investigations</h5>
                                    @if (string.IsNullOrWhiteSpace(Model.LabTests))
                                    {
                                        <p class="text-muted mb-0">No laboratory investigations recorded.</p>
                                    }
                                    else
                                    {
                                        var labText = Model.LabTests ?? string.Empty;
                                        var parts = labText.Split(new[] { " - " }, StringSplitOptions.None);
                                        var testsPart = parts.Length > 0 ? parts[0] : string.Empty;
                                        var resultsPart = parts.Length > 1 ? parts[1] : string.Empty;
                                        var tests = testsPart.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
                                        var results = resultsPart.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();

                                        <div>
                                            <strong>Requested Tests:</strong>
                                            @if (tests.Count == 0)
                                            {
                                                <span class="text-muted">None</span>
                                            }
                                            else
                                            {
                                                foreach (var t in tests)
                                                {
                                                    <span class="badge bg-primary me-1 mb-1">@t</span>
                                                }
                                            }
                                        </div>

                                        @if (results.Count > 0)
                                        {
                                            <hr />
                                            <div>
                                                <strong>Results:</strong>
                                                <ul class="mb-0 mt-2">
                                                    @foreach (var r in results)
                                                    {
                                                        <li>@r</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Visit Information</h5>
                                            <p><strong>Date:</strong> @Model.VisitDate</p>
                                            <p><strong>Type:</strong> @Model.VisitType</p>
                                            <p><strong>Reason:</strong> @Model.ReasonForEncounter</p>
                                            <p><strong>Provider:</strong> @Model.Provider?.Name</p>
                                            <p>
                                                <strong>Status:</strong>
                                                <span class="badge bg-success fs-6">@Model.Status</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Clinical Details</h5>
                                            <p><strong>Complain:</strong> @Model.ChiefComplaint</p>
                                            <p><strong>Diagnosis:</strong> @Model.Diagnosis</p>
                                            <p><strong>Treatment:</strong> @Model.TreatmentGiven</p>
                                            <p>
                                                <strong>Attended By:</strong> @(Model.Doctor?.FullName ?? Model.SeenBy)<br />
                                                <strong>Specialty / Unit:</strong> @(Model.Doctor?.Specialty ?? Model.Rank)
                                            </p>
                                            <p><strong>Recorded By:</strong> @Model.AttendedBy</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Prescriptions</h5>
                                            @if (Model.Prescriptions.Count == 0)
                                            {
                                                <p class="text-muted mb-0">No inventory prescriptions recorded.</p>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm align-middle mb-0">
                                                        <thead>
                                                            <tr><th>Drug</th><th>Quantity</th><th>Deducted</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var prescription in Model.Prescriptions)
                                                            {
                                                                <tr>
                                                                    <td>@prescription.DrugName @prescription.Strength @prescription.DosageForm</td>
                                                                    <td>@prescription.QuantityDispensed.ToString("N0") @prescription.UnitOfMeasure</td>
                                                                    <td><span class="badge @(prescription.InventoryDeducted ? "bg-success" : "bg-warning text-dark")">@(prescription.InventoryDeducted ? "Yes" : "Pending")</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card @(Model.ClaimId == null ? "border-warning" : "border-success") shadow-sm">
                                        <div class="card-body text-center py-4">
                                            <h5>Total Amount</h5>
                                            <h2 class="display-5 fw-bold text-success">&#8358;@((int)Model.TotalAmount)</h2>
                                            @if (Model.ClaimId == null)
                                            {
                                                <p class="text-warning fw-bold">Not yet claimed</p>
                                            }
                                            else
                                            {
                                                <p class="text-success fw-bold">Claim Submitted</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-success shadow-sm mt-4">
                        <div class="card-header bg-success text-white fw-bold">Primary Encounter Capitation & Query Trail</div>
                        <div class="card-body">
                            <div class="row g-3 mb-4">
                                <div class="col-md-3"><strong>Capitation Charge:</strong><br /><span class="text-success fw-bold">&#8358;@Model.CapitationCharge.ToString("N2")</span></div>
                                <div class="col-md-3"><strong>HMO Status:</strong><br /><span class="badge bg-primary">@Model.HmoVerificationStatus</span></div>
                                <div class="col-md-3"><strong>IHSA Status:</strong><br /><span class="badge bg-info text-dark">@Model.IhsaVerificationStatus</span></div>
                                <div class="col-md-3"><strong>Original Data:</strong><br /><span class="text-muted">Preserved @(!string.IsNullOrWhiteSpace(Model.OriginalFacilityDataJson) ? "Yes" : "Pending")</span></div>
                            </div>

                            <h6 class="fw-bold text-success">Query Cycle</h6>
                            @if (Model.Queries.Count == 0)
                            {
                                <p class="text-muted">No HMO clarification queries have been raised for this encounter.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle">
                                        <thead><tr><th>Query Raised</th><th>Responsible</th><th>Response</th><th>Resolution</th><th>Status / Timestamp</th></tr></thead>
                                        <tbody>
                                            @foreach (var query in Model.Queries.OrderByDescending(q => q.RaisedAt))
                                            {
                                                <tr>
                                                    <td>@query.QueryRaised<br /><small class="text-muted">By @query.RaisedByName</small></td>
                                                    <td>@query.ResponsiblePerson</td>
                                                    <td>@(query.Response ?? "?")<br /><small class="text-muted">@query.RespondedAt?.ToString("dd MMM yyyy HH:mm")</small></td>
                                                    <td>@(query.Resolution ?? "?")</td>
                                                    <td><span class="badge bg-secondary">@query.Status</span><br /><small>@query.RaisedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @foreach (var query in Model.Queries.Where(q => q.Status != "Closed" && string.IsNullOrWhiteSpace(q.Response)))
                                {
                                    <form asp-controller="Encounters" asp-action="RespondEncounterQuery" method="post" class="border rounded-3 p-3 mb-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="queryId" value="@query.Id" />
                                        <label class="form-label fw-bold text-success">Respond to @query.QueryNumber</label>
                                        <textarea name="response" class="form-control mb-2" rows="3" placeholder="Facility response / amendment note" required></textarea>
                                        <button class="btn btn-success">Submit Response</button>
                                    </form>
                                }
                            }

                            <h6 class="fw-bold text-success mt-4">Audit Trail</h6>
                            @if (Model.AuditTrails.Count == 0)
                            {
                                <p class="text-muted mb-0">No audit events recorded yet.</p>
                            }
                            else
                            {
                                <ul class="list-group">
                                    @foreach (var item in Model.AuditTrails.OrderByDescending(a => a.PerformedAt))
                                    {
                                        <li class="list-group-item d-flex justify-content-between gap-3">
                                            <span><strong>@item.Action</strong><br /><span class="text-muted">@item.Summary</span></span>
                                            <small class="text-muted text-nowrap">@item.PerformedAt.ToString("dd MMM yyyy HH:mm")</small>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <div class="text-center mt-5">
                        <a asp-action="EncEdit" asp-route-id="@Model.Id" class="btn btn-success btn-lg px-6">Edit Encounter</a>
                    </div>
                    <div class="text-center mt-5">
                        <a asp-action="MyEncounters" class="btn btn-secondary btn-lg px-6">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
