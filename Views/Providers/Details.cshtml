@model CTSHIPDashboard.Models.Provider
@{
    ViewData["Title"] = Model.Name + " - Provider Details";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="bg-success text-white text-center py-5">
                    <div class="container">
                        <h1 class="display-4 fw-bold mb-2">@Model.Name</h1>
                        <p class="lead mb-0 opacity-90">
                            <span class="badge bg-white text-success fs-4 px-4 py-2">@Model.Code</span>
                        </p>
                        <p class="mt-3 fs-4">@Model.Level • @Model.State</p>
                    </div>
                </div>

                <div class="card-body p-5">
                    <!-- Status Badge -->
                    <div class="text-center mb-4">
                        <span class="badge fs-3 px-5 py-3 @(Model.IsActive ? "bg-success" : "bg-danger")">
                            @(Model.IsActive ? "ACTIVE FACILITY" : "INACTIVE")
                        </span>
                    </div>

                    <!-- Main Info Cards -->
                    <div class="row g-5">
                        <!-- Left: Facility Info -->
                        <div class="col-lg-6">
                            <div class="card border-success shadow-lg h-100">
                                <div class="card-body p-4">
                                    <h3 class="text-success fw-bold mb-4">
                                        Facility Information
                                    </h3>
                                    <table class="table table-borderless">
                                        <tr>
                                            <td class="fw-bold"">Provider Code</td>
                                            <td class="text-end"><strong class="text-primary fs-5">@Model.Code</strong></td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Full Name</td>
                                            <td class="text-end">@Model.Name</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Level</td>
                                            <td class="text-end">@Model.Level</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">State</td>
                                            <td class="text-end">@Model.State</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Address</td>
                                            <td class="text-end">@Model.Location</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Phone</td>
                                            <td class="text-end">@Model.Phone</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Email</td>
                                            <td class="text-end">@Model.Email</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Status</td>
                                            <td class="text-end">
                                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-5 px-4">
                                                    @(Model.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold">Date Registered</td>
                                            <td class="text-end">@Model.DateRegistered:dd MMMM yyyy</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Activity Stats -->
                        <div class="col-lg-6">
                            <h3 class="text-success fw-bold mb-4 text-center">
                                Activity Summary
                            </h3>
                            <div class="row g-4 text-center">
                                <div class="col-md-6">
                                    <div class="card bg-primary text-white shadow-lg">
                                        <div class="card-body py-5">
                                            <i class="bi bi-journal-medical fs-1 mb-3"></i>
                                            <h5>Patient Encounters</h5>
                                            <h2 class="display-5 fw-bold">@ViewBag.TotalEncounters</h2>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card bg-info text-white shadow-lg">
                                        <div class="card-body py-5">
                                            <i class="bi bi-file-medical fs-1 mb-3"></i>
                                            <h5>Claims Submitted</h5>
                                            <h2 class="display-5 fw-bold">@ViewBag.TotalClaims</h2>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card bg-success text-white shadow-lg">
                                        <div class="card-body py-5 text-center">
                                            <i class="bi bi-currency-dollar fs-1 mb-3"></i>
                                            <h5>Total Claims Value</h5>
                                            <h2 class="display-4 fw-bold">₦@ViewBag.TotalClaimAmount:N0</h2>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-5 pt-4 border-top">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-6 shadow">
                            Edit Provider
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg px-6 shadow ms-3">
                            Delete Provider
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-6 ms-3">
                            Back to List
                        </a>
                    </div>
                </div>

              
            </div>
        </div>
    </div>
</div>