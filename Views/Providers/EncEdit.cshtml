@model CTSHIPDashboard.Models.Encounter
@{
    ViewData["Title"] = "Edit Encounter " ;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="card-header bg-success text-white text-center py-4">
                    <h2 class="fw-bold mb-1">Edit Encounter</h2>
                    <h5 class="mb-0">Encounter: <strong>@Model.EncounterNumber</strong></h5>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Enrollee Details (Read-only) -->
                    <div class="card bg-light border-0 shadow-sm mb-5">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-3 text-center">
                                    <img src="@(Model.Enrollee?.PhotoPath ?? "/img/icon-192.png")" 
                                         class="rounded-circle shadow" 
                                         style="width:140px; height:140px; object-fit:cover; border:5px solid #3B703B;" />
                                </div>
                                <div class="col-md-9">
                                    <h4 class="text-success fw-bold mb-2">@Model.Enrollee?.FullName</h4>
                                    <p class="mb-1"><strong>ID:</strong> <span class="text-primary fw-bold">@Model.Enrollee?.EnrollmentNumber</span></p>
                                    <p class="mb-1"><strong>HMO:</strong> @Model.Enrollee?.Hmo?.Name</p>
                                    <p class="mb-1"><strong>Phone:</strong> @Model.Enrollee?.Phone</p>
                                    <p class="mb-0"><strong>State:</strong> @Model.Enrollee?.State</p>
                                    <p class="mb-0"><strong>State:</strong> @Model.EncounterNumber</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Edit Form -->
                    <form asp-action="EncEdit" method="post" id="encounterForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EncounterNumber" />
                        <input type="hidden" asp-for="EnrolleeId" />

                        <div class="row g-4">
                            <!-- Visit Details -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="VisitDate" class="form-control" type="datetime-local" />
                                    <label asp-for="VisitDate">Visit Date & Time</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status">Status</label>
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select" asp-items="ViewBag.Statuses">
                                        <option value="">Select Status</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProviderId">Facility</label>
                                <div class="form-floating">
                                    <select asp-for="ProviderId" class="form-select" asp-items="ViewBag.Providers">
                                        <option value="">Select Facility</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DoctorId" class="form-label fw-bold">Attending Doctor</label>
                                <select asp-for="DoctorId" class="form-select form-select-lg" asp-items="ViewBag.Doctors" data-selected-doctor="@Model.DoctorId">
                                    <option value="">Select Doctor</option>
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger"></span>
                            </div>

                            <!-- Clinical Details -->
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="ChiefComplaint" class="form-control" rows="3"></textarea>
                                    <label asp-for="ChiefComplaint">Chief Complaint</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Diagnosis" class="form-control" rows="4"></textarea>
                                    <label asp-for="Diagnosis">Diagnosis</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="TreatmentGiven" class="form-control" rows="5"></textarea>
                                    <label asp-for="TreatmentGiven">Treatment Given</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                                    <label asp-for="Notes">Additional Notes</label>
                                </div>
                            </div>
                        </div>

                        <!-- Submit -->
                        <div class="text-center mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow-lg fw-bold" name="submitAction" value="save" formnovalidate>
                                SAVE CHANGES
                            </button>
                            <a asp-action="ENCDetails" asp-route-id="@Model.Id" class="btn btn-info btn-lg px-5 ms-3">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function disableEncounterClientValidation() {
            const form = document.getElementById('encounterForm');
            if (!form || !window.jQuery) return;

            const $form = $(form);
            $form.removeData('validator');
            $form.removeData('unobtrusiveValidation');
            $form.off('.validate');

            $form.find(':input').each(function () {
                Array.from(this.attributes)
                    .filter(attribute => attribute.name.startsWith('data-val'))
                    .forEach(attribute => this.removeAttribute(attribute.name));
                this.classList.remove('input-validation-error', 'is-invalid');
            });
        })();

        async function refreshDoctorDropdown() {
            const providerSelect = document.getElementById('ProviderId');
            const doctorSelect = document.getElementById('DoctorId');
            if (!providerSelect || !doctorSelect || !providerSelect.value) return;

            const selectedDoctorId = doctorSelect.dataset.selectedDoctor || doctorSelect.value;
            doctorSelect.innerHTML = '<option value="">Select Doctor</option>';

            try {
                const response = await fetch(`/Encounters/GetDoctorsByProvider?providerId=${encodeURIComponent(providerSelect.value)}&selectedDoctorId=${encodeURIComponent(selectedDoctorId || '')}`);
                const data = await response.json();

                if (!data.success || !Array.isArray(data.doctors)) {
                    return;
                }

                data.doctors.forEach(doctor => {
                    const option = document.createElement('option');
                    option.value = doctor.id;
                    option.textContent = doctor.text;
                    option.selected = Boolean(doctor.selected);
                    doctorSelect.appendChild(option);
                });

                if (!doctorSelect.value && data.doctors.length === 1) {
                    doctorSelect.value = data.doctors[0].id;
                }

                doctorSelect.dataset.selectedDoctor = doctorSelect.value;
            } catch {
                doctorSelect.innerHTML = '<option value="">Select Doctor</option>';
            }
        }

        document.getElementById('ProviderId')?.addEventListener('change', async () => {
            const doctorSelect = document.getElementById('DoctorId');
            if (doctorSelect) doctorSelect.dataset.selectedDoctor = '';
            await refreshDoctorDropdown();
        });
        refreshDoctorDropdown();

    </script>
}
