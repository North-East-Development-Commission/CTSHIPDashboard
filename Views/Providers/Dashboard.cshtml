@model CTSHIPDashboard.ViewModels.ProviderDashboardViewModel

@{
    ViewData["Title"] = $"{Model.ProviderName} - Provider Dashboard";
}

<!-- Custom Styles -->
<style>
    body {
        background: linear-gradient(135deg, #ffffff 0%, rgba(59, 112, 59, .08) 100%);
        min-height: 100vh;
    }
    .dashboard-card {
        border: none;
        border-radius: 16px;
        background: #ffffff;
        color: #244a2a;
        box-shadow: 0 10px 30px rgba(0, 100, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }
    .dashboard-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 100, 0, 0.15);
    }
    .kpi-card {
        background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
        color: white !important;
        border-radius: 16px;
        padding: 2rem;
        text-align: center;
        height: 100%;
        text-shadow: 0 1px 2px rgba(0,0,0,.28);
    }
    .kpi-card h5 {
        color: white !important;
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: .02em;
    }
    .kpi-card h2 {
        color: white !important;
    }
    .kpi-icon {
        font-size: 3rem;
        opacity: 0.9;
        margin-bottom: 1rem;
    }
    .section-header {
        background: linear-gradient(90deg, #3B703B, #2B572F);
        color: white;
        border-radius: 16px 16px 0 0;
        padding: 1.5rem;
        text-align: center;
        font-weight: bold;
    }
    .table-modern {
        background: white;
        border-radius: 0 0 16px 16px;
        overflow: hidden;
    }
    .table-modern thead {
        background: rgba(254, 144, 49, .12);
    }
    .table-modern thead th {
        color: #2B572F !important;
        font-weight: 800;
        white-space: nowrap;
    }
    .provider-hero {
        background: linear-gradient(135deg, #3B703B, #2B572F);
        border: 3px solid #FE9031;
        border-radius: 20px;
        color: white;
        padding: 2rem;
        box-shadow: 0 12px 30px rgba(43,87,47,.22);
    }
    .provider-hero h1,
    .provider-hero p,
    .provider-hero strong {
        color: white !important;
        opacity: 1 !important;
    }
    .provider-hero .facility-code {
        color: white !important;
        background: #FE9031;
        border-radius: 999px;
        display: inline-block;
        padding: .45rem 1rem;
    }
    .dashboard-card .text-muted {
        color: #244a2a !important;
        opacity: 1 !important;
        font-weight: 700;
    }
    .provider-dashboard .dashboard-card,
    .provider-dashboard .dashboard-card p,
    .provider-dashboard .dashboard-card small,
    .provider-dashboard .dashboard-card strong,
    .provider-dashboard .dashboard-card td,
    .provider-dashboard .dashboard-card li {
        color: #244a2a;
        opacity: 1;
    }
    .provider-dashboard .dashboard-card .section-header,
    .provider-dashboard .dashboard-card .section-header *,
    .provider-dashboard .kpi-card,
    .provider-dashboard .kpi-card * {
        color: #ffffff !important;
        opacity: 1 !important;
    }
    .provider-dashboard .table-modern tbody td {
        color: #244a2a !important;
        font-weight: 600;
        background: #ffffff;
    }
    .provider-dashboard .list-group-item {
        color: #244a2a !important;
        background: #ffffff;
    }
    .provider-dashboard .badge,
    .provider-dashboard .btn-success,
    .provider-dashboard .btn-warning {
        color: #ffffff !important;
        opacity: 1 !important;
        font-weight: 700;
    }
    .provider-dashboard .footer-brand,
    .provider-dashboard .footer-brand * {
        color: #ffffff !important;
        opacity: 1 !important;
    }
    .doctor-rank {
        width: 40px;
        height: 40px;
        background: #3B703B;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
    .footer-brand {
        background: linear-gradient(135deg, #2B572F, #3B703B);
        border-radius: 16px;
        padding: 3rem;
        color: white;
    }
</style>

<div class="container-fluid py-5 provider-dashboard">
    <!-- Header -->
    <div class="provider-hero text-center mb-4">
        <h1 class="display-4 fw-bold mb-3">@Model.ProviderName</h1>
        <p class="facility-code lead fw-bold fs-5 mb-3">Facility Code: <strong>@Model.ProviderCode</strong></p>
        <p class="fs-5 fw-bold mb-0">@Model.Level • @Model.State</p>
    </div>

    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a asp-controller="Encounters" asp-action="Create" class="btn btn-success btn-lg">
            <i class="bi bi-journal-plus me-2"></i>New Encounter
        </a>
        <a asp-controller="ProviderDoctors" asp-action="Index" class="btn btn-warning btn-lg text-white">
            <i class="bi bi-person-badge-fill me-2"></i>Manage Doctors (@Model.TotalDoctors)
        </a>
        <a asp-action="MyEncounters" class="btn btn-outline-success btn-lg">
            <i class="bi bi-list-check me-2"></i>View Encounters
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning shadow-sm mb-4">@TempData["Error"]</div>
    }

    @if (!Model.CanUseClaims)
    {
        <div class="alert alert-info shadow-sm mb-4">
            PHC providers receive capitation only. Claims services are available only to secondary or referred providers.
        </div>
    }

    <!-- KPI CARDS -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card kpi-card" style="--bg-start:#3B703B; --bg-end:#2B572F;">
                <div class="kpi-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h5>Patients</h5>
                <h2 class="display-5 fw-bold mb-0">@Model.TotalUniqueEnrollees</h2>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card kpi-card" style="--bg-start:#FE9031; --bg-end:#3B703B;">
                <div class="kpi-icon">
                    <i class="bi bi-journal-medical"></i>
                </div>
                <h5>Total Encounters</h5>
                <h2 class="display-5 fw-bold mb-0">@Model.TotalEncounters</h2>
            </div>
        </div>
        @if (Model.CanUseClaims)
        {
            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card kpi-card" style="--bg-start:#3B703B; --bg-end:#FE9031;">
                    <div class="kpi-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <h5>Pending Claims</h5>
                    <h2 class="display-5 fw-bold mb-0">@Model.PendingClaims</h2>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card kpi-card" style="--bg-start:#FE9031; --bg-end:#3B703B;">
                    <div class="kpi-icon">
                        <i class="bi bi-journal"></i>
                    </div>
                    <h5>Claims Value</h5>
                    <h2 class="display-5 fw-bold mb-0">₦@((int)Model.TotalClaimAmount)</h2>
                </div>
            </div>
        }
        else
        {
            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card kpi-card" style="--bg-start:#3B703B; --bg-end:#FE9031;">
                    <div class="kpi-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h5>Capitation</h5>
                    <h2 class="display-6 fw-bold mb-0">Monthly</h2>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="dashboard-card kpi-card" style="--bg-start:#FE9031; --bg-end:#3B703B;">
                    <div class="kpi-icon">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <h5>Provider Level</h5>
                    <h2 class="display-6 fw-bold mb-0">PHC</h2>
                </div>
            </div>
        }
    </div>

    <div class="dashboard-card mb-5">
        <div class="section-header">
            <h3 class="fw-bold mb-0">Most Frequently Used Services</h3>
        </div>
        <div class="table-modern">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Rank</th><th>Service</th><th>Setting</th><th>Frequency</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.MostUsedServices.Count; i++)
                        {
                            var service = Model.MostUsedServices[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@service.ServiceName</td>
                                <td><span class="badge bg-secondary">@service.ServiceSetting</span></td>
                                <td class="fw-bold text-success">@service.Frequency</td>
                            </tr>
                        }
                        @if (!Model.MostUsedServices.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No structured service data recorded yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TOP DOCTORS & RECENT ENCOUNTERS -->
    <div class="row g-5 mb-5">
        <!-- TOP DOCTORS -->
        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="section-header">
                    <h3 class="fw-bold mb-0">Top Doctors by Encounters</h3>
                </div>
                <div class="card-body p-4">
                    @if (!Model.TopDoctors.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1"></i>
                            <p class="mt-3 fs-5">No doctor activity recorded yet</p>
                        </div>
                    }
                    else
                    {
                        <ol class="list-group list-group-numbered">
                            @foreach (var doc in Model.TopDoctors)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-0">
                                    <div class="d-flex align-items-center">
                                        <div class="doctor-rank me-3">@(Model.TopDoctors.IndexOf(doc) + 1)</div>
                                        <div>
                                            <strong class="fs-5">@doc.DoctorName</strong>
                                            <br><small class="text-muted">@doc.EncounterCount encounters</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-success rounded-pill fs-5 px-4 py-2">
                                        ₦@((int)doc.TotalAmount)
                                    </span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </div>
        </div>

        <!-- RECENT ENCOUNTERS -->
        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="section-header">
                    <h3 class="fw-bold mb-0">Recent Patient Encounters</h3>
                </div>
                <div class="table-modern">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Patient</th>
                            <th>Doctor</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentEncounters.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted fs-4">
                                            No recent encounters
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var e in Model.RecentEncounters)
                                    {
                                        <tr>
                                            <td>@e.VisitDate</td>
                                            <td>
                                                <strong>@e.Enrollee?.FullName</strong><br>
                                                <small class="text-muted">@e.Enrollee?.EnrollmentNumber</small>
                                            </td>
                                            <td>
                                                <strong>@(e.Doctor?.FullName ?? (string.IsNullOrEmpty(e.SeenBy) ? "—" : e.SeenBy))</strong>
                                            </td>
                                            <td class="fw-bold text-success">₦@((int)e.TotalAmount)</td>
                                            <td>
                                                @if (e.ClaimId == null)
                                                {
                                                    <span class="badge bg-warning px-3 py-2">Not Claimed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success px-3 py-2">Claimed</span>
                                                }
                                            </td>
                                            <td>
                                                @if (e.ClaimId == null && Model.CanUseClaims)
                                                {
                                                    <a asp-action="CreateClaim" asp-route-id="@e.Id"
                                                       class="btn btn-primary btn-sm rounded-pill px-4">Create Claim</a>
                                                }
                                                else
                                                {
                                                    <a asp-action="ClaimDetails" asp-route-id="@e.ClaimId"
                                                       class="btn btn-info btn-sm rounded-pill px-4">View Claim</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-brand">
        <p class="display-6 fw-bold mb-3">Excellence in Healthcare Delivery</p>
        <p class="lead mb-0">CTSHIP — Partnering with Providers for Universal Coverage</p>
    </div>
</div>
