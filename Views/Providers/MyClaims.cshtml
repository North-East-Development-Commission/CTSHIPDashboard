@model IEnumerable<CTSHIPDashboard.Models.Claim>

@{
    ViewData["Title"] = "My Claims Dashboard";
}

<div class="container-fluid py-5 bg-light">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-success">My Claims Dashboard</h1>
        <p class="lead text-muted">Track all claims submitted from your facility</p>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-5 text-center">
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-lg bg-dark text-white h-70">
                <div class="card-body py-2">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Claims</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalSubmitted</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-lg bg-success text-white h-70">
                <div class="card-body py-2">
                    <i class="bi bi-check-circle fs-1 mb-3"></i>
                    <h5>Approved</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalApproved</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-lg bg-secondary text-dark h-70">
                <div class="card-body py-2">
                    <i class="bi bi-hourglass-split fs-1 mb-3"></i>
                    <h5>Pending</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalPending</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-lg bg-warning text-dark h-100">
                <div class="card-body py-2">
                    <i class="bi bi-check-circle fs-1 mb-3"></i>
                    <h5>Paid</h5>
                    <h2 class="display-5 fw-bold">@((int)ViewBag.TotalPaid)</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-lg bg-danger text-white h-100">
                <div class="card-body py-2">
                    <i class="bi bi-hourglass-split fs-1 mb-3"></i>
                    <h5>Rejected</h5>
                    <h2 class="display-5 fw-bold">@ViewBag.TotalRejected</h2>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-lg bg-info text-white h-100">
                <div class="card-body py-2">
                    <i class="bi bi-file-medical fs-1 mb-3"></i>
                    <h5>Total Amount</h5>
                    <h2 class="display-5 fw-bold">₦@((int)ViewBag.TotalClaimAmount)</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="ExportClaims" class="btn btn-success btn-lg shadow-lg px-5">
            <i class="bi bi-file-earmark-excel me-2"></i> Export Claims to Excel
        </a>
    </div>
    <!-- Search & Filter -->
    <div class="card border-0 shadow mb-4 rounded-3">
        <div class="card-body">
            <form asp-action="MyClaims" method="get">
                <div class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control form-control-lg"
                               placeholder="Search by claim number, patient name or ID..." />
                    </div>
                    <div class="col-md-4">
                        <select name="status" class="form-select form-select-lg">
                            <option value="All">All Status</option>
                            <option value="Submitted" selected="@(ViewBag.Status == "Submitted")">Submitted</option>
                            <option value="Under Review" selected="@(ViewBag.Status == "Under Review")">Under Review</option>
                            <option value="Query Raised" selected="@(ViewBag.Status == "Query Raised")">Query Raised</option>
                            <option value="Approved" selected="@(ViewBag.Status == "Approved")">Approved</option>
                            <option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
                            <option value="Rejected" selected="@(ViewBag.Status == "Rejected")">Rejected</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Claims Table -->
    <div class="card border-0 shadow-lg rounded-3">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">All Claims Submitted</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Claim Number</th>
                            <th>Patient</th>
                            <th>Amount</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>HMO</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <h5>No claims found</h5>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@claim.ClaimNumber</td>
                                    <td>@claim.Enrollee?.FullName<br><small>@claim.Enrollee?.EnrollmentNumber</small></td>
                                    <td class="fw-bold text-success">₦@((int)claim.Amount)</td>
                                    <td>@claim.DateSubmitted</td>
                                    <td>
                                        <span class="badge px-3 py-2 fs-6
                                                    @(claim.Status == "Paid" ? "bg-success" :
                                                                                            claim.Status == "Approved" ? "bg-info" :
                                                                                            claim.Status == "Submitted" ? "bg-warning text-dark" :
                                                                                            claim.Status == "Query Raised" ? "bg-secondary" :
                                                                                            claim.Status == "Rejected" ? "bg-danger" : "bg-secondary")">
                                    @claim.Status
                                </span>
                            </td>
                            <td>@claim.Hmos?.Name</td>
                            <td>
                                <a asp-action="ClaimDetails" asp-route-id="@claim.Id" class="btn btn-info btn-sm">View</a>
                            </td>
                        </tr>
                                                }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="MyClaims" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="MyClaims" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="MyClaims" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>