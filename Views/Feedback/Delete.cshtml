@model CTSHIPDashboard.Models.Feedback
@{
    ViewData["Title"] = "Delete Feedback";
}
<h2>Delete Feedback</h2>
<hr />

<div class="alert alert-danger">
    This feedback entry will be permanently deleted.
</div>

<dl class="row">
    <dt class="col-sm-3">From Enrollee</dt>
    <dd class="col-sm-9">@Model.Enrollee?.FullName</dd>

    <dt class="col-sm-3">About Provider</dt>
    <dd class="col-sm-9">@Model.Provider?.Name</dd>

    <dt class="col-sm-3">Satisfaction Score</dt>
    <dd class="col-sm-9">
        <strong>@Model.SatisfactionScore / 10</strong>
        @for (int i = 1; i <= 10; i++)
        {
            if (i <= Model.SatisfactionScore)
            {
                <text>★</text>
            }
            else
            {
                <text>☆</text>
            }
        }
    </dd>

    <dt class="col-sm-3">Comments</dt>
    <dd class="col-sm-9"><em>@Model.Comments</em></dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Resolved ? "bg-success" : "bg-warning")">
            @(Model.Resolved ? "Resolved" : "Pending Resolution")
        </span>
    </dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Delete Feedback</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>