@model CTSHIPDashboard.Models.Feedback

<h1>Create Feedback</h1>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="EnrolleeId"></label>
        <select asp-for="EnrolleeId">
            @foreach (var enrollee in ViewBag.Enrollees)
            {
                <option value="@enrollee.Id">@enrollee.Name</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="ProviderId"></label>
        <select asp-for="ProviderId">
            @foreach (var provider in ViewBag.Providers)
            {
                <option value="@provider.Id">@provider.Name</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="SatisfactionScore"></label>
        <input asp-for="SatisfactionScore" type="number" min="1" max="10" />
    </div>
    <div>
        <label asp-for="Comments"></label>
        <textarea asp-for="Comments"></textarea>
    </div>
    <div>
        <label asp-for="Resolved"></label>
        <input asp-for="Resolved" type="checkbox" />
    </div>
    <button type="submit">Save</button>
</form>