@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

<div class="container-fluid py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 text-success fw-bold mb-0">System Roles</h1>
            <p class="text-muted">Total Roles: <strong>@Model.Count()</strong></p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-lg">
            Create New Role
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-success text-white text-center py-4">
            <h3 class="fw-bold mb-0">All Roles</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>#</th>
                            <th>Role Name</th>
                            <th>Normalized Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted fs-4">
                                    No roles defined yet
                                </td>
                            </tr>
                        }
                        else
                        {
                            int i = 1; 
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@i</td>
                                    <td>
                                        <strong class="text-primary">@role.Name</strong>
                                    </td>
                                    <td><code>@role.NormalizedName</code></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-info btn-sm">
                                            View
                                        </a>
                                        @if (role.Name != "Admin" && role.Name != "SuperAdmin")
                                        {
                                            <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-danger btn-sm ms-2">
                                                Delete
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Protected</span>
                                        }
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>