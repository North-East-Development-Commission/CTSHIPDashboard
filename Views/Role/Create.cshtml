@{
    ViewData["Title"] = "Create New Role";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-success text-white text-center py-5">
                    <h2 class="fw-bold mb-0">CREATE NEW ROLE</h2>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label text-success fw-bold fs-5">Role Name</label>
                            <input type="text" name="roleName" class="form-control form-control-lg rounded-3"
                                   placeholder="e.g., HMO, Provider, Finance" required />
                            <small class="text-muted">Examples: HMO, Provider, Auditor, Finance</small>
                        </div>

                        <div class="text-center mt-5">
                            <button type="submit" class="btn btn-success btn-lg px-7 shadow-lg fw-bold fs-4">
                                CREATE ROLE
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-6 ms-3">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>