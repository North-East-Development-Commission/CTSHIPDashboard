@model CTSHIPDashboard.Models.NewsUpdate
@{
    ViewData["Title"] = "Delete News";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-trash-fill"></i> Confirm Delete News</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong> This news will be permanently deleted.
            </div>
            <h5 class="text-success">@Model.Title</h5>
            <p class="text-muted">@Model.Date.ToString("dd MMM yyyy")</p>
            <p>@Model.Content</p>
            <form asp-action="DeleteNews" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-danger me-2"><i class="bi bi-trash"></i> Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>