@model CTSHIPDashboard.Models.Encounter

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-danger text-white text-center py-5">
                    <h3>Delete Encounter</h3>
                </div>
                <div class="card-body p-5 text-center">
                    <p class="lead">Are you sure you want to delete this encounter?</p>
                    <h5 class="text-danger fw-bold">@Model.EncounterNumber</h5>
                    <p>@Model.Enrollee?.FullName • @Model.VisitDate:dd MMM yyyy</p>
                    <p class="text-warning">This action cannot be undone.</p>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger btn-lg px-6">Yes, Delete</button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-6 ms-3">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>