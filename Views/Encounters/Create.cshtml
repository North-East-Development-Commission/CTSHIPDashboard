@using CTSHIPDashboard.Models.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json
@model CTSHIPDashboard.Models.Encounter
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "New Primary Provider Encounter";
    List<EncounterPrescriptionInputViewModel> prescriptionRows = Model.SelectedPrescriptions.Count > 0
        ? Model.SelectedPrescriptions
        : new List<EncounterPrescriptionInputViewModel> { new() };
    List<SelectListItem> drugInventoryItems = ViewBag.DrugInventoryItems as List<SelectListItem> ?? new List<SelectListItem>();
    IReadOnlyDictionary<string, string> encounterReasonExamples =
        ViewBag.EncounterReasonExamples as IReadOnlyDictionary<string, string> ?? new Dictionary<string, string>();
}

<style>
    .encounter-register-page {
        --ct-green: #3B703B;
        --ct-green-dark: #244a2a;
        --ct-gold: #FE9031;
        --ct-soft: #f5fbf6;
        --ct-border: rgba(59, 112, 59, .18);
        color: #1f3324;
    }

    .encounter-register-page * {
        box-sizing: border-box;
    }

    .encounter-register-page .container-fluid,
    .container-fluid.encounter-register-page {
        width: 100%;
        max-width: 100%;
    }

    .encounter-register-page .card {
        background: #fff;
        border-radius: 1rem;
    }

    .encounter-register-page .form-control,
    .encounter-register-page .form-select {
        display: block;
        width: contain;
        min-height: 2.85rem;
        padding: .65rem .9rem;
        color: #213527;
        background-color: #fff;
        border: 1px solid #ced4da;
        border-radius: .65rem;
    }

    .encounter-register-page textarea.form-control {
        min-height: 7rem;
    }

    .encounter-register-page .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        border-radius: .65rem;
        padding: .7rem 1.2rem;
        border: 1px solid transparent;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .encounter-register-page .btn-outline-secondary {
        color: #47524a;
        border-color: #adb5bd;
        background: #fff;
    }

    .encounter-register-page .input-group {
        display: flex;
        width: 100%;
    }

    .encounter-register-page .input-group .form-control {
        flex: 1 1 auto;
    }

    .encounter-register-page .alert-success {
        color: #244a2a;
        background: #edf7ef;
        border-radius: .9rem;
        padding: 1rem;
    }

    .encounter-shell {
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid var(--ct-border);
        background: #fff;
    }

    .encounter-hero {
        background: linear-gradient(135deg, var(--ct-green-dark), var(--ct-green));
        border-bottom: 5px solid var(--ct-gold);
    }

    .encounter-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, .16);
        color: #fff;
        font-weight: 700;
        font-size: .85rem;
    }

    .encounter-step {
        width: 2.35rem;
        height: 2.35rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        color: #fff;
        background: var(--ct-green);
        box-shadow: 0 .35rem .8rem rgba(59, 112, 59, .22);
        font-weight: 800;
    }

    .encounter-section-card {
        border: 1px solid var(--ct-border);
        border-radius: 22px;
        box-shadow: 0 .75rem 1.5rem rgba(31, 51, 36, .08);
        overflow: hidden;
        background: #fff;
    }

    .encounter-section-header {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1.1rem 1.25rem;
        background: linear-gradient(90deg, rgba(59, 112, 59, .12), rgba(254, 144, 49, .12));
        border-bottom: 1px solid var(--ct-border);
    }

    .encounter-section-header h2 {
        margin: 0;
        color: var(--ct-green-dark);
        font-size: 1.15rem;
        font-weight: 800;
    }

    .encounter-section-header p {
        margin: .15rem 0 0;
        color: #66756a;
        font-size: .92rem;
    }

    .encounter-section-body {
        padding: 1.35rem;
    }

    .encounter-register-page .form-label {
        color: var(--ct-green-dark) !important;
        font-weight: 800;
    }

    .encounter-register-page .form-control:focus,
    .encounter-register-page .form-select:focus {
        border-color: var(--ct-green);
        box-shadow: 0 0 0 .2rem rgba(59, 112, 59, .14);
    }

    .encounter-register-page .btn-success {
        background: var(--ct-green);
        border-color: var(--ct-green);
    }

    .encounter-register-page .btn-success:hover {
        background: var(--ct-green-dark);
        border-color: var(--ct-green-dark);
    }

    .encounter-preview-card {
        border: 2px solid var(--ct-green);
        background: linear-gradient(135deg, #fff, var(--ct-soft));
    }

    .conditional-service-section {
        border: 1px dashed rgba(59, 112, 59, .35);
        border-radius: 18px;
        background: var(--ct-soft);
        padding: 1.1rem;
    }

    .complaint-multiselect-card {
        border: 1px dashed rgba(59, 112, 59, .35);
        border-radius: 18px;
        background: linear-gradient(135deg, #ffffff, var(--ct-soft));
        padding: 1.1rem;
    }

    .encounter-register-page .select2-container {
        width: 100% !important;
    }

    .encounter-register-page .select2-container--default .select2-selection--multiple {
        min-height: 3rem;
        border: 1px solid #ced4da;
        border-radius: .65rem;
        padding: .35rem .45rem;
    }

    .encounter-register-page .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: var(--ct-green);
        box-shadow: 0 0 0 .2rem rgba(59, 112, 59, .14);
    }

    .encounter-register-page .select2-container--default .select2-selection--multiple .select2-selection__choice {
        color: #fff !important;
        background: var(--ct-green) !important;
        border-color: var(--ct-green-dark) !important;
        border-radius: 999px;
        padding: .2rem .55rem;
    }

    .encounter-register-page .select2-container--default .select2-selection--multiple .select2-selection__choice__display,
    .encounter-register-page .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: #fff !important;
    }

    .encounter-register-page .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        margin-right: .35rem;
    }

    body .select2-container--open .select2-dropdown {
        z-index: 2055 !important;
        color: #213527 !important;
        background: #fff !important;
        border: 2px solid #FE9031 !important;
        box-shadow: 0 18px 40px rgba(33, 53, 39, .18) !important;
    }

    body .select2-container--default .select2-results__group {
        color: #244a2a !important;
        background: #f5fbf6 !important;
        font-weight: 800 !important;
        padding: .55rem .8rem !important;
    }

    body .select2-container--default .select2-results__option {
        color: #213527 !important;
        background: #fff !important;
        font-weight: 700 !important;
        line-height: 1.35 !important;
        padding: .65rem .85rem !important;
    }

    body .select2-container--default .select2-results__option--highlighted[aria-selected] {
        color: #fff !important;
        background: #3B703B !important;
    }

    body .select2-container--default .select2-results__option[aria-selected="true"] {
        color: #fff !important;
        background: #FE9031 !important;
    }

    body .select2-container--default .select2-search--dropdown .select2-search__field {
        color: #213527 !important;
        background: #fff !important;
        border: 1px solid rgba(59, 112, 59, .28) !important;
    }

    .encounter-submit-bar {
        position: sticky;
        bottom: 0;
        z-index: 5;
        border-top: 1px solid var(--ct-border);
        background: rgba(255, 255, 255, .94);
        backdrop-filter: blur(8px);
    }
</style>

<div class="container-fluid py-4 encounter-register-page">
    <div class="row justify-content-center">
        <div class="col-12 col-xxl-11">
            <div class="card encounter-shell shadow-lg">
                <div class="encounter-hero text-white p-4 p-lg-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <span class="encounter-chip mb-3"><i class="bi bi-clipboard2-pulse"></i> Electronic Service Encounter Register</span>
                            <h1 class="display-5 fw-bold mb-2">New Primary Provider Encounter</h1>
                            <p class="lead mb-0 opacity-90">Enter the encounter once; the platform generates service, utilisation and capitation indicators.</p>
                        </div>
                        <div class="text-lg-end">
                            <div class="encounter-chip"><i class="bi bi-shield-check"></i> Facility data preserved</div>
                            <div class="encounter-chip mt-2"><i class="bi bi-cash-stack"></i> Capitation submission to HMO</div>
                        </div>
                    </div>
                </div>

                <form asp-action="Create" method="post" id="encounterForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="card-body p-3 p-lg-5">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="d-grid gap-4">
                            <section class="encounter-section-card">
                                <div class="encounter-section-header">
                                    <span class="encounter-step">1</span>
                                    <div>
                                        <h2>Enrollee Identification</h2>
                                        <p>Search once; ID, HMO, sex, age/DOB and location come from enrollment data.</p>
                                    </div>
                                </div>
                                <div class="encounter-section-body">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label for="enrollmentSearch" class="form-label fs-5">Search Enrollee by Enrollment Number <span class="text-danger">*</span></label>
                                            <div class="input-group input-group-lg">
                                                <input type="text" id="enrollmentSearch" class="form-control rounded-start-3" placeholder="e.g., CTH-2025-LA-001234" />
                                                <button type="button" class="btn btn-success rounded-end-3" onclick="searchEnrollee()">
                                                    <i class="bi bi-search me-1"></i>
                                                    Search </button>
                                            </div>
                                            <small class="text-muted">The selected enrollee locks the encounter to the system enrollment record.</small>
                                        </div>

                                        <div class="col-12" id="enrolleePreview" style="display:none;">
                                            <div class="card encounter-preview-card shadow-sm">
                                                <div class="card-body d-flex flex-wrap align-items-center gap-4 p-4">
                                                    <img id="previewPhoto" src="/img/icon-192.png" class="rounded shadow" style="width:130px;height:130px;object-fit:cover;border:5px solid white;" />
                                                    <div class="flex-grow-1">
                                                        <h4 id="previewName" class="text-success fw-bold mb-1">&mdash;</h4>
                                                        <p class="mb-1"><strong>Enrollee ID:</strong> <span id="previewNumber" class="text-primary fw-bold fs-5">&mdash;</span></p>
                                                        <p class="mb-1"><strong>HMO:</strong> <span id="previewHmo">&mdash;</span></p>
                                                        <p class="mb-0"><strong>State:</strong> <span id="previewState">&mdash;</span></p>
                                                        <input type="hidden" asp-for="EnrolleeId" id="selectedEnrolleeId" />
                                                    </div>
                                                    <span class="badge bg-success fs-6 px-3 py-2">Enrollment verified</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="encounter-section-card">
                                <div class="encounter-section-header">
                                    <span class="encounter-step">2</span>
                                    <div>
                                        <h2>Encounter & Provider Information</h2>
                                        <p>Facility is resolved from the provider account and encounter details feed capitation review.</p>
                                    </div>
                                </div>
                                <div class="encounter-section-body">
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label asp-for="VisitDate" class="form-label">Date / Time</label>
                                            <input asp-for="VisitDate" class="form-control form-control-lg" type="datetime-local" step="1" />
                                            <span asp-validation-for="VisitDate" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="VisitType" class="form-label">New / Repeat Visit</label>
                                            <select asp-for="VisitType" class="form-select form-select-lg" asp-items="ViewBag.VisitTypes">
                                                <option value="">Select visit type</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="ReasonForEncounter" class="form-label">Reason for Encounter</label>
                                            <select asp-for="ReasonForEncounter" class="form-select form-select-lg" asp-items="ViewBag.EncounterReasons" aria-describedby="reasonForEncounterHelp">
                                                <option value="">Select reason</option>
                                            </select>
                                            <small id="reasonForEncounterHelp" class="form-text text-muted">Select the patient's stated reason or requested service before diagnosis.</small>
                                            <span asp-validation-for="ReasonForEncounter" class="text-danger"></span>
                                        </div>

                                        <partial name="_ServiceSelection" model="Model" />

                                        <div class="col-md-4">
                                            <label asp-for="Status" class="form-label">Outcome of Encounter</label>
                                            <select asp-for="Status" class="form-select form-select-lg" asp-items="ViewBag.Statuses">
                                                <option value="">Select outcome</option>
                                            </select>
                                            <small class="text-muted">Treated, referred, follow-up or other disposition.</small>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="ProviderId" class="form-label fs-5">Facility</label>
                                            <select asp-for="ProviderId" class="form-select form-select-lg w-100" asp-items="ViewBag.Providers">
                                                <option value="">Select Facility</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="DoctorId" class="form-label">Staff Recording / Attending</label>
                                            <select asp-for="DoctorId" class="form-select form-select-lg" asp-items="ViewBag.Doctors" data-selected-doctor="@Model.DoctorId">
                                                <option value="">Select hospital staff</option>
                                            </select>
                                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="encounter-section-card">
                                <div class="encounter-section-header">
                                    <span class="encounter-step">3</span>
                                    <div>
                                        <h2>Clinical Details</h2>
                                        <p>Capture complaint and diagnosis once; selected values drive reporting indicators.</p>
                                    </div>
                                </div>
                                <div class="encounter-section-body">
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label asp-for="ChiefComplaint" class="form-label">Presenting Complaint</label>
                                            <partial name="_PresentingComplaints" model="Model" />
                                            <textarea asp-for="ChiefComplaint" class="form-control form-control-lg mt-2" rows="3" placeholder="Brief clinical complaint / history"></textarea>
                                            <span asp-validation-for="ChiefComplaint" class="text-danger"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="Diagnosis" class="form-label">Diagnosis</label>
                                            <textarea asp-for="Diagnosis" class="form-control form-control-lg" rows="3" placeholder="Diagnosis or provisional diagnosis"></textarea>
                                            <span asp-validation-for="Diagnosis" class="text-danger"></span>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="TreatmentGiven" class="form-label">Treatment / Clinical Note</label>
                                            <textarea asp-for="TreatmentGiven" class="form-control form-control-lg" rows="3" placeholder="Treatment given, advice, follow-up plan"></textarea>
                                            <span asp-validation-for="TreatmentGiven" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="encounter-section-card">
                                <div class="encounter-section-header">
                                    <span class="encounter-step">4</span>
                                    <div>
                                        <h2>Conditional Service Details</h2>
                                        <p>Medicine, laboratory and referral sections only appear when the encounter requires them.</p>
                                    </div>
                                </div>
                                <div class="encounter-section-body">
                                    <div class="alert alert-success border-0 mb-4">
                                        Select <strong>Laboratory services</strong> to show lab tests/results, <strong>Drug prescription/dispensing</strong> to show medicines, or choose a referred outcome to show referral details.
                                    </div>

                                    <div class="row g-4">
                                        <div class="col-12" id="laboratorySection" style="display:none;">
                                            <div class="conditional-service-section">
                                                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                                                    <div>
                                                        <label class="form-label mb-0">Laboratory Tests</label>
                                                        <div class="small text-muted">Select requested/performed tests and enter results or upload-ready result data when available.</div>
                                                    </div>
                                                </div>

                                                @{ var labCatalog = ViewBag.LaboratoryCatalog as List<SelectListItem> ?? new List<SelectListItem>(); }

                                                <select id="selectedLaboratoryTests" name="SelectedLaboratoryTests" class="form-select select2" multiple data-placeholder="Select laboratory tests">
                                                    @foreach (var item in labCatalog)
                                                    {
                                                        if (item.Selected)
                                                        {
                                                            <option value="@item.Value" selected="selected">@item.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                </select>

                                                <div id="laboratoryInvestigationsContainer" class="mt-3">
                                                    @if (Model.LaboratoryInvestigations != null && Model.LaboratoryInvestigations.Count > 0)
                                                    {
                                                        for (int i = 0; i < Model.LaboratoryInvestigations.Count; i++)
                                                        {
                                                            var row = Model.LaboratoryInvestigations[i];
                                                            <div class="row g-2 align-items-end lab-investigation-row mb-2">
                                                                <input type="hidden" name="LaboratoryInvestigations[@i].LaboratoryTestName" value="@row.LaboratoryTestName" />
                                                                <div class="col-md-4">
                                                                    <label class="form-label small fw-bold">Test</label>
                                                                    <input class="form-control" value="@row.LaboratoryTestName" disabled />
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <label class="form-label small fw-bold">Result</label>
                                                                    <input type="text" name="LaboratoryInvestigations[@i].Result" value="@row.Result" class="form-control" />
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <label class="form-label small fw-bold">Unit</label>
                                                                    <input type="text" name="LaboratoryInvestigations[@i].ResultUnit" value="@row.ResultUnit" class="form-control" />
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <label class="form-label small fw-bold">Status</label>
                                                                    <select name="LaboratoryInvestigations[@i].ResultStatus" class="form-select">
                                                                        @if (row.ResultStatus == "Requested") { <option value="Requested" selected>Requested</option> } else { <option value="Requested">Requested</option> }
                                                                        @if (row.ResultStatus == "SampleCollected") { <option value="SampleCollected" selected>Sample Collected</option> } else { <option value="SampleCollected">Sample Collected</option> }
                                                                        @if (row.ResultStatus == "Processing") { <option value="Processing" selected>Processing</option> } else { <option value="Processing">Processing</option> }
                                                                        @if (row.ResultStatus == "Completed") { <option value="Completed" selected>Completed</option> } else { <option value="Completed">Completed</option> }
                                                                        @if (row.ResultStatus == "Cancelled") { <option value="Cancelled" selected>Cancelled</option> } else { <option value="Cancelled">Cancelled</option> }
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-2 d-grid">
                                                                    <button type="button" class="btn btn-outline-danger remove-lab-row-btn" aria-label="Remove lab row"><i class="bi bi-trash"></i></button>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12" id="prescriptionSection" style="display:none;">
                                            <div class="conditional-service-section">
                                                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                                                    <div>
                                                        <label class="form-label mb-0">Medicines Prescribed / Dispensed</label>
                                                        <div class="small text-muted">Primary provider inventory drugs only; section is hidden until drug prescription is selected.</div>
                                                    </div>
                                                    <button type="button" class="btn btn-outline-success btn-sm" id="addPrescriptionBtn">
                                                        <i class="bi bi-plus-circle me-1"></i> Add Drug
                                                    </button>
                                                </div>
                                                <div id="prescriptionRows" class="d-grid gap-2">
                                                    @for (int i = 0; i < prescriptionRows.Count; i++)
                                                    {
                                                        <div class="row g-2 align-items-end prescription-row">
                                                            <div class="col-md-8">
                                                                <label class="form-label small fw-bold">Drug</label>
                                                                <select name="SelectedPrescriptions[@i].DrugInventoryItemId" class="form-select drug-inventory-select">
                                                                    <option value="">No drug selected</option>
                                                                    @foreach (SelectListItem drug in drugInventoryItems)
                                                                    {
                                                                        if (drug.Value == prescriptionRows[i].DrugInventoryItemId.ToString())
                                                                        {
                                                                            <option value="@drug.Value" selected>@drug.Text</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@drug.Value">@drug.Text</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-label small fw-bold">Quantity</label>
                                                                <input type="number" name="SelectedPrescriptions[@i].QuantityDispensed" value="@prescriptionRows[i].QuantityDispensed" class="form-control prescription-quantity" min="1" />
                                                            </div>
                                                            <div class="col-md-1 d-grid">
                                                                <button type="button" class="btn btn-outline-danger remove-prescription-btn" aria-label="Remove prescription"><i class="bi bi-trash"></i></button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <partial name="_ReferralFields" model="Model.Referral" />
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>

                    <div class="encounter-submit-bar text-center p-4">
                        @if (Model.EnrolleeId <= 0)
                        {
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow fw-bold" id="submitBtn" name="submitAction" value="save" formnovalidate disabled>
                                Save Encounter
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow fw-bold" id="submitBtn" name="submitAction" value="save" formnovalidate>
                                Save Encounter
                            </button>
                        }
                        @if (User.IsInRole("Provider"))
                        {
                            <a asp-controller="Providers" asp-action="MyEncounters" class="btn btn-outline-secondary btn-lg px-5 ms-2">Cancel</a>
                        }
                        @if (User.IsInRole("CTSHIPAdmin"))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 ms-2">Cancel</a>
                        }
                    </div>
                </form>

                <div class="footer-brand text-white text-center py-3">
                    <small>CTSHIP &bull; Universal Health Coverage &bull; Powered by North East Development Commission (NEDC)</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function disableEncounterClientValidation() {
            const form = document.getElementById('encounterForm');
            if (!form || !window.jQuery) return;

            const $form = $(form);
            $form.removeData('validator');
            $form.removeData('unobtrusiveValidation');
            $form.off('.validate');

            $form.find(':input').each(function () {
                Array.from(this.attributes)
                    .filter(attribute => attribute.name.startsWith('data-val'))
                    .forEach(attribute => this.removeAttribute(attribute.name));
                this.classList.remove('input-validation-error', 'is-invalid');
            });
        })();

        const encounterReasonExamples = @Html.Raw(JsonSerializer.Serialize(encounterReasonExamples));
        const defaultEncounterReasonHelp = "Select the patient's stated reason or requested service before diagnosis.";

        function syncEncounterReasonHelp() {
            const reasonSelect = document.getElementById('ReasonForEncounter');
            const helpText = document.getElementById('reasonForEncounterHelp');
            if (!reasonSelect || !helpText) return;

            helpText.textContent = encounterReasonExamples[reasonSelect.value] || defaultEncounterReasonHelp;
        }

        document.getElementById('ReasonForEncounter')?.addEventListener('change', syncEncounterReasonHelp);
        syncEncounterReasonHelp();
        function syncServiceDropdown(selectFirstIfEmpty) {
            const setting = document.getElementById('serviceSetting').value;
            const select = document.getElementById('selectedServices');
            if (!setting || !select) return;

            let hasSelectedEnabledOption = false;

            Array.from(select.querySelectorAll('optgroup')).forEach(group => {
                const enabled = group.dataset.setting === setting;
                Array.from(group.children).forEach(option => {
                    option.disabled = !enabled;
                    if (!enabled) option.selected = false;
                    if (enabled && option.selected) hasSelectedEnabledOption = true;
                });
            });

            if (selectFirstIfEmpty && !hasSelectedEnabledOption) {
                const firstEnabledOption = Array.from(select.options).find(option => !option.disabled);
                if (firstEnabledOption) {
                    firstEnabledOption.selected = true;
                }
            }

            $(select).trigger('change.select2');
            select.dispatchEvent(new Event('change', { bubbles: true }));
        }

        document.getElementById('serviceSetting')?.addEventListener('change', () => {
            syncServiceDropdown(true);
            syncConditionalEncounterSections();
        });
        document.getElementById('selectedServices')?.addEventListener('change', syncConditionalEncounterSections);
        if (window.jQuery) {
            $('#selectedServices').on('change select2:select select2:unselect select2:clear', syncConditionalEncounterSections);
        }
        syncServiceDropdown(true);

        async function searchEnrollee() {
            const query = document.getElementById('enrollmentSearch').value.trim();
            if (!query) return Swal.fire('Error', 'Enter Enrollment Number', 'error');

            try {
                const res = await fetch(`/Encounters/SearchEnrollee?q=${encodeURIComponent(query)}`);
                const data = await res.json();

                if (data.success && data.enrollee) {
                    const e = data.enrollee;
                    document.getElementById('previewPhoto').src = e.photoPath;
                    document.getElementById('previewName').textContent = e.fullName;
                    document.getElementById('previewNumber').textContent = e.enrollmentNumber;
                    document.getElementById('previewHmo').textContent = e.hmoName;
                    document.getElementById('previewState').textContent = e.state;
                    document.getElementById('selectedEnrolleeId').value = e.id;

                    document.getElementById('enrolleePreview').style.display = 'block';
                    document.getElementById('submitBtn').disabled = false;
                } else {
                    Swal.fire('Not Found', 'No enrollee with that number', 'warning');
                    document.getElementById('enrolleePreview').style.display = 'none';
                    document.getElementById('submitBtn').disabled = true;
                }
            } catch {
                Swal.fire('Error', 'Search failed', 'error');
                document.getElementById('enrolleePreview').style.display = 'none';
                document.getElementById('submitBtn').disabled = true;
            }
        }

        document.getElementById('enrollmentSearch')
            .addEventListener('keypress', e => e.key === 'Enter' && (e.preventDefault(), searchEnrollee()));

        // Laboratory investigations dynamic rows
        function reindexLabRows() {
            document.querySelectorAll('.lab-investigation-row').forEach((row, index) => {
                const hidden = row.querySelector('input[type=hidden]');
                if (hidden) hidden.name = `LaboratoryInvestigations[${index}].LaboratoryTestName`;
                const result = row.querySelector('input[name^="LaboratoryInvestigations"][name$=".Result"]') || row.querySelector(`input[name^='LaboratoryInvestigations'][name$='.Result']`);
                if (result) result.name = `LaboratoryInvestigations[${index}].Result`;
                const unit = row.querySelector('input[name^="LaboratoryInvestigations"][name$=".ResultUnit"]');
                if (unit) unit.name = `LaboratoryInvestigations[${index}].ResultUnit`;
                const status = row.querySelector('select[name^="LaboratoryInvestigations"][name$=".ResultStatus"]');
                if (status) status.name = `LaboratoryInvestigations[${index}].ResultStatus`;
            });
        }

        function buildLabRowsFromSelection() {
            const select = document.getElementById('selectedLaboratoryTests');
            const container = document.getElementById('laboratoryInvestigationsContainer');
            if (!select || !container) return;
            const selected = Array.from(select.selectedOptions).map(o => o.value);

            // Preserve existing rows' data
            const existing = {};
            document.querySelectorAll('.lab-investigation-row').forEach(row => {
                const nameInput = row.querySelector('input[type=hidden]');
                const name = nameInput?.value;
                if (!name) return;
                const res = row.querySelector('input[name$=".Result"]')?.value || '';
                const unit = row.querySelector('input[name$=".ResultUnit"]')?.value || '';
                const status = row.querySelector('select[name$=".ResultStatus"]')?.value || 'Requested';
                existing[name] = { res, unit, status };
            });

            // Clear container
            container.innerHTML = '';
            selected.forEach(name => {
                const data = existing[name] || { res: '', unit: '', status: 'Requested' };
                const idx = container.querySelectorAll('.lab-investigation-row').length;
                const div = document.createElement('div');
                div.className = 'row g-2 align-items-end lab-investigation-row mb-2';
                div.innerHTML = `
                    <input type="hidden" name="LaboratoryInvestigations[${idx}].LaboratoryTestName" value="${name}" />
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Test</label>
                        <input class="form-control" value="${name}" disabled />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Result</label>
                        <input type="text" name="LaboratoryInvestigations[${idx}].Result" value="${data.res}" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Unit</label>
                        <input type="text" name="LaboratoryInvestigations[${idx}].ResultUnit" value="${data.unit}" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Status</label>
                        <select name="LaboratoryInvestigations[${idx}].ResultStatus" class="form-select">
                            <option value="Requested" ${data.status === 'Requested' ? 'selected' : ''}>Requested</option>
                            <option value="SampleCollected" ${data.status === 'SampleCollected' ? 'selected' : ''}>Sample Collected</option>
                            <option value="Processing" ${data.status === 'Processing' ? 'selected' : ''}>Processing</option>
                            <option value="Completed" ${data.status === 'Completed' ? 'selected' : ''}>Completed</option>
                            <option value="Cancelled" ${data.status === 'Cancelled' ? 'selected' : ''}>Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-outline-danger remove-lab-row-btn" aria-label="Remove lab row"><i class="bi bi-trash"></i></button>
                    </div>`;
                container.appendChild(div);
            });
            // attach remove handlers
            container.querySelectorAll('.remove-lab-row-btn').forEach(btn => btn.addEventListener('click', e => {
                e.currentTarget.closest('.lab-investigation-row')?.remove();
                reindexLabRows();
            }));
        }

        document.getElementById('selectedLaboratoryTests')?.addEventListener('change', buildLabRowsFromSelection);
        // initialize if there are preselected values
        if (document.getElementById('selectedLaboratoryTests')) {
            buildLabRowsFromSelection();
        }

        async function refreshDoctorDropdown() {
            const providerSelect = document.getElementById('ProviderId');
            const doctorSelect = document.getElementById('DoctorId');
            if (!providerSelect || !doctorSelect) return;

            const selectedDoctorId = doctorSelect.dataset.selectedDoctor || doctorSelect.value;
            doctorSelect.innerHTML = '<option value="">Select hospital staff</option>';

            if (!providerSelect.value) {
                return;
            }

            try {
                const response = await fetch(`/Encounters/GetDoctorsByProvider?providerId=${encodeURIComponent(providerSelect.value)}&selectedDoctorId=${encodeURIComponent(selectedDoctorId || '')}`);
                const data = await response.json();

                if (!data.success || !Array.isArray(data.doctors)) {
                    return;
                }

                data.doctors.forEach(doctor => {
                    const option = document.createElement('option');
                    option.value = doctor.id;
                    option.textContent = doctor.text;
                    option.selected = Boolean(doctor.selected);
                    doctorSelect.appendChild(option);
                });

                if (!doctorSelect.value && data.doctors.length === 1) {
                    doctorSelect.value = data.doctors[0].id;
                }

                doctorSelect.dataset.selectedDoctor = doctorSelect.value;
            } catch {
                doctorSelect.innerHTML = '<option value="">Select hospital staff</option>';
            }
        }

        let drugInventoryOptions = Array.from(document.querySelectorAll('.drug-inventory-select option'))
            .filter(option => option.value)
            .map(option => ({ id: option.value, text: option.textContent }));

        function renderDrugOptions(select, selectedValue) {
            select.innerHTML = '<option value="">No drug selected</option>';
            drugInventoryOptions.forEach(item => {
                const option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.text;
                option.selected = String(item.id) === String(selectedValue || '');
                select.appendChild(option);
            });
        }

        function reindexPrescriptionRows() {
            document.querySelectorAll('.prescription-row').forEach((row, index) => {
                const select = row.querySelector('.drug-inventory-select');
                const quantity = row.querySelector('.prescription-quantity');
                if (select) select.name = `SelectedPrescriptions[${index}].DrugInventoryItemId`;
                if (quantity) quantity.name = `SelectedPrescriptions[${index}].QuantityDispensed`;
            });
        }

        function addPrescriptionRow(selectedDrugId = '', quantity = 1) {
            const container = document.getElementById('prescriptionRows');
            if (!container) return;

            const row = document.createElement('div');
            row.className = 'row g-2 align-items-end prescription-row';
            row.innerHTML = `
                <div class="col-md-8">
                    <label class="form-label small fw-bold">Drug</label>
                    <select class="form-select drug-inventory-select"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Quantity</label>
                    <input type="number" class="form-control prescription-quantity" min="1" value="${quantity || 1}" />
                </div>
                <div class="col-md-1 d-grid">
                    <button type="button" class="btn btn-outline-danger remove-prescription-btn" aria-label="Remove prescription"><i class="bi bi-trash"></i></button>
                </div>`;
            container.appendChild(row);
            renderDrugOptions(row.querySelector('.drug-inventory-select'), selectedDrugId);
            reindexPrescriptionRows();
        }

        async function refreshDrugInventoryDropdowns() {
            const providerSelect = document.getElementById('ProviderId');
            const selectedValues = Array.from(document.querySelectorAll('.drug-inventory-select')).map(select => select.value);

            if (!providerSelect?.value) {
                drugInventoryOptions = [];
            } else {
                try {
                    const response = await fetch(`/Encounters/GetDrugInventoryByProvider?providerId=${encodeURIComponent(providerSelect.value)}`);
                    const data = await response.json();
                    drugInventoryOptions = data.success && Array.isArray(data.items)
                        ? data.items.map(item => ({ id: item.id, text: item.text }))
                        : [];
                } catch {
                    drugInventoryOptions = [];
                }
            }

            document.querySelectorAll('.drug-inventory-select').forEach((select, index) => {
                renderDrugOptions(select, selectedValues[index]);
            });
        }

        async function refreshLaboratoryServices() {
            const providerSelect = document.getElementById('ProviderId');
            const laboratorySelect = document.getElementById('selectedLaboratoryTests');
            if (!laboratorySelect) return;

            const selectedNames = new Set(Array.from(laboratorySelect.selectedOptions).map(option => option.value));
            let items = [];

            if (providerSelect?.value) {
                try {
                    const response = await fetch(`/Encounters/GetLaboratoryServicesByProvider?providerId=${encodeURIComponent(providerSelect.value)}`);
                    const data = await response.json();
                    items = data.success && Array.isArray(data.items) ? data.items : [];
                } catch {
                    items = [];
                }
            }

            laboratorySelect.innerHTML = '';
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.name;
                option.textContent = item.text;
                option.selected = selectedNames.has(item.name);
                laboratorySelect.appendChild(option);
            });

            if (window.jQuery && $(laboratorySelect).data('select2')) {
                $(laboratorySelect).trigger('change.select2');
            }
            buildLabRowsFromSelection();
        }

        function normalizeServiceLabel(value) {
            return (value || '')
                .toString()
                .toLowerCase()
                .replace(/&/g, ' and ')
                .replace(/[\/()–—-]+/g, ' ')
                .replace(/[^a-z0-9]+/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }

        function selectedServiceLabels() {
            const select = document.getElementById('selectedServices');
            if (!select) return [];

            const nativeLabels = Array.from(select.selectedOptions || [])
                .filter(option => !option.disabled)
                .map(option => `${option.value} ${option.textContent}`);

            const select2Labels = window.jQuery && $(select).data('select2')
                ? ($(select).select2('data') || []).map(item => `${item.id || ''} ${item.text || ''}`)
                : [];

            return [...nativeLabels, ...select2Labels]
                .map(normalizeServiceLabel)
                .filter(Boolean);
        }

        function hasSelectedService(exactValue, fallbackTokens) {
            const labels = selectedServiceLabels();
            const exact = normalizeServiceLabel(exactValue);
            const tokens = (fallbackTokens || []).map(normalizeServiceLabel).filter(Boolean);
            return labels.some(label => label === exact || label.includes(exact) || tokens.some(token => label.includes(token)));
        }

        function clearPrescriptionRows() {
            const rows = document.querySelectorAll('.prescription-row');
            rows.forEach((row, index) => {
                if (index > 0) row.remove();
            });
            const firstRow = document.querySelector('.prescription-row');
            if (firstRow) {
                const drug = firstRow.querySelector('.drug-inventory-select');
                const quantity = firstRow.querySelector('.prescription-quantity');
                if (drug) drug.value = '';
                if (quantity) quantity.value = 1;
            }
            reindexPrescriptionRows();
        }

        function syncConditionalEncounterSections() {
            const labRequired = hasSelectedService('Laboratory services', ['laboratory', 'lab']);
            const prescriptionRequired = hasSelectedService('Drug prescription/dispensing', ['prescription', 'dispensing', 'drug']);
            const laboratorySection = document.getElementById('laboratorySection');
            const prescriptionSection = document.getElementById('prescriptionSection');
            const laboratorySelect = document.getElementById('selectedLaboratoryTests');

            if (laboratorySection) laboratorySection.style.display = labRequired ? 'block' : 'none';
            if (!labRequired && laboratorySelect) {
                Array.from(laboratorySelect.options).forEach(option => option.selected = false);
                $(laboratorySelect).trigger('change.select2');
                const labContainer = document.getElementById('laboratoryInvestigationsContainer');
                if (labContainer) labContainer.innerHTML = '';
            } else if (labRequired) {
                buildLabRowsFromSelection();
            }

            if (prescriptionSection) prescriptionSection.style.display = prescriptionRequired ? 'block' : 'none';
            if (!prescriptionRequired) {
                clearPrescriptionRows();
            }
        }

        document.getElementById('addPrescriptionBtn')?.addEventListener('click', () => addPrescriptionRow());
        document.getElementById('prescriptionRows')?.addEventListener('click', event => {
            const button = event.target.closest('.remove-prescription-btn');
            if (!button) return;

            const rows = document.querySelectorAll('.prescription-row');
            if (rows.length === 1) {
                const row = rows[0];
                row.querySelector('.drug-inventory-select').value = '';
                row.querySelector('.prescription-quantity').value = 1;
                return;
            }

            button.closest('.prescription-row')?.remove();
            reindexPrescriptionRows();
        });

        document.getElementById('ProviderId')?.addEventListener('change', async () => {
            const doctorSelect = document.getElementById('DoctorId');
            if (doctorSelect) doctorSelect.dataset.selectedDoctor = '';
            await refreshDoctorDropdown();
            await refreshDrugInventoryDropdowns();
            await refreshLaboratoryServices();
            syncConditionalEncounterSections();
        });
        refreshDoctorDropdown();
        refreshDrugInventoryDropdowns().then(syncConditionalEncounterSections);

        function addValidationError(errors, selector, message) {
            const field = document.querySelector(selector);
            if (field) {
                field.classList.add('is-invalid');
            }
            errors.push(message);
        }

        function isReferralEncounter() {
            const status = (document.getElementById('Status')?.value || '').toLowerCase();
            const visitType = (document.getElementById('VisitType')?.value || '').toLowerCase();
            return status === 'referred' || visitType === 'referral';
        }

        function syncReferralFields() {
            const referralActive = isReferralEncounter();
            const referralFields = document.getElementById('referralFields');
            const requiresReferral = document.getElementById('Referral_RequiresReferral');
            const submitBtn = document.getElementById('submitBtn');
            const statusSelect = document.getElementById('Status');

            if (referralFields) {
                referralFields.style.display = referralActive ? 'block' : 'none';
            }

            if (requiresReferral) {
                requiresReferral.value = referralActive ? 'true' : 'false';
            }

            if (submitBtn) {
                submitBtn.textContent = referralActive ? 'SUBMIT TO HMO' : 'SAVE ENCOUNTER';
            }

            if (referralActive && statusSelect && statusSelect.value.toLowerCase() !== 'referred') {
                const referredOption = Array.from(statusSelect.options)
                    .find(option => option.value.toLowerCase() === 'referred');
                if (referredOption) {
                    statusSelect.value = referredOption.value;
                }
            }
        }

        document.getElementById('Status')?.addEventListener('change', syncReferralFields);
        document.getElementById('VisitType')?.addEventListener('change', syncReferralFields);
        syncReferralFields();
        syncConditionalEncounterSections();

        function validateEncounterForm(event) {
            const form = document.getElementById('encounterForm');
            if (!form) return true;

            form.querySelectorAll('.is-invalid').forEach(field => field.classList.remove('is-invalid'));

            const errors = [];
            const selectedServices = Array.from(document.getElementById('selectedServices')?.selectedOptions || [])
                .filter(option => !option.disabled);
            const visitDateValue = document.getElementById('VisitDate')?.value;

            if (!document.getElementById('selectedEnrolleeId')?.value) {
                errors.push('Search and select a valid enrollee.');
            }

            if (!document.getElementById('ChiefComplaint')?.value.trim()) {
                addValidationError(errors, '#ChiefComplaint', 'Complaint is required.');
            }

            if (!document.getElementById('Diagnosis')?.value.trim()) {
                addValidationError(errors, '#Diagnosis', 'Diagnosis is required.');
            }

            if (!document.getElementById('TreatmentGiven')?.value.trim()) {
                addValidationError(errors, '#TreatmentGiven', 'Treatment given is required.');
            }

            if (!document.getElementById('ReasonForEncounter')?.value) {
                addValidationError(errors, '#ReasonForEncounter', 'Select a reason for encounter.');
            }

            document.querySelectorAll('.prescription-row').forEach(row => {
                const drug = row.querySelector('.drug-inventory-select')?.value;
                const quantity = Number(row.querySelector('.prescription-quantity')?.value || 0);
                if (drug && quantity <= 0) {
                    addValidationError(errors, '.prescription-quantity', 'Prescription quantities must be greater than zero.');
                }
            });

            if (!visitDateValue || new Date(visitDateValue) > new Date()) {
                addValidationError(errors, '#VisitDate', 'Encounter date cannot be in the future.');
            }

            if (selectedServices.length === 0) {
                addValidationError(errors, '#selectedServices', 'Select at least one service delivered.');
            }

            const labRequired = hasSelectedService('Laboratory services', ['laboratory', 'lab']);
            if (labRequired && Array.from(document.getElementById('selectedLaboratoryTests')?.selectedOptions || []).length === 0) {
                addValidationError(errors, '#selectedLaboratoryTests', 'Select at least one laboratory test or remove Laboratory services.');
            }


            if (isReferralEncounter()) {
                if (!document.getElementById('Referral_ReferredHospitalId')?.value) {
                    addValidationError(errors, '#Referral_ReferredHospitalId', 'Select the referred hospital.');
                }

                if (!document.getElementById('Referral_ReasonForReferral')?.value.trim()) {
                    addValidationError(errors, '#Referral_ReasonForReferral', 'Enter the reason for referral.');
                }
            }

            if (errors.length > 0) {
                event.preventDefault();
                Swal.fire('Check Encounter Form', errors.join('<br>'), 'warning');
                return false;
            }

            return true;
        }

        document.getElementById('encounterForm')?.addEventListener('submit', validateEncounterForm);
        function syncPresentingComplaintsOther() {
            const select = document.getElementById('selectedPresentingComplaints');
            const row = document.getElementById('presentingComplaintsOtherRow');
            if (!select || !row) return;

            const hasOther = Array.from(select.selectedOptions)
                .some(option => option.value.toLowerCase() === 'other' || option.textContent.toLowerCase() === 'other');
            row.style.display = hasOther ? 'block' : 'none';
        }

        document.getElementById('selectedPresentingComplaints')?.addEventListener('change', syncPresentingComplaintsOther);
        $('#selectedPresentingComplaints').on('select2:select select2:unselect', syncPresentingComplaintsOther);
        syncPresentingComplaintsOther();
    </script>
  
}
