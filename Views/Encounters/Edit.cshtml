@model CTSHIPDashboard.Models.Encounter
@{
    ViewData["Title"] = "Edit Encounter - " + Model.EncounterNumber;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card border-0 shadow-lg" style="border-radius: 25px; overflow: hidden;">
                <!-- Header -->
                <div class="bg-warning text-dark text-center py-5">
                    <h1 class="display-5 fw-bold mb-2">EDIT ENCOUNTER</h1>
                    <p class="lead mb-0 opacity-90">Encounter #: <strong class="text-primary">@Model.EncounterNumber</strong></p>
                </div>

                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post" id="encounterForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EncounterNumber" />
                        <input type="hidden" asp-for="EnrolleeId" />
                        <input type="hidden" asp-for="ClaimId" />

                        <!-- ENROLLEE INFO (READ-ONLY) -->
                        <div class="row g-4 mb-4">
                            <div class="col-12">
                                <div class="card border-success border-3 shadow">
                                    <div class="card-body d-flex align-items-center p-4">
                                        <img src="@EnrolleePhotoStorage.ResolvePhotoPath(Model.Enrollee?.PhotoPath, Model.Enrollee?.EnrollmentNumber)"
                                             class="rounded me-4 shadow" style="width:120px;height:120px;object-fit:cover;border:5px solid white;" />
                                        <div>
                                            <h4 class="text-success fw-bold mb-1">@Model.Enrollee?.FullName</h4>
                                            <p class="mb-1"><strong>ID:</strong> @Model.Enrollee?.EnrollmentNumber</p>
                                            <p class="mb-1"><strong>HMO:</strong> @Model.Enrollee?.Hmo?.Name</p>
                                            <p class="mb-0"><strong>State:</strong> @Model.Enrollee?.State</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <!-- VISIT DETAILS -->
                            <div class="col-md-4">
                                <label asp-for="VisitDate" class="form-label text-success fw-bold">Visit Date & Time</label>
                                <input asp-for="VisitDate" class="form-control form-control-lg" type="datetime-local" step="1" />
                                <span asp-validation-for="VisitDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="VisitType" class="form-label text-success fw-bold">Visit Type</label>
                                <select asp-for="VisitType" class="form-select form-select-lg" asp-items="ViewBag.VisitTypes">
                                    <option value="">Select visit type</option>
                                </select>
                            </div>
                            <partial name="_ServiceSelection" model="Model" />

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label text-success fw-bold">Status</label>
                                <select asp-for="Status" class="form-select form-select-lg" asp-items="ViewBag.Statuses">
                                    <option value="">Select Status</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ProviderId" class="form-label text-success fw-bold">Facility</label>
                                <select asp-for="ProviderId" class="form-select form-select-lg" asp-items="ViewBag.Providers">
                                    <option value="">Select Facility</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DoctorId" class="form-label text-success fw-bold">Attended By (Hospital Staff)</label>
                                <select asp-for="DoctorId" class="form-select form-select-lg" asp-items="ViewBag.Doctors" data-selected-doctor="@Model.DoctorId">
                                    <option value="">Select hospital staff</option>
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AttendedBy" class="form-label text-success fw-bold">Recorded By</label>
                                <input asp-for="AttendedBy" class="form-control form-control-lg" readonly />
                            </div>

                            <!-- CLINICAL -->
                            <div class="col-12">
                                <label asp-for="ChiefComplaint" class="form-label text-success fw-bold">Chief Complaint</label>
                                <textarea asp-for="ChiefComplaint" class="form-control form-control-lg" rows="3" ></textarea>
                                <span asp-validation-for="ChiefComplaint" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Diagnosis" class="form-label text-success fw-bold">Diagnosis</label>
                                <textarea asp-for="Diagnosis" class="form-control form-control-lg" rows="4" ></textarea>
                                <span asp-validation-for="Diagnosis" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="TreatmentGiven" class="form-label text-success fw-bold">Treatment Given</label>
                                <textarea asp-for="TreatmentGiven" class="form-control form-control-lg" rows="5" ></textarea>
                                <span asp-validation-for="TreatmentGiven" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label text-success fw-bold">Additional Notes</label>
                                <textarea asp-for="Notes" class="form-control form-control-lg" rows="3"></textarea>
                            </div>
                        </div>

                        <!-- SUBMIT -->
                        <div class="text-center mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-success btn-lg px-6 shadow-lg fw-bold fs-4" name="submitAction" value="save" formnovalidate>
                                UPDATE ENCOUNTER
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info btn-lg px-6 ms-3">
                                View Details
                            </a>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-6 ms-3">
                                Back to List
                            </a>
                        </div>
                    </form>
                </div>

                <div class="bg-dark text-white text-center py-3">
                    <small>CTSHIP • Universal Health Coverage • Powered by North East Development Commission (NEDC)</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function disableEncounterClientValidation() {
            const form = document.getElementById('encounterForm');
            if (!form || !window.jQuery) return;

            const $form = $(form);
            $form.removeData('validator');
            $form.removeData('unobtrusiveValidation');
            $form.off('.validate');

            $form.find(':input').each(function () {
                Array.from(this.attributes)
                    .filter(attribute => attribute.name.startsWith('data-val'))
                    .forEach(attribute => this.removeAttribute(attribute.name));
                this.classList.remove('input-validation-error', 'is-invalid');
            });
        })();

        function syncServiceDropdown(selectFirstIfEmpty) {
            const setting = document.getElementById('serviceSetting').value;
            const select = document.getElementById('selectedServices');
            if (!setting || !select) return;

            let hasSelectedEnabledOption = false;

            Array.from(select.querySelectorAll('optgroup')).forEach(group => {
                const enabled = group.dataset.setting === setting;
                Array.from(group.children).forEach(option => {
                    option.disabled = !enabled;
                    if (!enabled) option.selected = false;
                    if (enabled && option.selected) hasSelectedEnabledOption = true;
                });
            });

            if (selectFirstIfEmpty && !hasSelectedEnabledOption) {
                const firstEnabledOption = Array.from(select.options).find(option => !option.disabled);
                if (firstEnabledOption) {
                    firstEnabledOption.selected = true;
                }
            }

            $(select).trigger('change.select2');
        }

        document.getElementById('serviceSetting')?.addEventListener('change', () => syncServiceDropdown(true));
        syncServiceDropdown(false);

        async function refreshDoctorDropdown() {
            const providerSelect = document.getElementById('ProviderId');
            const doctorSelect = document.getElementById('DoctorId');
            if (!providerSelect || !doctorSelect) return;

            const selectedDoctorId = doctorSelect.dataset.selectedDoctor || doctorSelect.value;
            doctorSelect.innerHTML = '<option value="">Select hospital staff</option>';

            if (!providerSelect.value) {
                return;
            }

            try {
                const response = await fetch(`/Encounters/GetDoctorsByProvider?providerId=${encodeURIComponent(providerSelect.value)}&selectedDoctorId=${encodeURIComponent(selectedDoctorId || '')}`);
                const data = await response.json();

                if (!data.success || !Array.isArray(data.doctors)) {
                    return;
                }

                data.doctors.forEach(doctor => {
                    const option = document.createElement('option');
                    option.value = doctor.id;
                    option.textContent = doctor.text;
                    option.selected = Boolean(doctor.selected);
                    doctorSelect.appendChild(option);
                });

                if (!doctorSelect.value && data.doctors.length === 1) {
                    doctorSelect.value = data.doctors[0].id;
                }

                doctorSelect.dataset.selectedDoctor = doctorSelect.value;
            } catch {
                doctorSelect.innerHTML = '<option value="">Select hospital staff</option>';
            }
        }

        document.getElementById('ProviderId')?.addEventListener('change', async () => {
            const doctorSelect = document.getElementById('DoctorId');
            if (doctorSelect) doctorSelect.dataset.selectedDoctor = '';
            await refreshDoctorDropdown();
        });
        refreshDoctorDropdown();

        function addValidationError(errors, selector, message) {
            const field = document.querySelector(selector);
            if (field) {
                field.classList.add('is-invalid');
            }
            errors.push(message);
        }

        function validateEncounterForm(event) {
            const form = document.getElementById('encounterForm');
            if (!form) return true;

            form.querySelectorAll('.is-invalid').forEach(field => field.classList.remove('is-invalid'));

            const errors = [];
            const selectedServices = Array.from(document.getElementById('selectedServices')?.selectedOptions || [])
                .filter(option => !option.disabled);
            const visitDateValue = document.getElementById('VisitDate')?.value;

            if (!document.getElementById('ChiefComplaint')?.value.trim()) {
                addValidationError(errors, '#ChiefComplaint', 'Complaint is required.');
            }

            if (!document.getElementById('Diagnosis')?.value.trim()) {
                addValidationError(errors, '#Diagnosis', 'Diagnosis is required.');
            }

            if (!document.getElementById('TreatmentGiven')?.value.trim()) {
                addValidationError(errors, '#TreatmentGiven', 'Treatment given is required.');
            }

            if (!visitDateValue || new Date(visitDateValue) > new Date()) {
                addValidationError(errors, '#VisitDate', 'Encounter date cannot be in the future.');
            }

            if (selectedServices.length === 0) {
                addValidationError(errors, '#selectedServices', 'Select at least one service delivered.');
            }

            if (errors.length > 0) {
                event.preventDefault();
                Swal.fire('Check Encounter Form', errors.join('<br>'), 'warning');
                return false;
            }

            return true;
        }

        document.getElementById('encounterForm')?.addEventListener('submit', validateEncounterForm);

    </script>
}
