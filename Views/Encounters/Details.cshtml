@model CTSHIPDashboard.Models.Encounter

@{
    bool canUseClaims = ViewBag.CanUseClaims == true;
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="bg-success text-white text-center py-5">
                    <h1 class="display-5 fw-bold mb-2">ENCOUNTER DETAILS</h1>
                    <p class="lead mb-0">@Model.EncounterNumber</p>
                </div>

                <div class="card-body p-5">
                    <div class="row g-5">
                        <div class="col-md-5">
                            <div class="card border-success shadow">
                                <div class="card-body text-center p-4">
                                    <img src="@EnrolleePhotoStorage.ResolvePhotoPath(Model.Enrollee?.PhotoPath, Model.Enrollee?.EnrollmentNumber)"
                                         class="rounded-circle shadow" style="width:180px;height:180px;object-fit:cover;border:6px solid #3B703B;" />
                                    <h4 class="mt-4 fw-bold">@Model.Enrollee?.FullName</h4>
                                    <p>ID: @Model.Enrollee?.EnrollmentNumber</p>
                                    <p>HMO: @Model.Enrollee?.Hmo?.Name</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <h5 class="text-success fw-bold">Laboratory Investigations</h5>
                                    @if (string.IsNullOrWhiteSpace(Model.LabTests))
                                    {
                                        <p class="text-muted mb-0">No laboratory investigations recorded.</p>
                                    }
                                    else
                                    {
                                        var labText = Model.LabTests ?? string.Empty;
                                        var parts = labText.Split(new[] { " - " }, StringSplitOptions.None);
                                        var testsPart = parts.Length > 0 ? parts[0] : string.Empty;
                                        var resultsPart = parts.Length > 1 ? parts[1] : string.Empty;
                                        var tests = testsPart.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
                                        var results = resultsPart.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();

                                        <div>
                                            <strong>Requested Tests:</strong>
                                            @if (tests.Count == 0)
                                            {
                                                <span class="text-muted">None</span>
                                            }
                                            else
                                            {
                                                foreach (var t in tests)
                                                {
                                                    <span class="badge bg-primary me-1 mb-1">@t</span>
                                                }
                                            }
                                        </div>

                                        @if (results.Count > 0)
                                        {
                                            <hr />
                                            <div>
                                                <strong>Results:</strong>
                                                <ul class="mb-0 mt-2">
                                                    @foreach (var r in results)
                                                    {
                                                        <li>@r</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Visit Information</h5>
                                            <p><strong>Date:</strong> @Model.VisitDate.Date</p>
                                            <p><strong>Type:</strong> @Model.VisitType</p>
                                            <p><strong>Reason:</strong> @Model.ReasonForEncounter</p>
                                            <p><strong>Patient Outcome:</strong> <span class="badge bg-success">@Model.PatientOutcome</span></p>
                                            <div>
                                                <strong>Services Provided:</strong>
                                                @foreach (var service in Model.Services)
                                                {
                                                    <span class="badge bg-primary me-1 mb-1">@service.ServiceName</span>
                                                }
                                            </div>
                                            <p><strong>Provider:</strong> @Model.Provider?.Name</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Clinical Details</h5>
                                            <p><strong>Complaint:</strong> @Model.ChiefComplaint</p>
                                            <p><strong>Diagnosis:</strong> @Model.Diagnosis</p>
                                            <p><strong>Treatment:</strong> @Model.TreatmentGiven</p>
                                            @if (!string.IsNullOrWhiteSpace(Model.DiagnosisOther))
                                            {
                                                <p><strong>Other Diagnosis:</strong> @Model.DiagnosisOther</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Model.LaboratoryOther))
                                            {
                                                <p><strong>Other Laboratory Service:</strong> @Model.LaboratoryOther</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Model.SelectedMedicinesData))
                                            {
                                                <p><strong>Medicines:</strong> @Model.SelectedMedicinesData.Replace(" | ", ", ")</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Model.PreventiveServicesData))
                                            {
                                                <p><strong>Preventive Services:</strong> @Model.PreventiveServicesData.Replace(" | ", ", ")</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Model.ImmunizationsData))
                                            {
                                                <p><strong>Immunizations:</strong> @Model.ImmunizationsData.Replace(" | ", ", ")</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Model.ScreeningTestsData))
                                            {
                                                <p><strong>Screening Tests:</strong> @Model.ScreeningTestsData.Replace(" | ", ", ")</p>
                                            }
                                            <p>
                                                <strong>Attended By:</strong> @(Model.Doctor?.FullName ?? Model.SeenBy)<br />
                                                <strong>Specialty / Unit:</strong> @(Model.Doctor?.Specialty ?? Model.Rank)
                                            </p>
                                            <p><strong>Recorded By:</strong> @Model.AttendedBy</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Prescriptions</h5>
                                            @if (Model.Prescriptions.Count == 0)
                                            {
                                                <p class="text-muted mb-0">No inventory prescriptions recorded.</p>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm align-middle mb-0">
                                                        <thead>
                                                            <tr><th>Drug</th><th>Quantity</th><th>Deducted</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var prescription in Model.Prescriptions)
                                                            {
                                                                <tr>
                                                                    <td>@prescription.DrugName @prescription.Strength @prescription.DosageForm</td>
                                                                    <td>@prescription.QuantityDispensed.ToString("N0") @prescription.UnitOfMeasure</td>
                                                                    <td><span class="badge @(prescription.InventoryDeducted ? "bg-success" : "bg-warning text-dark")">@(prescription.InventoryDeducted ? "Yes" : "Pending")</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-6">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
