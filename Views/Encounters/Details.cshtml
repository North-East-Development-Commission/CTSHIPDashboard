@model CTSHIPDashboard.Models.Encounter

@{
    bool canUseClaims = ViewBag.CanUseClaims == true;
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="bg-success text-white text-center py-5">
                    <h1 class="display-5 fw-bold mb-2">ENCOUNTER DETAILS</h1>
                    <p class="lead mb-0">@Model.EncounterNumber</p>
                </div>

                <div class="card-body p-5">
                    <div class="row g-5">
                        <div class="col-md-5">
                            <div class="card border-success shadow">
                                <div class="card-body text-center p-4">
                                    <img src="@EnrolleePhotoStorage.ResolvePhotoPath(Model.Enrollee?.PhotoPath, Model.Enrollee?.EnrollmentNumber)"
                                         class="rounded-circle shadow" style="width:180px;height:180px;object-fit:cover;border:6px solid #3B703B;" />
                                    <h4 class="mt-4 fw-bold">@Model.Enrollee?.FullName</h4>
                                    <p>ID: @Model.Enrollee?.EnrollmentNumber</p>
                                    <p>HMO: @Model.Enrollee?.Hmo?.Name</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Visit Information</h5>
                                            <p><strong>Date:</strong> @Model.VisitDate.Date</p>
                                            <p><strong>Type:</strong> @Model.VisitType</p>
                                            <p><strong>Reason:</strong> @Model.ReasonForEncounter</p>
                                            <p><strong>Service Setting:</strong> @Model.ServiceSetting</p>
                                            <div>
                                                <strong>Services Delivered:</strong>
                                                @foreach (var service in Model.Services)
                                                {
                                                    <span class="badge bg-primary me-1 mb-1">@service.ServiceName</span>
                                                }
                                            </div>
                                            <p><strong>Provider:</strong> @Model.Provider?.Name</p>
                                            <p>
                                                <strong>Status:</strong>
                                                <span class="badge bg-success fs-6">@Model.Status</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Clinical Details</h5>
                                            <p><strong>Complaint:</strong> @Model.ChiefComplaint</p>
                                            <p><strong>Diagnosis:</strong> @Model.Diagnosis</p>
                                            <p><strong>Treatment:</strong> @Model.TreatmentGiven</p>
                                            <p>
                                                <strong>Attended By:</strong> @(Model.Doctor?.FullName ?? Model.SeenBy)<br />
                                                <strong>Specialty / Unit:</strong> @(Model.Doctor?.Specialty ?? Model.Rank)
                                            </p>
                                            <p><strong>Recorded By:</strong> @Model.AttendedBy</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Prescriptions</h5>
                                            @if (Model.Prescriptions.Count == 0)
                                            {
                                                <p class="text-muted mb-0">No inventory prescriptions recorded.</p>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm align-middle mb-0">
                                                        <thead>
                                                            <tr><th>Drug</th><th>Quantity</th><th>Deducted</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var prescription in Model.Prescriptions)
                                                            {
                                                                <tr>
                                                                    <td>@prescription.DrugName @prescription.Strength @prescription.DosageForm</td>
                                                                    <td>@prescription.QuantityDispensed.ToString("N0") @prescription.UnitOfMeasure</td>
                                                                    <td><span class="badge @(prescription.InventoryDeducted ? "bg-success" : "bg-warning text-dark")">@(prescription.InventoryDeducted ? "Yes" : "Pending")</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="card @(Model.ClaimId == null ? "border-warning" : "border-success") shadow-sm">
                                        <div class="card-body text-center py-4">
                                            <h5>Total Amount</h5>
                                            <h2 class="display-5 fw-bold text-success">&#8358;@((int)Model.TotalAmount)</h2>
                                            @if (Model.ClaimId == null)
                                            {
                                                <p class="text-warning fw-bold">Not yet claimed</p>
                                            }
                                            else
                                            {
                                                <p class="text-success fw-bold">Claim Submitted</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        @if (User.IsInRole("Provider") && canUseClaims && Model.ClaimId == null && Model.Status != "Cancelled")
                        {
                            <a asp-action="CreateClaim" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-6 me-2">Submit Claim</a>
                        }
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-6">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
