@model CTSHIPDashboard.Models.Encounter
@{
    var items = ViewBag.PresentingComplaints as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="complaint-multiselect-card mb-3">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
        <div>
            <label for="selectedPresentingComplaints" class="form-label mb-0">Presenting Complaints</label>
            <div class="small text-muted">Use the dropdown to select one or more complaints. Choose Other to add a custom complaint.</div>
        </div>
        <span class="badge rounded-pill text-bg-success">Multi-select</span>
    </div>

    <select id="selectedPresentingComplaints"
            name="SelectedPresentingComplaints"
            class="form-select form-select-lg select2"
            multiple
            data-placeholder="Select presenting complaints">
        @foreach (var item in items)
        {
            if (item.Selected)
            {
                <option value="@item.Value" selected="selected">@item.Text</option>
            }
            else
            {
                <option value="@item.Value">@item.Text</option>
            }
        }
    </select>

    <div class="row mt-3" id="presentingComplaintsOtherRow" style="display:none;">
        <div class="col-md-8 col-lg-6">
            <label for="PresentingComplaintsOther" class="form-label small">Other complaint</label>
            <input type="text"
                   name="PresentingComplaintsOther"
                   id="PresentingComplaintsOther"
                   class="form-control form-control-lg"
                   placeholder="Specify other presenting complaint"
                   value="@Model.PresentingComplaintsOther" />
        </div>
    </div>
</div>
