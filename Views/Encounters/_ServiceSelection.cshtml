@model CTSHIPDashboard.Models.Encounter

<input type="hidden" asp-for="ServiceSetting" value="Outpatient" />
<div class="col-12">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
        <div>
            <label for="selectedServices" class="form-label mb-0">Services Provided</label>
            <div class="small text-muted">Select every clinical service provided during this capitation encounter.</div>
        </div>
        <span class="badge rounded-pill text-bg-success">Multi-select</span>
    </div>
    <select asp-for="SelectedServices" class="form-select form-select-lg select2" id="selectedServices" multiple data-placeholder="Select services provided">
        @foreach (string service in ViewBag.OutpatientServices)
        {
            <option value="@service" selected="@(Model.SelectedServices.Contains(service, StringComparer.OrdinalIgnoreCase) ? "selected" : null)">@service</option>
        }
    </select>
    <span asp-validation-for="SelectedServices" class="text-danger"></span>
    <div id="servicesProvidedOtherRow" class="mt-3" style="display:none;">
        <label asp-for="ServicesProvidedOther" class="form-label">Other service provided</label>
        <input asp-for="ServicesProvidedOther" class="form-control form-control-lg" placeholder="Specify the other service" />
    </div>
</div>
