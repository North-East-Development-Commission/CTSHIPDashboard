@model CTSHIPDashboard.ViewModels.EncounterReferralInputViewModel
@using CTSHIPDashboard.Enums

<div class="col-12" id="referralFields" style="display:none;">
    <div class="card border-success border-2 shadow-sm">
        <div class="card-header bg-success text-white">
            <strong>Referral Details</strong>
        </div>
        <div class="card-body">
            <input type="hidden"
                   id="Referral_RequiresReferral"
                   name="Referral.RequiresReferral"
                   value="@(Model.RequiresReferral.ToString().ToLowerInvariant())" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="Referral_ReferredHospitalId" class="form-label text-success fw-bold">Referred Hospital</label>
                    <select id="Referral_ReferredHospitalId" name="Referral.ReferredHospitalId" class="form-select form-select-lg">
                        <option value="">Select referred hospital</option>
                        @foreach (var hospital in Model.ReferredHospitals)
                        {
                            <option value="@hospital.Value" selected="@hospital.Selected">@hospital.Text</option>
                        }
                    </select>
                    <span class="text-danger" data-valmsg-for="Referral.ReferredHospitalId" data-valmsg-replace="true"></span>
                </div>

                <div class="col-md-6">
                    <label for="Referral_Priority" class="form-label text-success fw-bold">Priority</label>
                    <select id="Referral_Priority" name="Referral.Priority" class="form-select form-select-lg">
                        @foreach (var priority in Html.GetEnumSelectList<ReferralPriority>())
                        {
                            bool selected = priority.Value == ((int)Model.Priority).ToString();
                            <option value="@priority.Value" selected="@selected">@priority.Text</option>
                        }
                    </select>
                    <span class="text-danger" data-valmsg-for="Referral.Priority" data-valmsg-replace="true"></span>
                </div>

                <div class="col-12">
                    <label for="Referral_ReasonForReferral" class="form-label text-success fw-bold">Reason For Referral</label>
                    <textarea id="Referral_ReasonForReferral"
                              name="Referral.ReasonForReferral"
                              class="form-control form-control-lg"
                              rows="3">@Model.ReasonForReferral</textarea>
                    <span class="text-danger" data-valmsg-for="Referral.ReasonForReferral" data-valmsg-replace="true"></span>
                </div>
            </div>
        </div>
    </div>
</div>
