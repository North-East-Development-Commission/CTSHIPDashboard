@model CTSHIPDashboard.ViewModels.EncounterReferralInputViewModel
@using CTSHIPDashboard.Enums

<div class="card mt-3">
    <div class="card-header">
        <strong>Referral</strong>
    </div>
    <div class="card-body">
        <div class="form-check mb-3">
            <input asp-for="RequiresReferral" class="form-check-input" />
            <label asp-for="RequiresReferral" class="form-check-label"></label>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ReferredHospitalId" class="form-label"></label>
                <select asp-for="ReferredHospitalId" asp-items="Model.ReferredHospitals" class="form-select">
                    <option value="">-- Select Referred Hospital --</option>
                </select>
                <span asp-validation-for="ReferredHospitalId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ReferralPriority>()" class="form-select"></select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Diagnosis" class="form-label"></label>
                <input asp-for="Diagnosis" class="form-control" />
                <span asp-validation-for="Diagnosis" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="ReasonForReferral" class="form-label"></label>
                <textarea asp-for="ReasonForReferral" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ReasonForReferral" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="ClinicalSummary" class="form-label"></label>
                <textarea asp-for="ClinicalSummary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ClinicalSummary" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TreatmentGiven" class="form-label"></label>
                <textarea asp-for="TreatmentGiven" class="form-control" rows="3"></textarea>
                <span asp-validation-for="TreatmentGiven" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="InvestigationSummary" class="form-label"></label>
                <textarea asp-for="InvestigationSummary" class="form-control" rows="3"></textarea>
                <span asp-validation-for="InvestigationSummary" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>
