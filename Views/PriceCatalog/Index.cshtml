@model CTSHIPDashboard.ViewModels.ReferralPriceCatalogIndexViewModel
@{
    ViewData["Title"] = "Referral Price Catalog";
    bool canManageCatalogItems = User.IsInRole("Admin");
}

<div class="ct-page catalog-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2>Referral Price Catalog</h2>
            <p class="mb-0">Prescription, laboratory, and surgery prices by provider state.</p>
        </div>
        <a asp-controller="Analytics" asp-action="Index" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Admin Dashboard
        </a>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <form asp-controller="PriceCatalog" asp-action="BulkUpload" method="post" enctype="multipart/form-data" class="card card-body">
                @Html.AntiForgeryToken()
                <h5 class="mb-3">Bulk Add Prices</h5>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="BulkUpload.State" class="form-label fw-semibold"></label>
                    <select asp-for="BulkUpload.State" asp-items="Model.StateOptions" class="form-select"></select>
                    <span asp-validation-for="BulkUpload.State" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BulkUpload.Category" class="form-label fw-semibold"></label>
                    <select asp-for="BulkUpload.Category" asp-items="Model.CategoryOptions" class="form-select"></select>
                    <span asp-validation-for="BulkUpload.Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BulkUpload.ExcelFile" class="form-label fw-semibold"></label>
                    <input asp-for="BulkUpload.ExcelFile" type="file" accept=".xlsx" class="form-control" />
                    <span asp-validation-for="BulkUpload.ExcelFile" class="text-danger"></span>
                    <div class="form-text">Use columns <code>Title</code> and <code>PriceInNaira</code>.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="BulkUpload.ItemsText" class="form-label fw-semibold"></label>
                    <textarea asp-for="BulkUpload.ItemsText"
                              class="form-control"
                              rows="10"
                              placeholder="Paracetamol 500mg tablets, 1500&#10;Full blood count, 3000"></textarea>
                    <span asp-validation-for="BulkUpload.ItemsText" class="text-danger"></span>
                    <div class="form-text">One item per line. Use comma, tab, or pipe between title and price.</div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="BulkUpload.ReplaceExisting" class="form-check-input" />
                    <label asp-for="BulkUpload.ReplaceExisting" class="form-check-label"></label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-cloud-arrow-up-fill"></i> Save Catalog
                    </button>
                    <a asp-controller="PriceCatalog" asp-action="DownloadTemplate" class="btn btn-outline-success">
                        <i class="bi bi-file-earmark-excel"></i> Download Excel Template
                    </a>
                </div>
            </form>
        </div>

        <div class="col-lg-8">
            <div class="card card-body mb-3">
                <form asp-controller="PriceCatalog" asp-action="Index" method="get" class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label for="state" class="form-label fw-semibold">State</label>
                        <select id="state" name="state" asp-items="Model.FilterStateOptions" class="form-select"></select>
                    </div>
                    <div class="col-md-5">
                        <label for="category" class="form-label fw-semibold">Category</label>
                        <select id="category" name="category" asp-items="Model.FilterCategoryOptions" class="form-select"></select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-search"></i> Filter
                        </button>
                    </div>
                </form>
            </div>

            <div class="card catalog-table-card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong>Catalog Items</strong>
                    <span class="badge bg-success">@Model.Items.Count item(s)</span>
                </div>
                <div class="table-responsive catalog-table-wrapper">
                    <table class="table table-hover align-middle mb-0 catalog-table">
                        <thead class="table-light">
                            <tr>
                                <th>State</th>
                                <th>Category</th>
                                <th>Title</th>
                                <th class="text-end">Price (NGN)</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        No catalog items found for the selected filter.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Items)
                                {
                                    string editPriceValue = item.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    <tr>
                                        <td>@item.State</td>
                                        <td>@item.Category</td>
                                        <td>@item.Title</td>
                                        <td class="text-end">NGN @item.Price.ToString("N2")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end catalog-actions">
                                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                                <form asp-controller="PriceCatalog" asp-action="ToggleActive" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                                    <input type="hidden" name="state" value="@Model.State" />
                                                    <input type="hidden" name="category" value="@Model.Category" />
                                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                                        @if (item.IsActive)
                                                        {
                                                            <i class="bi bi-pause-circle"></i>
                                                            <span>Deactivate</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-play-circle"></i>
                                                            <span>Activate</span>
                                                        }
                                                    </button>
                                                </form>

                                                @if (canManageCatalogItems)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#editCatalogItem-@item.Id"
                                                            aria-expanded="false"
                                                            aria-controls="editCatalogItem-@item.Id">
                                                        <i class="bi bi-pencil-square"></i> Edit
                                                    </button>
                                                    <form asp-controller="PriceCatalog"
                                                          asp-action="Delete"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('Delete this catalog item?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="state" value="@Model.State" />
                                                        <input type="hidden" name="category" value="@Model.Category" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    @if (canManageCatalogItems)
                                    {
                                        <tr class="catalog-edit-row">
                                            <td colspan="6" class="p-0">
                                                <div class="collapse" id="editCatalogItem-@item.Id">
                                                    <div class="catalog-edit-panel">
                                                        <form asp-controller="PriceCatalog"
                                                              asp-action="Edit"
                                                              method="post"
                                                              class="row g-2 align-items-end">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="Id" value="@item.Id" />
                                                            <input type="hidden" name="State" value="@Model.State" />
                                                            <input type="hidden" name="Category" value="@Model.Category" />
                                                            <div class="col-lg-7">
                                                                <label class="form-label fw-semibold" for="catalog-title-@item.Id">Title</label>
                                                                <input id="catalog-title-@item.Id"
                                                                       name="Title"
                                                                       value="@item.Title"
                                                                       maxlength="200"
                                                                       class="form-control"
                                                                       required />
                                                            </div>
                                                            <div class="col-lg-3">
                                                                <label class="form-label fw-semibold" for="catalog-price-@item.Id">Price in Naira</label>
                                                                <input id="catalog-price-@item.Id"
                                                                       name="Price"
                                                                       value="@editPriceValue"
                                                                       type="number"
                                                                       min="0"
                                                                       step="0.01"
                                                                       class="form-control text-end"
                                                                       required />
                                                            </div>
                                                            <div class="col-lg-2 d-flex gap-2">
                                                                <button type="submit" class="btn btn-success flex-fill">
                                                                    <i class="bi bi-check2-circle"></i> Save
                                                                </button>
                                                                <button type="button"
                                                                        class="btn btn-outline-secondary"
                                                                        data-bs-toggle="collapse"
                                                                        data-bs-target="#editCatalogItem-@item.Id"
                                                                        aria-controls="editCatalogItem-@item.Id">
                                                                    Cancel
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
