@model List<CTSHIPDashboard.Models.ApplicationUser>
@{ ViewData["Title"] = "Facility Accounts"; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
    <h1 class="h3">Facility Accounts</h1>
    <a asp-action="Edit" class="btn btn-success"><i class="bi bi-person-plus"></i> Create account</a>
</div>
<form method="get" class="d-flex gap-2 mb-3">
    <input name="search" value="@ViewBag.Search" class="form-control" aria-label="Search accounts" placeholder="Name or email" />
    <button class="btn btn-outline-secondary" title="Search"><i class="bi bi-search"></i></button>
</form>
<div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>Facility</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr><td>@user.FullName</td><td>@user.Email</td><td>@user.Provider?.Name</td>
            <td>@(user.LockoutEnd > DateTimeOffset.UtcNow ? "Disabled" : "Active")</td>
            <td><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="Manage account"><i class="bi bi-pencil"></i></a></td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5">No facility accounts found.</td></tr> }
    </tbody>
</table></div>
