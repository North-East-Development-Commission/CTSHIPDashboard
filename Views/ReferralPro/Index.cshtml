@model IEnumerable<CTSHIPDashboard.ViewModels.ReferralIndexViewModel>
@using CTSHIPDashboard.Enums
@{
    ViewData["Title"] = "Referral Facility Dashboard";
    string currentStatus = ViewBag.Status as string ?? "All";
}

<div class="ct-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2>Referral Facility Dashboard</h2>
            <p class="mb-0">
                @(string.IsNullOrWhiteSpace(ViewBag.CurrentHospitalName as string) ? "Verified referrals allocated to referred hospitals." : ViewBag.CurrentHospitalName)
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="ReferralPro" asp-action="VerifyCode" class="btn btn-warning fw-bold shadow-lg px-4">
                <i class="bi bi-shield-check"></i> Verify Code
            </a>
            <a href="@Url.Content("~/ReferralPro/Referrals")" class="btn btn-light text-success fw-bold shadow px-4">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card ct-kpi ct-kpi-green-gold h-100">
            <div class="card-body">
                <div class="text-muted small">Ready To Receive</div>
                <div class="display-6 fw-bold text-success">@ViewBag.PendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card ct-kpi h-100">
            <div class="card-body">
                <div class="text-muted small">Received</div>
                <div class="display-6 fw-bold text-primary">@ViewBag.ReceivedCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card ct-kpi ct-kpi-gold-green h-100">
            <div class="card-body">
                <div class="text-muted small">Encounter Submitted</div>
                <div class="display-6 fw-bold text-dark">@ViewBag.CompletedCount</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="card card-body mb-3 border-0 shadow-lg">
    <div class="row g-2">
        <div class="col-md-7">
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by enrollee, provider, diagnosis or HMO" />
        </div>
        <div class="col-md-3">
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="All" selected="@(currentStatus == "All")">All</option>
                <option value="Verified" selected="@(currentStatus == "Verified")">Verified</option>
                <option value="Audited" selected="@(currentStatus == "Audited")">Audited</option>
                <option value="Received" selected="@(currentStatus == "Received")">Received</option>
                <option value="Closed" selected="@(currentStatus == "Closed")">Closed</option>
            </select>
        </div>
        <div class="col-md-2 d-grid align-items-end">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </div>
</form>

<div class="card border-0 shadow-lg">
    <div class="table-responsive">
    <table class="table table-bordered table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Verified</th>
                <th>Enrollee</th>
                <th>From Provider</th>
                <th>HMO</th>
                <th>Diagnosis</th>
                <th>Priority</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@((item.VerifiedAt ?? item.AuditedAt ?? item.SubmittedToHmoAt ?? item.CreatedAt).ToLocalTime().ToString("dd MMM yyyy HH:mm"))</td>
                    <td>
                        <strong>@item.EnrolleeFullName</strong><br />
                        <small class="text-muted">@item.EnrolleeNumber</small>
                    </td>
                    <td>@item.FromProviderName</td>
                    <td>@item.HmoName</td>
                    <td>@item.Diagnosis</td>
                    <td>@item.Priority</td>
                    <td>
                        @await Html.PartialAsync("_ReferralStatusBadge", item.Status)
                        @if ((item.Status == ReferralStatus.Verified || item.Status == ReferralStatus.Audited) && item.ReferralVerificationCodeExpired)
                        {
                            <div class="small text-danger mt-1">Code expired</div>
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Referral actions">
                            @if (User.IsInRole("CTSHIPAdmin") || item.Status == ReferralStatus.Received || item.Status == ReferralStatus.Closed)
                            {
                                <a asp-controller="ReferralPro" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                    View
                                </a>
                            }
                            @if (item.Status == ReferralStatus.Verified || item.Status == ReferralStatus.Audited)
                            {
                                <a asp-controller="ReferralPro" asp-action="VerifyCode" asp-route-id="@item.Id" class="btn btn-success fw-bold">
                                    Verify Code
                                </a>
                            }
                            @if (item.Status == ReferralStatus.Received)
                            {
                                <a asp-controller="ReferralPro" asp-action="Encounter" asp-route-id="@item.Id" class="btn btn-success">
                                    Encounter
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No referrals found.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
</div>
