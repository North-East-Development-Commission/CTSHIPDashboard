@model CTSHIPDashboard.ViewModels.ReferralCodeVerificationViewModel
@{
    ViewData["Title"] = "Verify Referral Code";
}

<div class="ct-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2>Verify Referral Code</h2>
            <p class="mb-0">
                @(string.IsNullOrWhiteSpace(Model.ReferredHospitalName) ? "Referral facility" : Model.ReferredHospitalName)
            </p>
        </div>
        <a asp-controller="ReferralPro" asp-action="Index" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Back To Referrals
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row justify-content-center">
        <div class="col-xl-7 col-lg-8">
            <form asp-controller="ReferralPro" asp-action="VerifyCode" asp-route-id="@Model.ReferralId" method="post" class="card border-0 shadow-lg">
                @Html.AntiForgeryToken()
                <input asp-for="ReferralId" type="hidden" />

                <div class="card-header bg-success text-white">
                    <strong><i class="bi bi-shield-check me-2"></i>Referral Access Verification</strong>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (!string.IsNullOrWhiteSpace(Model.EnrolleeNumberHint))
                    {
                        <div class="alert alert-info">
                            Enter the HMO-issued code presented for enrollee @Model.EnrolleeNumberHint.
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-bold"></label>
                        <input asp-for="Code" class="form-control form-control-lg text-uppercase" autocomplete="off" placeholder="Example: RVC12345678" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                        <div class="form-text">Referral codes are valid for 7 days from HMO verification or reissue.</div>
                    </div>
                </div>
                <div class="card-footer bg-white d-flex flex-wrap justify-content-end gap-2">
                    <a asp-controller="ReferralPro" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-shield-check"></i> Verify Code
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
