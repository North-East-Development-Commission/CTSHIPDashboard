@model CTSHIPDashboard.Models.StateOfficeMonthlyReport

@{
    ViewData["Title"] = "IHSA Provider Report Audit";
}

<div class="ct-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="mb-0">Provider Report Audit</h2>
            <p class="mb-0">@Model.FacilityName - @Model.ReportingMonth.ToString("MMMM yyyy")</p>
        </div>
        <a asp-action="MonthlyReports" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back to Reports</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Active Enrollees</div><div class="fs-4 fw-bold text-success">@Model.TotalActiveEnrollees.ToString("N0")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Total Encounters</div><div class="fs-4 fw-bold text-success">@Model.TotalEncounters.ToString("N0")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Service Utilization</div><div class="fs-4 fw-bold text-success">@Model.ServiceUtilization.ToString("N0")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Claims Value</div><div class="fs-5 fw-bold text-success">NGN @Model.TotalClaimsAmount.ToString("N2")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Referrals</div><div class="fs-5 fw-bold text-success">@Model.CompletedReferrals.ToString("N0") of @Model.TotalReferrals.ToString("N0")</div><div class="small text-muted">@Model.ReferralCompletionRate.ToString("N1")%</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Capitation Paid</div><div class="fs-5 fw-bold text-success">NGN @Model.AmountCapitationPaid.ToString("N2")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Paid Claims</div><div class="fs-5 fw-bold text-success">@Model.PaidClaims.ToString("N0")</div><div class="small text-muted">NGN @Model.PaidClaimsAmount.ToString("N2")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Audit Status</div><span class="badge @(Model.AuditStatus == "Audited" ? "bg-success" : Model.AuditStatus == "Needs Correction" ? "bg-warning text-dark" : "bg-secondary")">@Model.AuditStatus</span></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-success text-white fw-bold">Reporting Information</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-md-4">State</dt><dd class="col-md-8">@Model.State</dd>
                        <dt class="col-md-4">LGA</dt><dd class="col-md-8">@Model.Lga</dd>
                        <dt class="col-md-4">Ward</dt><dd class="col-md-8">@Model.Ward</dd>
                        <dt class="col-md-4">Facility</dt><dd class="col-md-8">@Model.FacilityName (@Model.FacilityCode)</dd>
                        <dt class="col-md-4">Officer</dt><dd class="col-md-8">@Model.ReportingOfficerName</dd>
                        <dt class="col-md-4">Designation</dt><dd class="col-md-8">@Model.Designation</dd>
                        <dt class="col-md-4">Phone</dt><dd class="col-md-8">@Model.PhoneNumber</dd>
                        <dt class="col-md-4">Submitted</dt><dd class="col-md-8">@Model.DateSubmitted.ToLocalTime().ToString("dd MMMM yyyy HH:mm")</dd>
                        <dt class="col-md-4">Audited By</dt><dd class="col-md-8">@Model.AuditedByName</dd>
                        <dt class="col-md-4">Audited At</dt><dd class="col-md-8">@(Model.AuditedAt.HasValue ? Model.AuditedAt.Value.ToLocalTime().ToString("dd MMMM yyyy HH:mm") : "Not audited")</dd>
                        <dt class="col-md-4">Audit Note</dt><dd class="col-md-8">@Model.AuditNote</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header fw-bold">IHSA Audit Decision</div>
                <div class="card-body">
                    <form asp-action="AuditMonthlyReport" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Decision</label>
                            <select name="auditStatus" class="form-select" required>
                                @if (Model.AuditStatus == "Audited") { <option value="Audited" selected>Audited</option> } else { <option value="Audited">Audited</option> }
                                @if (Model.AuditStatus == "Needs Correction") { <option value="Needs Correction" selected>Needs Correction</option> } else { <option value="Needs Correction">Needs Correction</option> }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Audit Note</label>
                            <textarea name="auditNote" class="form-control" rows="5">@Model.AuditNote</textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Send Audit to Admin</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
