@model CTSHIPDashboard.Models.ViewModels.DrugInventoryFormViewModel

@{
    ViewData["Title"] = "Edit Drug";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h1 class="h4 mb-0">Edit Drug Inventory Item</h1>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="DrugName" class="form-label fw-bold"></label>
                                <input asp-for="DrugName" class="form-control" />
                                <span asp-validation-for="DrugName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UnitOfMeasure" class="form-label fw-bold"></label>
                                <select asp-for="UnitOfMeasure" asp-items="Model.Units" class="form-select"></select>
                                <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Strength" class="form-label fw-bold"></label>
                                <input asp-for="Strength" class="form-control" />
                                <span asp-validation-for="Strength" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DosageForm" class="form-label fw-bold"></label>
                                <input asp-for="DosageForm" class="form-control" />
                                <span asp-validation-for="DosageForm" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="QuantityOnHand" class="form-label fw-bold"></label>
                                <input asp-for="QuantityOnHand" class="form-control" min="0" />
                                <span asp-validation-for="QuantityOnHand" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ReorderLevel" class="form-label fw-bold"></label>
                                <input asp-for="ReorderLevel" class="form-control" min="0" />
                                <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UnitCost" class="form-label fw-bold"></label>
                                <input asp-for="UnitCost" class="form-control" min="0" step="0.01" />
                                <span asp-validation-for="UnitCost" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-bold">Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Update Drug</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}