@model CTSHIPDashboard.Models.ViewModels.DrugInventoryFormViewModel

@{
    ViewData["Title"] = "Edit Drug";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h1 class="h4 mb-0">Edit Drug Inventory Item</h1>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DrugName" class="form-label fw-bold"></label>
                                <select asp-for="DrugName" class="form-select" id="DrugName">
                                    <option value="">Select drug title</option>
                                    @foreach (var group in Model.MedicineGroups)
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (string medicine in group.Value)
                                            {
                                                <option value="@medicine" selected="@(string.Equals(Model.DrugName, medicine, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@medicine</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <span asp-validation-for="DrugName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6" id="otherMedicineRow" style="display:none;">
                                <label asp-for="OtherDrugName" class="form-label fw-bold"></label>
                                <input asp-for="OtherDrugName" class="form-control" placeholder="Enter other medicine name" />
                                <span asp-validation-for="OtherDrugName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Strength" class="form-label fw-bold"></label>
                                <input asp-for="Strength" class="form-control" placeholder="e.g., 500mg tablet, 5ml syrup, vial" />
                                <span asp-validation-for="Strength" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="QuantityOnHand" class="form-label fw-bold"></label>
                                <input asp-for="QuantityOnHand" class="form-control" min="0" />
                                <span asp-validation-for="QuantityOnHand" class="text-danger"></span>
                            </div>
                            <input type="hidden" asp-for="DosageForm" />
                            <input type="hidden" asp-for="UnitOfMeasure" />
                            <input type="hidden" asp-for="ReorderLevel" />
                            <input type="hidden" asp-for="UnitCost" />
                            <input type="hidden" asp-for="IsActive" />
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Update Drug</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function syncOtherMedicine() {
            const select = document.getElementById("DrugName")
            const row = document.getElementById("otherMedicineRow")
            if (!select) return
            if (!row) return
            row.style.display = select.value.toLowerCase() === "other medicines" ? "block" : "none"
        }

        document.getElementById("DrugName")?.addEventListener("change", syncOtherMedicine)
        syncOtherMedicine()
    </script>
}