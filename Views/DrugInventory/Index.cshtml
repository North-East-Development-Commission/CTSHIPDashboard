@model CTSHIPDashboard.Models.ViewModels.DrugInventoryIndexViewModel

@{
    ViewData["Title"] = "Drug Inventory";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-success mb-1">Drug Inventory</h1>
            <p class="text-muted mb-0">@Model.ProviderName (@Model.ProviderCode)</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Add Drug
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Drug Title</th>
                        <th>Dosage</th>
                        <th>Quantity</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">No drugs have been added to inventory yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.DrugName</div>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Strength) ? "-" : item.Strength)</td>
                                <td>
                                    <span class="fw-bold @(item.IsLowStock ? "text-danger" : "text-success")">@item.QuantityOnHand.ToString("N0")</span>
                                    @if (item.IsLowStock)
                                    {
                                        <span class="badge bg-danger ms-1">Low</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end align-items-center gap-2 flex-wrap">
                                        <form asp-action="Restock" asp-route-id="@item.Id" method="post" class="d-flex gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="number" name="quantity" class="form-control form-control-sm" min="1" value="1" style="width:90px" aria-label="Restock quantity" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Restock</button>
                                        </form>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>