@model CTSHIPDashboard.Models.Doctor
@{
    ViewData["Title"] = "Edit Staff";
}

<div class="container py-5">
    <div class="card border-0 shadow-lg mx-auto" style="max-width:900px;">
        <div class="card-header bg-success text-white p-4">
            <h2 class="mb-1">Edit Staff</h2>
            <p class="mb-0">@Model.FullName</p>
        </div>
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <partial name="_DoctorForm" model="Model" />
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-success btn-lg">Cancel</a>
                    <button class="btn btn-success btn-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
