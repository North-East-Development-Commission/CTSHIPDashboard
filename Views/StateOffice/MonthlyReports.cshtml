@model IEnumerable<CTSHIPDashboard.Models.StateOfficeMonthlyReport>

@{
    ViewData["Title"] = "Monthly Reports";
}

<div class="ct-page">
<div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="mb-0">Monthly Reporting Information</h2>
        <p class="mb-0">State Office facility reports by month and year.</p>
    </div>
    <a asp-action="CreateMonthlyReport" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> New Report
    </a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Reporting Month</label>
            <input type="month" name="reportingPeriod" value="@ViewBag.ReportingPeriod" class="form-control" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-success">Filter</button>
        </div>
        <div class="col-md-2 d-grid">
            <a asp-action="MonthlyReports" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Reporting Month</th>
                    <th>State</th>
                    <th>LGA</th>
                    <th>Ward</th>
                    <th>Facility</th>
                    <th>Officer</th>
                    <th>Date Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.ReportingMonth.ToString("MMMM yyyy")</td>
                        <td>@report.State</td>
                        <td>@report.Lga</td>
                        <td>@report.Ward</td>
                        <td>
                            @report.FacilityName
                            <div class="small text-muted">@report.FacilityCode</div>
                        </td>
                        <td>@report.ReportingOfficerName</td>
                        <td>@report.DateSubmitted.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <a asp-action="MonthlyReportDetails" asp-route-id="@report.Id"
                               class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No monthly reports found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>
