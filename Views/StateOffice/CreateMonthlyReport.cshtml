@model CTSHIPDashboard.Models.ViewModels.StateOfficeMonthlyReportViewModel

@{
    ViewData["Title"] = "Submit Monthly Report";
}

<div class="ct-page">
<div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="mb-0">Monthly Reporting Information</h2>
        <p class="mb-0">Complete the reporting details for the selected facility.</p>
    </div>
    <a asp-action="MonthlyReports" class="btn btn-outline-secondary">Back to Reports</a>
</div>

<form asp-action="CreateMonthlyReport" method="post" class="card">
    @Html.AntiForgeryToken()
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ReportingPeriod" class="form-label"></label>
                <input asp-for="ReportingPeriod" type="month" class="form-control" />
                <span asp-validation-for="ReportingPeriod" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="State" class="form-label"></label>
                <select asp-for="State" asp-items="Model.States" class="form-select" id="reportState">
                    <option value="">Select state</option>
                </select>
                <span asp-validation-for="State" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Lga" class="form-label"></label>
                <select asp-for="Lga" asp-items="Model.Lgas" class="form-select" id="reportLga">
                    <option value="">Select LGA</option>
                </select>
                <span asp-validation-for="Lga" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Ward" class="form-label"></label>
                <select asp-for="Ward" asp-items="Model.Wards" class="form-select" id="reportWard">
                    <option value="">Select ward</option>
                </select>
                <span asp-validation-for="Ward" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="ProviderId" class="form-label"></label>
                <select asp-for="ProviderId" asp-items="Model.Facilities" class="form-select" id="reportFacility">
                    <option value="">Select facility</option>
                </select>
                <span asp-validation-for="ProviderId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="FacilityCode" class="form-label"></label>
                <input asp-for="FacilityCode" class="form-control" id="facilityCode" readonly />
            </div>

            <div class="col-md-6">
                <label asp-for="ReportingOfficerName" class="form-label"></label>
                <input asp-for="ReportingOfficerName" class="form-control" />
                <span asp-validation-for="ReportingOfficerName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Designation" class="form-label"></label>
                <input asp-for="Designation" class="form-control" />
                <span asp-validation-for="Designation" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" type="tel" inputmode="numeric" pattern="[0-9+ ]*"
                       class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Date Submitted</label>
                <input class="form-control" value="Generated automatically when submitted" readonly />
            </div>
        </div>
    </div>

    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-success">Submit Report</button>
        <a asp-action="MonthlyReports" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const state = document.getElementById('reportState');
            const lga = document.getElementById('reportLga');
            const ward = document.getElementById('reportWard');
            const facility = document.getElementById('reportFacility');
            const facilityCode = document.getElementById('facilityCode');

            const lgaUrl = '@Url.Action("MonthlyReportLgas", "StateOffice")';
            const wardUrl = '@Url.Action("MonthlyReportWards", "StateOffice")';
            const facilityUrl = '@Url.Action("MonthlyReportFacilities", "StateOffice")';

            const replaceOptions = (select, items, placeholder, valueSelector, textSelector) => {
                select.innerHTML = `<option value="">${placeholder}</option>`;
                items.forEach(item => {
                    const option = document.createElement('option');
                    option.value = valueSelector(item);
                    option.textContent = textSelector(item);
                    if (item.code) option.dataset.code = item.code;
                    select.appendChild(option);
                });
                $(select).trigger('change.select2');
            };

            const loadStateOptions = async () => {
                if (!state.value) return;

                const [lgas, facilities] = await Promise.all([
                    fetch(`${lgaUrl}?state=${encodeURIComponent(state.value)}`).then(r => r.json()),
                    fetch(`${facilityUrl}?state=${encodeURIComponent(state.value)}`).then(r => r.json())
                ]);

                replaceOptions(lga, lgas, 'Select LGA', x => x, x => x);
                replaceOptions(ward, [], 'Select ward', x => x, x => x);
                replaceOptions(facility, facilities, 'Select facility', x => x.id, x => x.name);
                facilityCode.value = '';
            };

            state.addEventListener('change', loadStateOptions);

            lga.addEventListener('change', async () => {
                if (!state.value || !lga.value) {
                    replaceOptions(ward, [], 'Select ward', x => x, x => x);
                    return;
                }

                const wards = await fetch(
                    `${wardUrl}?state=${encodeURIComponent(state.value)}&lga=${encodeURIComponent(lga.value)}`
                ).then(r => r.json());

                replaceOptions(ward, wards, 'Select ward', x => x, x => x);
            });

            facility.addEventListener('change', async () => {
                if (!state.value || !facility.value) {
                    facilityCode.value = '';
                    return;
                }

                const facilities = await fetch(
                    `${facilityUrl}?state=${encodeURIComponent(state.value)}`
                ).then(r => r.json());

                const selected = facilities.find(x => String(x.id) === facility.value);
                facilityCode.value = selected?.code ?? '';
            });

            if (facility.value && facilityCode.value) {
                facility.selectedOptions[0].dataset.code = facilityCode.value;
            }
        })();
    </script>
}
