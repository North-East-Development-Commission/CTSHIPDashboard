@model IEnumerable<CTSHIPDashboard.Models.StateOfficeMonthlyReport>

@{
    ViewData["Title"] = "Referral Provider Reports";
    var availableStates = ViewBag.AvailableStates as List<string> ?? new List<string>();
    string selectedState = ViewBag.State as string ?? string.Empty;
    bool canManageReports = ViewBag.CanManageReports as bool? ?? false;
    bool canFilterReportsByState = ViewBag.CanFilterReportsByState as bool? ?? canManageReports;
}

<div class="ct-page">
<div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="mb-0">Referral Provider Report Management</h2>
        <p class="mb-0">Referral provider reports submitted for HMO, State Office, and admin review.</p>
    </div>
    <a asp-action="CreateReferralProviderReport" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> New Referral Report
    </a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Reporting Month</label>
            <input type="month" name="reportingPeriod" value="@ViewBag.ReportingPeriod" class="form-control" />
        </div>
        @if (canFilterReportsByState)
        {
            <div class="col-md-3">
                <label class="form-label">State</label>
                <select name="state" class="form-select">
                    <option value="">All states</option>
                    @foreach (string state in availableStates)
                    {
                        if (state == selectedState)
                        {
                            <option value="@state" selected>@state</option>
                        }
                        else
                        {
                            <option value="@state">@state</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-success">Filter</button>
        </div>
        <div class="col-md-2 d-grid">
            <a asp-action="ReferralProviderReports" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Reporting Month</th>
                    <th>State</th>
                    <th>LGA</th>
                    <th>Referral Provider</th>
                    <th>Referrals</th>
                    <th>Claims</th>
                    <th>Audit</th>
                    <th>Officer</th>
                    <th>Date Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.ReportingMonth.ToString("MMMM yyyy")</td>
                        <td>@report.State</td>
                        <td>@report.Lga</td>
                        <td>
                            @report.FacilityName
                            <div class="small text-muted">@report.FacilityCode</div>
                        </td>
                        <td>
                            @report.CompletedReferrals of @report.TotalReferrals
                            <div class="small text-muted">@report.ReferralCompletionRate.ToString("N1")% complete</div>
                        </td>
                        <td>
                            @report.TotalClaims
                            <div class="small text-muted">NGN @report.TotalClaimsAmount.ToString("N2")</div>
                        </td>
                        <td>
                            <span class="badge @(report.AuditStatus == "Audited" ? "bg-success" : report.AuditStatus == "Needs Correction" ? "bg-warning text-dark" : "bg-secondary")">
                                @report.AuditStatus
                            </span>
                        </td>
                        <td>@report.ReportingOfficerName</td>
                        <td>@report.DateSubmitted.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <a asp-action="ReferralProviderReportDetails" asp-route-id="@report.Id"
                               class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">No referral provider reports found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>
