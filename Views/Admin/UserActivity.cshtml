@model CTSHIPDashboard.Models.ViewModels.UserActivityDashboardViewModel

<div class="container-fluid py-4">
    <h2 class="text-success mb-4">User Activity Reports</h2>

    <!-- Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #008751, #006400);">
                <div class="card-body text-center">
                    <h5>Logins Today</h5>
                    <h2>@Model.TotalLoginsToday</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #2e7d32, #1b5e20);">
                <div class="card-body text-center">
                    <h5>Active Users (7 Days)</h5>
                    <h2>@Model.ActiveUsersLast7Days</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- User Stats Table -->
    <div class="card border-0 shadow mb-5">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">User Login Summary</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Last Login</th>
                            <th>Last Seen</th>
                            <th>Total Logins</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.UserStats)
                        {
                            <tr>
                                <td><strong>@user.UserEmail</strong></td>
                                <td>@(user.LastLogin?.ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                                <td>@(user.LastSeen?.ToString("dd MMM yyyy HH:mm") ?? "Unknown")</td>
                                <td><span class="badge bg-primary">@user.TotalLogins</span></td>
                                <td>
                                    @if (user.LastSeen >= DateTime.Now.AddDays(-7))
                                    {
                                        <span class='badge bg-success'>Active</span>
                                    }
                                    else
                                    {
                                        <span class='badge bg-secondary'>Inactive</span>
                                    }
                                </td>

                        </tr>
                                                }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="card border-0 shadow">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Recent Activities (Last 50)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in Model.RecentActivities)
                        {
                            <tr>
                                <td>@act.Timestamp.ToString("dd MMM HH:mm:ss")</td>
                                <td>@(act.User?.Email ?? "Unknown")</td>
                                <td><span class="badge bg-info">@act.Action</span></td>
                                <td><small class="text-muted">@act.IpAddress</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>