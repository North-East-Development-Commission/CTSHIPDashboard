@model ApplicationUser
@{
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-danger text-white text-center py-4">
                    <h3><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h3>
                </div>
                <div class="card-body p-5 text-center">
                    <p class="lead">Are you sure you want to <strong>permanently delete</strong> this user?</p>
                    <h5 class="text-danger fw-bold">@(Model.FullName ?? Model.Email)</h5>
                    <p class="text-muted">This action cannot be undone.</p>

                    <form asp-action="DeleteUserConfirmed" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-lg px-5 shadow">
                            <i class="bi bi-trash"></i> Yes, Delete User
                        </button>
                    </form>
                    <a asp-action="Users" class="btn btn-secondary btn-lg px-5 ms-3">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>