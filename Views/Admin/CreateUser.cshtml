@model CreateUserViewModel
@{
    ViewData["Title"] = "Create New User";
}

<div class="container-fluid py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-success text-white text-center py-4">
                    <h3 class="fw-bold mb-0"><i class="bi bi-person-plus-fill"></i> CREATE NEW USER</h3>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="CreateUser" method="post">
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="FullName" class="form-label text-success fw-bold">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control form-control-lg rounded-3" placeholder="Dr. Fatima Yusuf" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label text-success fw-bold">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="user@nhia.gov.ng" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="form-label text-success fw-bold">Password <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ContactInfo" class="form-label text-success fw-bold">Contact Phone</label>
                                <input asp-for="ContactInfo" class="form-control form-control-lg rounded-3" placeholder="0803 123 4567" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="State" class="form-label text-success fw-bold">State</label>
                                <select asp-for="State" class="form-select form-select-lg rounded-3" asp-items="@ViewBag.States">
                                </select>
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="OrganizationId" class="form-label text-success fw-bold">Organization Type</label>
                                <select asp-for="OrganizationId" class="form-select form-select-lg rounded-3" asp-items="@ViewBag.Oga">
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="OrganizationId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6" id="providerWrapper" style="display:none;">
                                <label asp-for="ProviderId" class="form-label text-success fw-bold">Provider</label>
                                <select asp-for="ProviderId" class="form-select form-select-lg rounded-3" asp-items="@ViewBag.Provider" data-selected-provider="@Model.ProviderId">
                                    <option value="">-- Select Provider --</option>
                                </select>
                                <span asp-validation-for="ProviderId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6" id="referralProviderWrapper" style="display:none;">
                                <label asp-for="ReferralHospitalId" class="form-label text-success fw-bold">Referral Provider</label>
                                <select asp-for="ReferralHospitalId" class="form-select form-select-lg rounded-3" asp-items="@ViewBag.ReferralHospitals" data-selected-referral="@Model.ReferralHospitalId">
                                    <option value="">-- Select Referral Provider --</option>
                                </select>
                                <span asp-validation-for="ReferralHospitalId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6" id="hmoWrapper" style="display:none;">
                                <label asp-for="HmoId" class="form-label text-success fw-bold">HMO</label>
                                <select asp-for="HmoId" class="form-select form-select-lg rounded-3" asp-items="@ViewBag.Hmos" data-selected-hmo="@Model.HmoId">
                                    <option value="">-- Select HMO --</option>
                                </select>
                                <span asp-validation-for="HmoId" class="text-danger small"></span>
                            </div>


                            <div class="col-12 col-md-6">
                                <label class="form-label text-success fw-bold">
                                    User Roles <span class="text-danger">*</span>
                                </label>
                                <small class="text-muted d-block mb-2">Hold Ctrl/Cmd to select multiple</small>
                                <select asp-for="SelectedRoles"
                                        class="form-select form-select-lg rounded-3"
                                        asp-items="@ViewBag.AllRoles"
                                        multiple required
                                        style="height: 180px;">
                                </select>
                                <span asp-validation-for="SelectedRoles" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-5 border-success opacity-75" />

                        <div class="d-grid d-md-flex justify-content-end gap-3">
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow fw-bold">
                                <i class="bi bi-save"></i> CREATE USER
                            </button>
                            <a asp-action="Users" asp-controller="Admin" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const organizationSelect = document.getElementById("OrganizationId");
            const providerWrapper = document.getElementById("providerWrapper");
            const referralProviderWrapper = document.getElementById("referralProviderWrapper");
            const hmoWrapper = document.getElementById("hmoWrapper");
            const providerSelect = document.getElementById("ProviderId");
            const referralProviderSelect = document.getElementById("ReferralHospitalId");
            const hmoSelect = document.getElementById("HmoId");
            const roleSelect = document.getElementById("SelectedRoles");
            const providerEndpoint = "@Url.Action("GetProvidersByHmo", "Admin")";
            const referralProviderEndpoint = "@Url.Action("GetReferralProvidersByHmo", "Admin")";

            if (!organizationSelect || !providerWrapper || !hmoWrapper || !referralProviderWrapper) {
                return;
            }

            function setDropdownState(wrapper, select, visible) {
                wrapper.style.display = visible ? "block" : "none";

                if (!select) {
                    return;
                }

                select.disabled = !visible;
                select.required = visible;

                if (!visible) {
                    select.value = "";
                }
            }

            function resetSelect(select, placeholder) {
                if (!select) {
                    return;
                }

                select.innerHTML = "";
                const option = document.createElement("option");
                option.value = "";
                option.textContent = placeholder;
                select.appendChild(option);
            }

            async function loadProviderOptions() {
                if (!providerSelect) return;

                resetSelect(providerSelect, "-- Select Provider --");
                if (!hmoSelect?.value) {
                    providerSelect.disabled = true;
                    return;
                }

                const selectedProviderId = providerSelect.dataset.selectedProvider || providerSelect.value || "";
                const response = await fetch(`${providerEndpoint}?hmoId=${encodeURIComponent(hmoSelect.value)}&selectedProviderId=${encodeURIComponent(selectedProviderId)}`);
                const data = await response.json();
                if (!data.success || !Array.isArray(data.providers)) return;

                data.providers.forEach(provider => {
                    const option = document.createElement("option");
                    option.value = provider.id;
                    option.textContent = provider.text;
                    option.selected = Boolean(provider.selected);
                    providerSelect.appendChild(option);
                });

                providerSelect.disabled = false;
            }

            async function loadReferralProviderOptions() {
                if (!referralProviderSelect) return;

                resetSelect(referralProviderSelect, "-- Select Referral Provider --");
                if (!hmoSelect?.value) {
                    referralProviderSelect.disabled = true;
                    return;
                }

                const selectedReferralId = referralProviderSelect.dataset.selectedReferral || referralProviderSelect.value || "";
                const response = await fetch(`${referralProviderEndpoint}?hmoId=${encodeURIComponent(hmoSelect.value)}&selectedReferralHospitalId=${encodeURIComponent(selectedReferralId)}`);
                const data = await response.json();
                if (!data.success || !Array.isArray(data.providers)) return;

                data.providers.forEach(provider => {
                    const option = document.createElement("option");
                    option.value = provider.id;
                    option.textContent = provider.text;
                    option.selected = Boolean(provider.selected);
                    referralProviderSelect.appendChild(option);
                });

                referralProviderSelect.disabled = false;
            }

            async function toggleFields() {
                const selectedOption = organizationSelect.options[organizationSelect.selectedIndex];
                if (!selectedOption) return;

                const selectedText = selectedOption.textContent.toLowerCase().trim();
                const selectedRoles = Array.from(roleSelect?.selectedOptions || [])
                    .map(option => option.value.toLowerCase());
                const isReferral = selectedText.includes("referral") || selectedRoles.includes("referralpro");
                const isProvider = !isReferral && selectedText.includes("provider");
                const hasHmoScopedRole = selectedRoles.includes("hmo") || selectedRoles.includes("reviewer");
                const isHmo = hasHmoScopedRole
                    || isProvider
                    || isReferral
                    || selectedText.includes("health maintenance organization")
                    || selectedText.includes("health maintenance organisation")
                    || /\bhmo\b/.test(selectedText);

                setDropdownState(providerWrapper, providerSelect, isProvider);
                setDropdownState(referralProviderWrapper, referralProviderSelect, isReferral);
                setDropdownState(hmoWrapper, hmoSelect, isHmo);

                if (isProvider) {
                    await loadProviderOptions();
                }

                if (isReferral) {
                    await loadReferralProviderOptions();
                }
            }

            organizationSelect.addEventListener("change", function () {
                if (providerSelect) providerSelect.dataset.selectedProvider = "";
                if (referralProviderSelect) referralProviderSelect.dataset.selectedReferral = "";
                toggleFields();
            });
            hmoSelect?.addEventListener("change", function () {
                if (providerSelect) providerSelect.dataset.selectedProvider = "";
                if (referralProviderSelect) referralProviderSelect.dataset.selectedReferral = "";
                toggleFields();
            });
            roleSelect?.addEventListener("change", toggleFields);
            toggleFields();
        });
    </script>
}
