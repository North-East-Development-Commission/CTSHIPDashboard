@{
    ViewData["Title"] = "Create New Role";
}

<div class="container py-5">
    <div class="card mx-auto shadow-lg" style="max-width: 600px;">
        <div class="card-header bg-success text-white text-center py-4">
            <h2>Create New Role</h2>
        </div>
        <div class="card-body p-5">
            <form asp-action="CreateRole" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label text-success fw-bold fs-5">Role Name</label>
                    <input type="text" name="roleName" class="form-control form-control-lg" required placeholder="e.g. Auditor, Supervisor, SSHIA" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success btn-lg px-5 shadow">CREATE ROLE</button>
                    <a asp-action="Roles" class="btn btn-secondary btn-lg px-5 ms-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>