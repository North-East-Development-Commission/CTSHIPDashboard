@model IEnumerable<CTSHIPDashboard.ViewModels.ReferralIndexViewModel>
@{
    ViewData["Title"] = "HMO Referral Verification";
}

<div class="ct-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1>HMO Referral Verification</h1>
            <p class="lead mb-0">Verify and audit referrals submitted by providers.</p>
        </div>
        <a asp-controller="HmoReferrals" asp-action="Index" class="btn btn-warning fw-bold shadow-lg px-4">
            <i class="bi bi-arrow-clockwise"></i> Refresh Referrals
        </a>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form method="get" class="card card-body mb-3 border-0 shadow-lg">
        <div class="row g-2">
            <div class="col-md-10">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by enrollee, hospital, provider, diagnosis or HMO" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-success fw-bold shadow">Search</button>
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-lg">
        <div class="table-responsive">
    <table class="table table-bordered table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Submitted</th>
                <th>Enrollee</th>
                <th>Provider</th>
                <th>Referred Hospital</th>
                <th>Diagnosis</th>
                <th>Priority</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.SubmittedToHmoAt.HasValue? item.SubmittedToHmoAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "Not submitted")</td>
                    <td>
                        <strong>@item.EnrolleeFullName</strong><br />
                        <small class="text-muted">@item.EnrolleeNumber</small>
                    </td>
                    <td>@item.FromProviderName</td>
                    <td>@item.ReferredHospitalName</td>
                    <td>@item.Diagnosis</td>
                    <td>@item.Priority</td>
                    <td>@await Html.PartialAsync("_ReferralStatusBadge", item.Status)</td>
                    <td class="text-end">
                        <a asp-controller="HmoReferrals" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-success fw-bold">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
        </div>
    </div>
</div>
