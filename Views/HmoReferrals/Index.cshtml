@model IEnumerable<CTSHIPDashboard.ViewModels.ReferralIndexViewModel>
@{
    ViewData["Title"] = "HMO Referral Verification";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-primary mb-3">
        HMO Referral Verification
    </h1>
    <p class="lead text-success fw-bold">Verify and audit referrals submitted by providers.</p>
</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-10">
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by enrollee, hospital, provider, diagnosis or HMO" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary">Search</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Submitted</th>
                <th>Enrollee</th>
                <th>Provider</th>
                <th>Referred Hospital</th>
                <th>Diagnosis</th>
                <th>Priority</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.SubmittedToHmoAt.HasValue? item.SubmittedToHmoAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "Not submitted")</td>
                    <td>
                        <strong>@item.EnrolleeFullName</strong><br />
                        <small class="text-muted">@item.EnrolleeNumber</small>
                    </td>
                    <td>@item.FromProviderName</td>
                    <td>@item.ReferredHospitalName</td>
                    <td>@item.Diagnosis</td>
                    <td>@item.Priority</td>
                    <td>@await Html.PartialAsync("_ReferralStatusBadge", item.Status)</td>
                    <td class="text-end">
                        <a asp-controller="HmoReferrals" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
