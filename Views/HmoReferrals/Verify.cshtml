@model CTSHIPDashboard.ViewModels.ReferralVerificationViewModel
@{
    ViewData["Title"] = "Verify Referral";
    CTSHIPDashboard.ViewModels.ReferralDetailsViewModel referral = ViewBag.Referral;
}

<h2>Verify Referral</h2>
<p class="text-muted">Approve or reject referral submitted by provider.</p>

<div class="card mb-3">
    <div class="card-body">
        <strong>@referral.EnrolleeFullName</strong> (@referral.EnrolleeNumber)<br />
        From: @referral.FromProviderName<br />
        To: @referral.ReferredHospitalName<br />
        Diagnosis: @referral.Diagnosis
    </div>
</div>

<form asp-controller="HmoReferrals" asp-action="Verify" asp-route-id="@Model.ReferralId" method="post" class="card card-body">
    @Html.AntiForgeryToken()
    <input asp-for="ReferralId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Decision</label>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="IsApproved" value="true" id="approve" />
            <label class="form-check-label" for="approve">Approve referral</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="IsApproved" value="false" id="reject" />
            <label class="form-check-label" for="reject">Reject referral</label>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="VerificationNote" class="form-label"></label>
        <textarea asp-for="VerificationNote" class="form-control" rows="4"></textarea>
        <span asp-validation-for="VerificationNote" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Submit Verification</button>
        <a asp-controller="HmoReferrals" asp-action="Details" asp-route-id="@Model.ReferralId" class="btn btn-light">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
