@model CTSHIPDashboard.Models.StateOfficeMonthlyReport

@{
    bool isReferral = ViewBag.IsReferralProviderReport as bool? == true;
    string listAction = isReferral ? "ReferralProviderReports" : "MonthlyReports";
    string auditAction = isReferral ? "AuditReferralProviderReport" : "AuditMonthlyReport";
    string reportLabel = isReferral ? "Referral Provider" : "Provider";
    string nedcStatusClass = Model.NedcAuditStatus == "Approved" ? "bg-success" : Model.NedcAuditStatus == "Returned" ? "bg-danger" : "bg-warning text-dark";
    ViewData["Title"] = $"NEDC HQ {reportLabel} Report Review";
}

<div class="ct-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="text-uppercase small fw-semibold opacity-75">Final oversight review</div>
            <h2 class="mb-1">@reportLabel Report</h2>
            <p class="mb-0">@Model.FacilityName — @Model.ReportingMonth.ToString("MMMM yyyy")</p>
        </div>
        <a asp-action="@listAction" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back to Audit Queue</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Active Enrollees</div><div class="fs-4 fw-bold text-success">@Model.TotalActiveEnrollees.ToString("N0")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Encounters</div><div class="fs-4 fw-bold text-success">@Model.TotalEncounters.ToString("N0")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Claims Value</div><div class="fs-5 fw-bold text-success">NGN @Model.TotalClaimsAmount.ToString("N2")</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">NEDC HQ Status</div><span class="badge @nedcStatusClass">@Model.NedcAuditStatus</span></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card mb-3">
                <div class="card-header bg-success text-white fw-bold">Report Information</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-md-4">State / LGA / Ward</dt><dd class="col-md-8">@Model.State / @Model.Lga / @Model.Ward</dd>
                        <dt class="col-md-4">Facility</dt><dd class="col-md-8">@Model.FacilityName (@Model.FacilityCode)</dd>
                        <dt class="col-md-4">Reporting Officer</dt><dd class="col-md-8">@Model.ReportingOfficerName — @Model.Designation</dd>
                        <dt class="col-md-4">Submitted</dt><dd class="col-md-8">@Model.DateSubmitted.ToLocalTime().ToString("dd MMMM yyyy HH:mm")</dd>
                        <dt class="col-md-4">Visits / Encounters</dt><dd class="col-md-8">@Model.TotalVisits.ToString("N0") / @Model.TotalEncounters.ToString("N0")</dd>
                        <dt class="col-md-4">Referrals</dt><dd class="col-md-8">@Model.CompletedReferrals.ToString("N0") of @Model.TotalReferrals.ToString("N0") completed (@Model.ReferralCompletionRate.ToString("N1")%)</dd>
                        <dt class="col-md-4">Capitation Paid</dt><dd class="col-md-8">NGN @Model.AmountCapitationPaid.ToString("N2")</dd>
                        <dt class="col-md-4">Paid Claims</dt><dd class="col-md-8">@Model.PaidClaims.ToString("N0") — NGN @Model.PaidClaimsAmount.ToString("N2")</dd>
                    </dl>
                </div>
            </div>
            <div class="card border-success">
                <div class="card-header fw-bold">IHSA Audit Trail</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-md-4">Decision</dt><dd class="col-md-8"><span class="badge bg-success">@Model.AuditStatus</span></dd>
                        <dt class="col-md-4">Audited By</dt><dd class="col-md-8">@(Model.AuditedByName ?? "Not recorded")</dd>
                        <dt class="col-md-4">Audited At</dt><dd class="col-md-8">@(Model.AuditedAt?.ToLocalTime().ToString("dd MMMM yyyy HH:mm") ?? "Not recorded")</dd>
                        <dt class="col-md-4">IHSA Note</dt><dd class="col-md-8">@(Model.AuditNote ?? "No note supplied")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">NEDC HQ Audit Decision</div>
                <div class="card-body">
                    @if (Model.NedcAuditedAt.HasValue)
                    {
                        <div class="alert alert-light border small">
                            Last decided by <strong>@Model.NedcAuditedByName</strong><br />
                            @Model.NedcAuditedAt.Value.ToLocalTime().ToString("dd MMMM yyyy HH:mm")
                        </div>
                    }
                    <form asp-action="@auditAction" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Decision</label>
                            <select name="auditStatus" class="form-select" required>
                                <option value="">Select decision</option>
                                <option value="Approved" selected="@(Model.NedcAuditStatus == "Approved")">Approve report</option>
                                <option value="Returned" selected="@(Model.NedcAuditStatus == "Returned")">Return to IHSA</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">HQ Audit Note</label>
                            <textarea name="auditNote" class="form-control" rows="6" maxlength="1000" placeholder="Record findings, exceptions, or action required...">@Model.NedcAuditNote</textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Save NEDC HQ Decision</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>