@model IEnumerable<CTSHIPDashboard.Controllers.NotificationsController.NotificationListItem>

@{
    ViewData["Title"] = "Notifications";
}

<div class="ct-page">
    <div class="ct-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="mb-1">Notifications</h1>
            <p class="mb-0">Recent updates related to your programme role and assigned work.</p>
        </div>
        <button id="ctMarkAllNotifications" type="button" class="btn btn-outline-success">
            <i class="bi bi-check2-all me-1"></i> Mark all read
        </button>
    </div>

    <form id="ctNotificationIndexToken" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="card shadow-sm">
        <div class="list-group list-group-flush">
            @if (!Model.Any())
            {
                <div class="list-group-item text-center text-muted py-5">No notifications yet.</div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <a href="@(string.IsNullOrWhiteSpace(item.Url) ? "#" : item.Url)"
                       class="list-group-item list-group-item-action d-flex gap-3 align-items-start @(item.IsUnread ? "bg-light" : "")"
                       data-notification-id="@item.Id">
                        <span class="badge @(item.IsUnread ? "bg-warning text-dark" : "bg-success") rounded-pill mt-1">
                            <i class="bi bi-@(item.Icon == "warning" ? "exclamation-triangle" : item.Icon == "success" ? "check-circle" : "bell")"></i>
                        </span>
                        <span class="flex-grow-1">
                            <span class="d-flex flex-wrap justify-content-between gap-2">
                                <strong>@item.Title</strong>
                                <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</small>
                            </span>
                            <span class="d-block text-muted">@item.Message</span>
                        </span>
                    </a>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const token = document.querySelector('#ctNotificationIndexToken input[name="__RequestVerificationToken"]')?.value || '';
            document.querySelectorAll('[data-notification-id]').forEach(item => {
                item.addEventListener('click', () => {
                    const id = item.getAttribute('data-notification-id');
                    if (!id || !token) return;
                    fetch('@Url.Action("MarkRead", "Notifications")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: new URLSearchParams({ id })
                    }).catch(() => {});
                });
            });

            document.getElementById('ctMarkAllNotifications')?.addEventListener('click', async () => {
                if (!token) return;
                await fetch('@Url.Action("MarkAllRead", "Notifications")', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                }).catch(() => {});
                window.location.reload();
            });
        })();
    </script>
}
