@model IEnumerable<CTSHIPDashboard.Models.Claim>
@{
    ViewData["Title"] = "Claims Dashboard";
    bool canSubmitClaims = User.IsInRole("Admin") || User.IsInRole("HMO");
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 text-success fw-bold mb-0">Claims Processing Center</h1>
            <p class="lead text-muted mb-0">NEDC CTSHIP Digital System</p>
        </div>
        @if (canSubmitClaims)
        {
            <a asp-action="Create" class="btn btn-success btn-lg shadow-lg">
                Submit New Claim
            </a>
        }
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5 text-center">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-lg h-100">
                <div class="card-body py-4">
                    <h5>Total Claims</h5>
                    <h2 class="fw-bold">@ViewBag.TotalClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-lg h-100">
                <div class="card-body py-4">
                    <h5>Pending</h5>
                    <h2 class="fw-bold">@ViewBag.PendingClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-lg h-100">
                <div class="card-body py-4">
                    <h5>Paid</h5>
                    <h2 class="fw-bold">@ViewBag.PaidClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-lg h-100">
                <div class="card-body py-4">
                    <h5>Rejected</h5>
                    <h2 class="fw-bold">@ViewBag.RejectedClaims</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-lg" placeholder="Search Claim # or Enrollee..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-lg">
                    <option value="All" selected="@(ViewBag.Status == "All")">All Status</option>
                    <option value="Submitted" selected="@(ViewBag.Status == "Submitted")">Submitted</option>
                    <option value="Approved" selected="@(ViewBag.Status == "Approved")">Review Approved</option>
                    <option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
                    <option value="Rejected" selected="@(ViewBag.Status == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-lg w-100">
                    Apply Filters
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">Clear</a>
            </div>
        </div>
    </form>

    <!-- Claims Table -->
    <div class="card shadow-lg border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-success text-white">
                    <tr>
                        <th>Claim #</th>
                        <th>Enrollee</th>
                        <th>Provider</th>
                        <th>HMO</th>
                        <th>Amount</th>
                        <th>Diagnosis</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@c.ClaimNumber</strong></td>
                            <td>@c.Enrollee?.FullName<br><small class="text-muted">@c.Enrollee?.EnrollmentNumber</small></td>
                            <td>@c.Provider?.Name</td>
                            <td>@c.Hmos?.Name</td>
                            <td class="fw-bold">₦@((int)c.Amount)</td>
                            <td>@c.Diagnosis</td>
                            <td>
                                <span class="badge px-4 py-2 fs-6
                                        @(c.Status == "Paid" ? "bg-success" :
                                                                            c.Status == "Approved" ? "bg-info" :
                                                                            c.Status == "Submitted" ? "bg-warning text-dark" :
                                                                            "bg-danger")">
                                @c.Status
                            </span>
                        </td>
                        <td>@c.DateSubmitted</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-info btn-sm">View</a>
                            @if (c.Status == "Submitted" && (User.IsInRole("HMO") || User.IsInRole("Admin")))
                                {
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-action="Review" asp-route-id="@c.Id" class="btn btn-info btn-sm">Review</a>
                                }
                                @if (c.Status == "Review Approved" && User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Edit</a>
                                }

                                @if (c.Status == "Approved" && (User.IsInRole("HMO") || User.IsInRole("Admin")))
                                {
                                    <a asp-action="Approve" asp-route-id="@c.Id" class="btn btn-success btn-sm">Pay</a>
                                }
                              
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="card-footer bg-light">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-status="@ViewBag.Status"
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status"
                           asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>
