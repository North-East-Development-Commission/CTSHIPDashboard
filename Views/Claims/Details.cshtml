@model CTSHIPDashboard.Models.Claim
@{
    ViewData["Title"] = "Claim Details - " + Model.ClaimNumber;
    bool canReviewClaims = User.IsInRole("Reviewer");
    bool canFinalizeClaims = User.IsInRole("Reviewer");
    bool canDeleteClaims = User.IsInRole("CTSHIPAdmin") || User.IsInRole("Admin");
}

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-11 col-xl-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header with Status Color -->
                <div class=" @(Model.Status == "Paid" ? "bg-success" :
                                                   Model.Status == "Approved" ? "bg-info" :
                                                   Model.Status == "Submitted" ? "bg-warning text-dark" : "bg-danger")
                              text-white text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">@Model.ClaimNumber</h1>
                    <h3 class="mb-0">
                        <span class="badge fs-3 px-5 py-3 @(Model.Status == "Paid" ? "bg-white text-success" :
                                                                                          Model.Status == "Approved" ? "bg-dark" :
                                                                                          Model.Status == "Submitted" ? "bg-dark" : "bg-white text-danger")">
                            @Model.Status.ToUpper()
                        </span>
                    </h3>
                </div>

                <div class="card-body p-5">
                    <div class="row g-5">
                        <!-- Enrollee Card -->
                        <div class="col-lg-5">
                            <div class="card border-success shadow-lg h-100">
                                <div class="card-body text-center p-4">
                                    <img src="@EnrolleePhotoStorage.ResolvePhotoPath(Model.Enrollee?.PhotoPath, Model.Enrollee?.EnrollmentNumber)"
                                         class="rounded-circle shadow mb-4" style="width:150px; height:150px; object-fit:cover; border:6px solid #3B703B;" />
                                    <h4 class="fw-bold">@Model.Enrollee?.FullName</h4>
                                    <p class="mb-1"><strong>ID:</strong> @Model.Enrollee?.EnrollmentNumber</p>
                                    <p class="mb-1"><strong>HMO:</strong> @Model.Enrollee?.Hmo?.Name</p>
                                    <p class="mb-0"><strong>State:</strong> @Model.Enrollee?.State</p>
                                </div>
                            </div>
                        </div>

                        <!-- Provider & Financial -->
                        <div class="col-lg-7">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="card border-info shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-info fw-bold">Provider</h5>
                                            <p class="mb-0">@Model.Provider?.Name - @Model.Provider?.State</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card bg-primary text-white shadow-lg">
                                        <div class="card-body text-center py-4">
                                            <h5>Claim Amount</h5>
                                            <h2 class="display-5 fw-bold">₦@Model.Amount</h2>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card @(Model.Status == "Paid" ? "bg-success" : "bg-secondary") text-white shadow-lg">
                                        <div class="card-body text-center py-4">
                                            <h5>Status</h5>
                                            <h4 class="fw-bold">@Model.Status</h4>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-4 mt-4">
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Diagnosis</h5>
                                            <p class="fs-5">@Model.Diagnosis</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Treatment Given</h5>
                                            <p class="fs-5">@Model.Treatment</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card shadow-sm">
                                        <div class="card-body">
                                            <h5 class="text-success fw-bold">Claim Supporting Documents</h5>
                                            @if (Model.SupportingDocuments.Count == 0)
                                            {
                                                <p class="text-muted mb-0">No supporting documents were uploaded for this claim.</p>
                                            }
                                            else
                                            {
                                                <div class="list-group">
                                                    @foreach (var document in Model.SupportingDocuments.OrderBy(x => x.DocumentType).ThenBy(x => x.OriginalFileName))
                                                    {
                                                        <a href="@document.FilePath" target="_blank" rel="noopener" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                                                            <span>
                                                                <strong>@document.DocumentType</strong><br />
                                                                <span class="text-muted">@document.OriginalFileName</span>
                                                            </span>
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (Model.Status == "Paid")
                            {
                                <div class="alert alert-success mt-4">
                                    <strong>Payment Completed</strong><br>
                                    Paid By: @Model.PaidBy<br>
                                    Date Paid: @Model.DatePaid?.ToString("dd MMMM yyyy")<br>
                                    Reference: @Model.PaymentReference
                                </div>
                            }

                            @if (Model.Status == "Rejected")
                            {
                                <div class="alert alert-danger mt-4">
                                    <strong>Claim Rejected</strong><br>
                                    Reason: @Model.RejectionReason<br>
                                    Rejected By: @Model.RejectedBy on @Model.DateRejected?.ToString("dd MMM yyyy")
                                </div>
                            }
                        </div>
                    </div>


                    <div class="row g-4 mt-4">
                        <div class="col-12">
                            <div class="card border-success shadow-sm">
                                <div class="card-header bg-success text-white fw-bold">Secondary Provider Claim Reporting Trail</div>
                                <div class="card-body">
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4"><strong>HMO Certification:</strong><br /><span class="badge bg-primary">@Model.HmoCertificationStatus</span></div>
                                        <div class="col-md-4"><strong>IHSA Verification:</strong><br /><span class="badge bg-info text-dark">@Model.IhsaVerificationStatus</span></div>
                                        <div class="col-md-4"><strong>Original Provider Data:</strong><br /><span class="text-muted">Preserved @(!string.IsNullOrWhiteSpace(Model.OriginalProviderDataJson) ? "Yes" : "Pending")</span></div>
                                    </div>

                                    <h6 class="fw-bold text-success">Query Cycle</h6>
                                    @if (Model.Queries.Count == 0)
                                    {
                                        <p class="text-muted">No claim queries have been raised.</p>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle">
                                                <thead><tr><th>Query Raised</th><th>Responsible</th><th>Response</th><th>Resolution</th><th>Closure</th><th>Status / Timestamp</th></tr></thead>
                                                <tbody>
                                                    @foreach (var query in Model.Queries.OrderByDescending(q => q.RaisedAt))
                                                    {
                                                        <tr>
                                                            <td>@query.QueryRaised<br /><small class="text-muted">By @query.RaisedByName</small></td>
                                                            <td>@query.ResponsiblePerson</td>
                                                            <td>@(query.Response ?? "?")<br /><small class="text-muted">@query.RespondedAt?.ToString("dd MMM yyyy HH:mm")</small></td>
                                                            <td>@(query.Resolution ?? "?")</td>
                                                            <td>@(query.ClosureNote ?? "?")<br /><small class="text-muted">@query.ClosedAt?.ToString("dd MMM yyyy HH:mm")</small></td>
                                                            <td><span class="badge bg-secondary">@query.Status</span><br /><small>@query.RaisedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @if (User.IsInRole("HMO") || User.IsInRole("Reviewer"))
                                    {
                                        foreach (var query in Model.Queries.Where(q => q.Status != "Closed" && !string.IsNullOrWhiteSpace(q.Response)))
                                        {
                                            <form asp-action="CloseClaimQuery" method="post" class="border rounded-3 p-3 mb-3">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="queryId" value="@query.Id" />
                                                <label class="form-label fw-bold text-success">Resolve @query.QueryNumber</label>
                                                <textarea name="resolution" class="form-control mb-2" rows="2" placeholder="Resolution" required></textarea>
                                                <input name="closureNote" class="form-control mb-2" placeholder="Closure note" />
                                                <button class="btn btn-success">Close Query</button>
                                            </form>
                                        }

                                        if (Model.HmoCertificationStatus != "Certified" && !Model.Queries.Any(q => q.Status != "Closed"))
                                        {
                                            <form asp-action="CertifyClaim" method="post" class="border rounded-3 p-3">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <label class="form-label fw-bold text-success">HMO Certification Note</label>
                                                <textarea name="note" class="form-control mb-2" rows="2" placeholder="Certification note"></textarea>
                                                <button class="btn btn-primary">Certify Dataset</button>
                                            </form>
                                        }
                                    }

                                    @if ((User.IsInRole("IHSA") || User.IsInRole("NEDCAdmin") || User.IsInRole("NHIA") || User.IsInRole("Monitoring") || User.IsInRole("CTSHIPAdmin") || User.IsInRole("Admin")) && Model.HmoCertificationStatus == "Certified")
                                    {
                                        <form asp-action="VerifyClaimByIhsa" method="post" class="border rounded-3 p-3 mt-3">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <label class="form-label fw-bold text-success">IHSA Verification Decision</label>
                                            <select name="verificationStatus" class="form-select mb-2" required>
                                                <option value="Verified">Verified</option>
                                                <option value="Flagged">Flagged for follow-up</option>
                                            </select>
                                            <textarea name="note" class="form-control mb-2" rows="2" placeholder="IHSA technical oversight note"></textarea>
                                            <button class="btn btn-success">Save IHSA Decision</button>
                                        </form>
                                    }

                                    <h6 class="fw-bold text-success mt-4">Audit Trail</h6>
                                    @if (Model.AuditTrails.Count == 0)
                                    {
                                        <p class="text-muted mb-0">No audit events recorded yet.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group">
                                            @foreach (var item in Model.AuditTrails.OrderByDescending(a => a.PerformedAt))
                                            {
                                                <li class="list-group-item d-flex justify-content-between gap-3">
                                                    <span><strong>@item.Action</strong><br /><span class="text-muted">@item.Summary</span></span>
                                                    <small class="text-muted text-nowrap">@item.PerformedAt.ToString("dd MMM yyyy HH:mm")</small>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5 border-success opacity-75 border-2" />

                    <div class="text-center">
                        @if (Model.Status == "Submitted" && canReviewClaims)
                        {
                            <a asp-action="Review" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-6 shadow-lg me-3">
                                Review Claim
                            </a>
                        }
                        @if (Model.Status == "Approved" && canFinalizeClaims)
                        {
                            <a asp-action="Approve" asp-route-id="@Model.Id" class="btn btn-success btn-lg px-6 shadow-lg me-3">
                                Pay Claim
                            </a>
                        }
                        @if (canDeleteClaims)
                        {
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg px-6 shadow-lg me-3">
                                Delete Claim
                            </a>
                        }

                        @if (User.IsInRole("HMO") || User.IsInRole("Reviewer"))
                        {
                            <a asp-action="Dashboard" class="btn btn-primary btn-lg px-6 shadow-lg me-3">
                                Back to Claims
                            </a>
                        }
                        @if (User.IsInRole("CTSHIPAdmin") || User.IsInRole("Admin") || User.IsInRole("Monitoring"))
                        {
                            <a asp-action="Index" class="btn btn-success btn-lg px-6 shadow-lg me-3">
                                Back to Claims
                            </a>
                        }
                    </div>
                </div>

                <!-- Footer -->
                <div class="bg-dark text-white text-center py-4">
                    <p class="mb-0 small fw-bold">
                        CTSHIP • Universal Health Coverage • Federal Republic of Nigeria
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

